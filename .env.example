# Configuration du serveur
PORT=3000
NODE_ENV=development

# Clé secrète de session
SESSION_SECRET=hosbank-dev-session-secret-key-2026

# Configuration de la base de données PostgreSQL
# En local (si vous lancez uniquement le conteneur db) : DB_HOST=localhost
# Dans le conteneur complet (docker compose up) : DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hosbank
