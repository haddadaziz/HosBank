                                        <path d="M256 120 C256 106 282 106 284 124 L286 156 C286 166 276 166 270 166 L262 166 C258 166 254 160 254 150 Z" fill="#242D38"/>
                                        <circle cx="256" cy="127" r="2.8" fill="#C49B7A"/>
                                    </g>
                                </svg>
                            </div>

                            <!-- Register Illustration (Team of 4) -->
                            <div id="mockupIllustrReg" class="opacity-0 absolute top-0 left-0 right-0 max-w-[300px] mx-auto">
                                <svg viewBox="0 0 460 270" class="w-full h-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <ellipse cx="230" cy="250" rx="200" ry="16" fill="#60577B" opacity="0.65"/>
                                    <g id="p1">
                                        <path d="M85 190 L82 248" stroke="#7A6655" stroke-width="6.5" stroke-linecap="round"/>
