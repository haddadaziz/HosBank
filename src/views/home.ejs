                                            <span class="w-3 h-3 rounded border border-[#D8CEBB] bg-[#746B92] flex items-center justify-center mr-1">
                                                <svg class="w-2 h-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                            </span>
                                            <span>Se souvenir</span>
                                        </label>
                                        <a href="/login" class="text-[#9D937F] hover:text-[#746B92] pointer-events-auto">Oublié ?</a>
                                    </div>
                                    <div class="pt-1.5 flex justify-start">
                                        <a href="/login" id="mockupLoginBtn" class="bg-[#746B92] hover:bg-[#635B7E] text-white text-xs font-semibold px-5 py-2 rounded-lg shadow-sm transition-all pointer-events-auto cursor-pointer inline-flex items-center gap-1.5">
                                            <span>Se connecter</span>
                                        </a>
