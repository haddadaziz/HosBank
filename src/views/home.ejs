                                </form>
                                <div class="mt-3.5 text-left text-[10px] text-[#9D937F]">
                                    <span>Pas encore de compte ?</span>
                                    <a href="/register" class="text-[#746B92] font-semibold hover:underline ml-1 pointer-events-auto">
                                        S'inscrire
                                    </a>
                                </div>
                            </div>

                            <!-- Form Register -->
                            <div id="mockupFormReg" class="opacity-0 absolute top-0 left-0 right-0 flex flex-col justify-center">
                                <div class="mb-3">
                                    <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[#282330] text-left">
                                        Inscription
                                    </h3>
                                </div>
                                <form onsubmit="return false;" class="space-y-3 w-full">
                                    <div class="pb-1 border-b border-[#D8CEBB] flex items-center justify-between">
                                        <span class="text-[11px] text-[#9D937F]">Civilité</span>
                                        <div class="flex items-center gap-3">
                                            <label class="inline-flex items-center gap-1 cursor-pointer">
                                                <span class="w-3 h-3 rounded-full border border-[#746B92] bg-[#746B92] flex items-center justify-center">
                                                    <span class="w-1 h-1 rounded-full bg-[#F6EFE0]"></span>
                                                </span>
                                                <span class="text-[11px] text-[#282330] font-medium">M.</span>
                                            </label>
                                            <label class="inline-flex items-center gap-1 cursor-pointer">
                                                <span class="w-3 h-3 rounded-full border border-[#D8CEBB] flex items-center justify-center"></span>
                                                <span class="text-[11px] text-[#9D937F]">Mme</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <input type="text" id="mockupRegName" placeholder="Nom complet" class="w-full underline-input pb-1 text-xs text-[#282330] pointer-events-auto">
                                    </div>
                                    <div>
                                        <input type="email" id="mockupRegEmail" placeholder="Adresse e-mail" class="w-full underline-input pb-1 text-xs text-[#282330] pointer-events-auto">
                                    </div>
                                    <div>
                                        <input type="password" placeholder="Mot de passe sécurisé" class="w-full underline-input pb-1 text-xs text-[#282330] pointer-events-auto">
                                    </div>
                                    <div class="pt-1.5 flex justify-start">
                                        <button id="mockupRegBtn" type="button" class="bg-[#746B92] hover:bg-[#635B7E] active:scale-95 text-white text-xs font-semibold px-5 py-2 rounded-lg shadow-md transition-all pointer-events-auto cursor-pointer flex items-center gap-1.5">
                                            <span>Ouvrir un compte</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                        </button>
                                    </div>
                                </form>
                                <div class="mt-3 text-left text-[10px] text-[#9D937F]">
                                    <span>Déjà un compte ?</span>
                                    <a href="/login" class="text-[#746B92] font-semibold hover:underline ml-1 pointer-events-auto">
                                        Se connecter
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <%- include('partials/footer') %>

    <script>
        (function() {
            const video = document.getElementById('heroScrubVideo');
            const imgStart = document.getElementById('heroImageStart');
            const scrollTrack = document.getElementById('scrollTrack');
            const heroContent = document.getElementById('heroContent');
            const heroEmailInput = document.getElementById('heroEmailInput');

            // Laptop Screen elements
            const laptopOverlay = document.getElementById('laptopScreenOverlay');
            const mockupScaleWrapper = document.getElementById('mockupScaleWrapper');
            const mockupPurple = document.getElementById('mockupPurple');
            const mockupCream = document.getElementById('mockupCream');
            const mockupLogo = document.getElementById('mockupLogo');
            const mockupText = document.getElementById('mockupText');
            const mockupIllustr = document.getElementById('mockupIllustr');
            const mockupCurveLeft = document.getElementById('mockupCurveLeft');
            const mockupCurveRight = document.getElementById('mockupCurveRight');
            const mockupTextLogin = document.getElementById('mockupTextLogin');
            const mockupTextReg = document.getElementById('mockupTextReg');
            const mockupIllustrLogin = document.getElementById('mockupIllustrLogin');
            const mockupIllustrReg = document.getElementById('mockupIllustrReg');
            const mockupFormLogin = document.getElementById('mockupFormLogin');
            const mockupFormReg = document.getElementById('mockupFormReg');
            const mockupCornerDecor = document.getElementById('mockupCornerDecor');
            const mockupRegEmail = document.getElementById('mockupRegEmail');
            const mockupRegBtn = document.getElementById('mockupRegBtn');

            // Sync email typed in hero input into mockup registration input
            if (heroEmailInput && mockupRegEmail) {
                heroEmailInput.addEventListener('input', function(e) {
                    mockupRegEmail.value = e.target.value;
                });
            }

            // Click on registration button inside laptop mockup
            if (mockupRegBtn) {
                mockupRegBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const email = (mockupRegEmail && mockupRegEmail.value.trim()) || (heroEmailInput && heroEmailInput.value.trim()) || '';
                    if (email) {
                        window.location.href = '/register?email=' + encodeURIComponent(email);
                    } else {
                        window.location.href = '/register';
                    }
                });
            }

            // Calibrated keyframes for laptop screen motion in hero-scrub.mp4 (1920x720)
            const screenKeyframes = [
                { t: 0.0,  vw: 46,  cy: 436.5 },
                { t: 1.5,  vw: 60,  cy: 433 },
                { t: 2.0,  vw: 100, cy: 422 },
                { t: 2.5,  vw: 190, cy: 405 },
                { t: 3.0,  vw: 330, cy: 394 },
                { t: 3.4,  vw: 465, cy: 388 },
                { t: 3.7,  vw: 555, cy: 385.5 },
                { t: 4.0,  vw: 622, cy: 384 }
            ];

            function getScreenCoords(t) {
                t = Math.max(0, Math.min(4.0, t));
                let i = 0;
                while (i < screenKeyframes.length - 1 && screenKeyframes[i+1].t <= t) i++;
                if (i >= screenKeyframes.length - 1) {
                    const last = screenKeyframes[screenKeyframes.length - 1];
                    const vh = last.vw / 1.611;
                    return { vx: 960 - (last.vw / 2), vy: last.cy - (vh / 2), vw: last.vw, vh: vh };
                }
                const k1 = screenKeyframes[i];
                const k2 = screenKeyframes[i+1];
                const factor = (t - k1.t) / (k2.t - k1.t);
                // Smooth Hermite cubic interpolation between keyframes
                const s = factor * factor * (3 - 2 * factor);
                const vw = k1.vw + (k2.vw - k1.vw) * s;
                const cy = k1.cy + (k2.cy - k1.cy) * s;
                const vh = vw / 1.611;
                const vx = 960 - (vw / 2);
                const vy = cy - (vh / 2);
                return { vx, vy, vw, vh };
            }

            // In hero-scrub.mp4 (1920x720), the close-up view of the laptop sitting on the desk is at 4.0s.
            // Capping at 4.0s ensures the camera stays locked on the PC on the desk and NEVER zooms past it!
            const zoomEndProgress = 0.45;
            const maxVideoTime = 4.0;
            let isTicking = false;

            window.addEventListener('DOMContentLoaded', () => {
                try {
                    video.currentTime = 0.001;
                } catch(e) {}
                updateScroll();
            });

            function updateScroll() {
                const rect = scrollTrack.getBoundingClientRect();
                const totalScrollableDistance = scrollTrack.offsetHeight - window.innerHeight;
                
                const currentScrolled = -rect.top;
                const progress = Math.max(0, Math.min(1, currentScrolled / totalScrollableDistance));

                // Zoom Phase: from 0.00 to 0.45 (smooth camera travel towards the laptop on the desk)
                const zoomProgress = Math.min(1, progress / zoomEndProgress);
                const targetTime = zoomProgress * maxVideoTime;

                // 1. Scrub video up to the close-up laptop frame (t = 4.0s)
                // Once at 4.0s (progress >= 0.45), the video stays locked at 4.0s!
                if (video) {
                    if (Math.abs(video.currentTime - targetTime) > 0.02) {
                        try {
                            video.currentTime = targetTime;
                        } catch(e) {}
                    }
                }

                // 2. Poster image fade
                if (imgStart) {
                    imgStart.style.opacity = progress > 0.02 ? '0' : '1';
                }

                // 3. Hero content fade & blur exit (0.00 to 0.18)
                const textFadeThreshold = 0.18;
                if (heroContent) {
                    if (progress <= textFadeThreshold) {
                        const textProgress = progress / textFadeThreshold;
                        const opacity = Math.max(0, 1 - textProgress);
                        const scale = 1 - (textProgress * 0.08);
                        const translateY = -textProgress * 45;
                        const blur = textProgress * 8;

                        heroContent.style.opacity = opacity.toFixed(3);
                        heroContent.style.transform = `translate3d(0, ${translateY}px, 0) scale(${scale.toFixed(3)})`;
                        heroContent.style.filter = `blur(${blur}px)`;
                        heroContent.style.pointerEvents = opacity < 0.1 ? 'none' : 'auto';
                    } else {
                        heroContent.style.opacity = '0';
                        heroContent.style.filter = 'blur(10px)';
                        heroContent.style.pointerEvents = 'none';
                    }
                }

                // 4. Laptop Screen Overlay: Tracks the physical laptop display glass frame-by-frame from distance to close-up
                const cW = window.innerWidth;
                const cH = window.innerHeight;
                const vW = 1920;
                const vH = 720;
                const vRatio = vW / vH;
                const cRatio = cW / cH;

                let renderW, renderH, offsetX, offsetY;
                if (cRatio > vRatio) {
                    renderW = cW;
                    renderH = cW / vRatio;
                    offsetX = 0;
                    offsetY = (cH - renderH) / 2;
                } else {
                    renderH = cH;
                    renderW = cH * vRatio;
                    offsetX = (cW - renderW) / 2;
                    offsetY = 0;
                }

                // Screen position at current video timestamp targetTime:
                const box = getScreenCoords(targetTime);
                const screenX = offsetX + (box.vx / vW) * renderW;
                const screenY = offsetY + (box.vy / vH) * renderH;
                const screenW = (box.vw / vW) * renderW;
                const screenH = (box.vh / vH) * renderH;

                if (laptopOverlay) {
                    // Smooth fade-in of the HosBank auth mockup as the camera arrives at the laptop (0.32 -> 0.45)
                    let overlayOpacity = 0;
                    if (progress >= 0.45) {
                        overlayOpacity = 1;
                    } else if (progress >= 0.32) {
                        const fadeFactor = (progress - 0.32) / (0.45 - 0.32);
                        overlayOpacity = fadeFactor * fadeFactor * (3 - 2 * fadeFactor);
                    }

                    if (overlayOpacity > 0.01) {
                        laptopOverlay.style.display = 'block';
                        laptopOverlay.style.left = `${screenX.toFixed(1)}px`;
                        laptopOverlay.style.top = `${screenY.toFixed(1)}px`;
                        laptopOverlay.style.width = `${screenW.toFixed(1)}px`;
                        laptopOverlay.style.height = `${screenH.toFixed(1)}px`;
                        laptopOverlay.style.borderRadius = `${Math.max(2, Math.round(screenW * 0.016))}px`;
                        laptopOverlay.style.opacity = overlayOpacity.toFixed(3);

                        const scaleFactor = screenW / 800;
                        if (mockupScaleWrapper) {
                            mockupScaleWrapper.style.transform = `scale(${scaleFactor.toFixed(4)})`;
                        }

                        laptopOverlay.style.pointerEvents = progress >= 0.45 ? 'auto' : 'none';
                    } else {
                        laptopOverlay.style.display = 'none';
                        laptopOverlay.style.opacity = '0';
                        laptopOverlay.style.pointerEvents = 'none';
                    }
                }

                // 5. Signature Auth Sliding Animation: Executes INSIDE THE PC SCREEN once arrived (0.45 to 0.95)
                const animStart = 0.45;
                const animEnd = 0.95;
                const authRatio = Math.max(0, Math.min(1, (progress - animStart) / (animEnd - animStart)));

                // Sliding panel coordinates (travel = 360px within 800px width)
                // authRatio = 0 (Login Mode): Purple at 360px (right), Cream at 0px (left)
                // authRatio = 1 (Register Mode): Purple at 0px (left), Cream at 440px (right)
                const purpleX = (1 - authRatio) * 360;
                const creamX = authRatio * 440;

                if (mockupPurple) {
                    mockupPurple.style.transform = `translate3d(${purpleX.toFixed(1)}px, 0, 0)`;
                }
                if (mockupCream) {
                    mockupCream.style.transform = `translate3d(${creamX.toFixed(1)}px, 0, 0)`;
                }

                // Parallax inner shift
                const innerShift = (1 - authRatio) * 45;
                if (mockupLogo) mockupLogo.style.transform = `translate3d(${innerShift.toFixed(1)}px, 0, 0)`;
                if (mockupText) mockupText.style.transform = `translate3d(${innerShift.toFixed(1)}px, 0, 0)`;
                if (mockupIllustr) mockupIllustr.style.transform = `translate3d(${(innerShift * 0.8).toFixed(1)}px, 0, 0)`;

                // SVGs curve opacity
                const curveLeftOpacity = Math.max(0, Math.min(1, 1 - authRatio * 2.2));
                const curveRightOpacity = Math.max(0, Math.min(1, (authRatio - 0.45) * 2.2));
                if (mockupCurveLeft) mockupCurveLeft.style.opacity = curveLeftOpacity.toFixed(2);
                if (mockupCurveRight) mockupCurveRight.style.opacity = curveRightOpacity.toFixed(2);

                // Content crossfade (Login vs Register)
                const loginOpacity = Math.max(0, Math.min(1, (0.52 - authRatio) * 4 + 0.5));
                const regOpacity = Math.max(0, Math.min(1, (authRatio - 0.48) * 4 + 0.5));

                if (mockupTextLogin) mockupTextLogin.style.opacity = loginOpacity.toFixed(2);
                if (mockupTextReg) mockupTextReg.style.opacity = regOpacity.toFixed(2);
                if (mockupIllustrLogin) mockupIllustrLogin.style.opacity = loginOpacity.toFixed(2);
                if (mockupIllustrReg) mockupIllustrReg.style.opacity = regOpacity.toFixed(2);
                if (mockupFormLogin) mockupFormLogin.style.opacity = loginOpacity.toFixed(2);
                if (mockupFormReg) mockupFormReg.style.opacity = regOpacity.toFixed(2);

                // Corner decor radius flip
                if (mockupCornerDecor) {
                    if (authRatio < 0.5) {
                        mockupCornerDecor.style.left = '0';
                        mockupCornerDecor.style.right = 'auto';
                        mockupCornerDecor.style.borderRadius = '0 40px 0 0';
                    } else {
                        mockupCornerDecor.style.left = 'auto';
                        mockupCornerDecor.style.right = '0';
                        mockupCornerDecor.style.borderRadius = '40px 0 0 0';
                    }
                }

                isTicking = false;
            }

            window.addEventListener('scroll', function() {
                if (!isTicking) {
                    window.requestAnimationFrame(updateScroll);
                    isTicking = true;
                }
            }, { passive: true });

            window.addEventListener('resize', function() {
                if (!isTicking) {
                    window.requestAnimationFrame(updateScroll);
                    isTicking = true;
                }
            });

            updateScroll();
        })();
    </script>
</body>
</html>
