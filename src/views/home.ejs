                            <div class="flex items-center">
                                <svg class="h-6 w-auto mr-[2px]" viewBox="0 0 25 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="0" y="2" width="5.5" height="24" rx="1.5" fill="#FFFFFF"/>
                                    <rect x="18.5" y="2" width="5.5" height="24" rx="1.5" fill="#FFFFFF"/>
                                    <path d="M5.5 17.5 L18.5 10.5 L18.5 15.2 L5.5 22.2 Z" fill="#E97A7A"/>
                                </svg>
                                <div class="flex items-baseline brand-wordmark">
                                    <span class="text-[20px] sm:text-[22px] font-[800] tracking-[-0.04em] text-white leading-none">os</span>
                                    <span class="text-[20px] sm:text-[22px] font-[800] tracking-[-0.03em] text-white/95 leading-none ml-[0.5px]">Bank</span>
                                    <span class="w-[5px] h-[5px] rounded-full bg-[#E97A7A] ml-1 self-end mb-0.5 shadow-[0_0_8px_rgba(233,122,122,0.65)]"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Text Content -->
                        <div id="mockupText" class="relative z-40 my-auto max-w-xs" style="transform: translate3d(45px, 0, 0);">
                            <!-- Login Text -->
                            <div id="mockupTextLogin" class="opacity-100">
                                <h2 class="text-xl sm:text-2xl font-bold tracking-tight leading-tight text-white">
                                    Ravi de vous revoir !
                                </h2>
                                <p class="text-xs text-[#DDD7EB] font-normal leading-relaxed mt-2">
                                    Reprenez là où vous vous étiez arrêté en toute sérénité.
                                </p>
                            </div>

                            <!-- Register Text -->
                            <div id="mockupTextReg" class="opacity-0 absolute top-0 left-0 right-0">
                                <h2 class="text-xl sm:text-2xl font-bold tracking-tight leading-tight text-white">
                                    Heureux de vous compter parmi nous !
                                </h2>
                                <p class="text-xs text-[#DDD7EB] font-normal leading-relaxed mt-2">
                                    Rejoignez des milliers de clients satisfaits d'une gestion moderne et fluide.
                                </p>
                            </div>
                        </div>

                        <!-- Vector Illustrations -->
                        <div id="mockupIllustr" class="relative z-40 w-full max-w-[300px] mx-auto pb-1" style="transform: translate3d(35px, 0, 0);">
                            <!-- Login Illustration (Couple) -->
