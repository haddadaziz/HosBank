                    </div>

                    <!-- Cream Panel (Sliding between left and right) -->
                    <div 
                        id="mockupCream" 
                        class="absolute top-0 bottom-0 left-0 w-[360px] h-full bg-[#F6EFE0] p-6 sm:p-8 flex flex-col justify-center z-10"
                        style="transform: translate3d(0, 0, 0);"
                    >
                        <div id="mockupCornerDecor" class="absolute bottom-0 left-0 w-24 h-24 bg-[#EFE7D4] -z-10 pointer-events-none rounded-tr-[40px]"></div>

                        <div class="relative w-full max-w-[280px] mx-auto">
                            
                            <!-- Form Login -->
                            <div id="mockupFormLogin" class="opacity-100 flex flex-col justify-center">
                                <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[#282330] mb-4 text-left">
                                    Connexion
                                </h3>
                                <form onsubmit="return false;" class="space-y-3.5 w-full">
                                    <div>
                                        <input type="text" placeholder="Identifiant ou E-mail" readonly value="alexandre.moreau@hosbank.fr" class="w-full underline-input pb-1 text-xs text-[#282330]">
                                    </div>
                                    <div>
                                        <input type="password" placeholder="Mot de passe" readonly value="••••••••••••" class="w-full underline-input pb-1 text-xs text-[#282330]">
                                    </div>
                                    <div class="flex items-center justify-between text-[10px] pt-0.5">
