        </div>

        <div 
            id="creamPanel" 
            class="relative lg:absolute lg:top-0 lg:bottom-0 lg:left-0 w-full lg:w-[46vw] flex-1 bg-[#F6EFE0] p-6 sm:p-10 lg:p-16 flex flex-col justify-between z-10 panel-slide-transition"
            style="transform: <%= initialMode === 'login' ? 'translate3d(0, 0, 0)' : 'translate3d(54vw, 0, 0)' %>;"
        >

            <div id="cornerDecor" class="hidden lg:block absolute bottom-0 w-36 h-36 bg-[#EFE7D4] -z-10 pointer-events-none curve-fade-transition <%= initialMode === 'login' ? 'left-0 rounded-tr-[54px]' : 'right-0 rounded-tl-[54px]' %>"></div>

            <div class="h-4"></div>

            <div class="max-w-sm w-full mx-auto my-auto">

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="mb-5 p-3.5 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs sm:text-sm flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-red-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <% if (typeof message !== 'undefined' && message) { %>
                    <div class="mb-5 p-3.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <span><%= message %></span>
                    </div>
                <% } %>

                <div id="formRegister" class="fade-swap-transition <%= initialMode === 'register' ? 'opacity-100 block' : 'opacity-0 hidden' %>">
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#282330] mb-6 text-left">
                        Inscription
                    </h2>

                    <form action="/register" method="POST" class="space-y-4 w-full">
                        <div class="pb-2 border-b border-[#D8CEBB] flex items-center justify-between">
                            <span class="text-sm text-[#9D937F]">Civilité</span>
                            <div class="flex items-center gap-6">
                                <label class="inline-flex items-center gap-2 cursor-pointer group select-none">
                                    <input type="radio" name="civilite" value="M." class="peer sr-only" required checked>
                                    <span class="w-[18px] h-[18px] rounded-full border-[1.5px] border-[#D8CEBB] group-hover:border-[#746B92] peer-checked:border-[#746B92] peer-checked:bg-[#746B92] flex items-center justify-center transition-all duration-150">
                                        <span class="w-[7px] h-[7px] rounded-full bg-[#F6EFE0]"></span>
                                    </span>
                                    <span class="text-xs sm:text-sm text-[#9D937F] group-hover:text-[#282330] peer-checked:text-[#282330] peer-checked:font-medium transition-colors">
                                        M.
                                    </span>
                                </label>
                                <label class="inline-flex items-center gap-2 cursor-pointer group select-none">
                                    <input type="radio" name="civilite" value="Mme" class="peer sr-only">
                                    <span class="w-[18px] h-[18px] rounded-full border-[1.5px] border-[#D8CEBB] group-hover:border-[#746B92] peer-checked:border-[#746B92] peer-checked:bg-[#746B92] flex items-center justify-center transition-all duration-150">
                                        <span class="w-[7px] h-[7px] rounded-full bg-[#F6EFE0]"></span>
                                    </span>
                                    <span class="text-xs sm:text-sm text-[#9D937F] group-hover:text-[#282330] peer-checked:text-[#282330] peer-checked:font-medium transition-colors">
                                        Mme
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div>
                            <input type="text" name="name" id="regName" required placeholder="Nom complet" class="w-full underline-input pb-2.5 text-sm text-[#282330]">
                        </div>

                        <div>
                            <input type="email" name="email" id="regEmail" value="<%= typeof email !== 'undefined' ? email : '' %>" required placeholder="Adresse e-mail" class="w-full underline-input pb-2.5 text-sm text-[#282330]">
                        </div>

                        <div>
                            <input type="password" name="password" id="regPassword" required placeholder="Mot de passe" class="w-full underline-input pb-2.5 text-sm text-[#282330]">
                        </div>


                        <div>
                            <input type="password" name="confirmPassword" id="regConfirmPassword" required placeholder="Confirmer le mot de passe" class="w-full underline-input pb-2.5 text-sm text-[#282330]">
                        </div>


                        <div class="pt-4 flex justify-start">
                            <button type="submit" class="bg-[#746B92] hover:bg-[#635B7E] active:bg-[#574F70] text-white text-xs sm:text-sm font-semibold px-7 py-2.5 rounded-lg shadow-sm transition-all duration-150 cursor-pointer">
                                S'inscrire
                            </button>
                        </div>
                    </form>

                    <div class="mt-6 text-left text-xs text-[#9D937F]">
                        <span>Vous avez déjà un compte ?</span>
                        <button type="button" onclick="switchMode('login')" class="text-[#746B92] font-semibold hover:underline ml-1 cursor-pointer">
                            Se connecter
                        </button>
                    </div>
                </div>

                <div id="formLogin" class="fade-swap-transition <%= initialMode === 'login' ? 'opacity-100 block' : 'opacity-0 hidden' %>">
                    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#282330] mb-8 sm:mb-10 text-left">
                        Connexion
                    </h1>

                    <form action="/login" method="POST" class="space-y-7 w-full">                        <!-- Identifiant / Email -->
                        <div>
                            <input type="text" name="name" id="loginName" required autocomplete="username" placeholder="Identifiant ou E-mail" class="w-full underline-input pb-2.5 text-sm sm:text-base text-[#282330]">
                        </div>

                        <div>
                            <input type="password" name="password" id="loginPassword" required autocomplete="current-password" placeholder="Mot de passe" class="w-full underline-input pb-2.5 text-sm sm:text-base text-[#282330]">
                        </div>

                        <div class="flex items-center justify-between text-xs sm:text-sm pt-1">
                            <label class="flex items-center cursor-pointer select-none text-[#9D937F] hover:text-[#282330] transition-colors">
                                <input type="checkbox" name="remember" class="sr-only peer">
                                <span class="w-4 h-4 rounded border border-[#D8CEBB] peer-checked:bg-[#746B92] peer-checked:border-[#746B92] flex items-center justify-center mr-2 transition-all">
                                    <svg class="w-2.5 h-2.5 text-white hidden peer-checked:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </span>
                                <span>Se souvenir de moi</span>
                            </label>
                            <a href="#" class="text-[#9D937F] hover:text-[#746B92] hover:underline transition-colors">
                                Mot de passe oublié ?
                            </a>
                        </div>

                        <div class="pt-5 flex justify-start">
                            <button type="submit" class="bg-[#746B92] hover:bg-[#635B7E] active:bg-[#574F70] text-white text-xs sm:text-sm font-semibold px-7 py-2.5 rounded-lg shadow-sm transition-all duration-150 cursor-pointer">
                                Se connecter
                            </button>
                        </div>
                    </form>

                    <div class="mt-8 text-left text-xs text-[#9D937F]">
                        <span>Vous n'avez pas de compte ?</span>
                        <button type="button" onclick="switchMode('register')" class="text-[#746B92] font-semibold hover:underline ml-1 cursor-pointer">
                            S'inscrire
                        </button>
                    </div>
                </div>

            </div>

            <div class="h-4"></div>
        </div>

    </div>

    <script>
        let currentMode = '<%= initialMode %>';
        let isAnimating = false;

        function switchMode(targetMode, pushState = true) {
            if (currentMode === targetMode || isAnimating) return;
            currentMode = targetMode;

            const purplePanel = document.getElementById('purplePanel');
            const creamPanel = document.getElementById('creamPanel');
            const logoContainer = document.getElementById('logoContainer');
            const textContainer = document.getElementById('textContainer');
            const illustrContainer = document.getElementById('illustrContainer');
            const cornerDecor = document.getElementById('cornerDecor');
            const curveRight = document.getElementById('curveRight');
            const curveLeft = document.getElementById('curveLeft');
            
            const textRegister = document.getElementById('textRegister');
            const textLogin = document.getElementById('textLogin');
            const illustrRegister = document.getElementById('illustrRegister');
            const illustrLogin = document.getElementById('illustrLogin');
            const formRegister = document.getElementById('formRegister');
            const formLogin = document.getElementById('formLogin');
            const pageTitle = document.getElementById('pageTitle');

            const isDesktop = window.innerWidth >= 1024;

            // Sur mobile et tablette : bascule verticale immédiate sans animation
            if (!isDesktop) {
                if (targetMode === 'login') {
                    textRegister.classList.add('hidden');
                    textRegister.classList.remove('block');
                    textLogin.classList.remove('hidden');
                    textLogin.classList.add('block');
                    textLogin.style.opacity = '1';

                    formRegister.classList.add('hidden');
                    formRegister.classList.remove('block');
                    formLogin.classList.remove('hidden');
                    formLogin.classList.add('block');
                    formLogin.style.opacity = '1';

                    if (pushState) history.pushState({ mode: 'login' }, '', '/login');
                    if (pageTitle) pageTitle.textContent = 'Connexion | HosBank';
                } else {
                    textLogin.classList.add('hidden');
                    textLogin.classList.remove('block');
                    textRegister.classList.remove('hidden');
                    textRegister.classList.add('block');
                    textRegister.style.opacity = '1';

                    formLogin.classList.add('hidden');
                    formLogin.classList.remove('block');
                    formRegister.classList.remove('hidden');
                    formRegister.classList.add('block');
                    formRegister.style.opacity = '1';

                    if (pushState) history.pushState({ mode: 'register' }, '', '/register');
                    if (pageTitle) pageTitle.textContent = 'Inscription | HosBank';
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            // Sur Desktop : animation fluide avec panneaux coulissants
            isAnimating = true;

            if (targetMode === 'login') {
                textRegister.style.opacity = '0';
                illustrRegister.style.opacity = '0';
                formRegister.style.opacity = '0';

                purplePanel.style.transform = 'translate3d(46vw, 0, 0)';
                creamPanel.style.transform = 'translate3d(0, 0, 0)';
                logoContainer.style.transform = 'translate3d(110px, 0, 0)';
                textContainer.style.transform = 'translate3d(110px, 0, 0)';
                illustrContainer.style.transform = 'translate3d(90px, 0, 0)';

                cornerDecor.classList.remove('right-0', 'rounded-tl-[54px]');
                cornerDecor.classList.add('left-0', 'rounded-tr-[54px]');

                curveRight.classList.add('opacity-0', 'pointer-events-none');
                curveRight.classList.remove('opacity-100');
                curveLeft.classList.remove('opacity-0', 'pointer-events-none');
                curveLeft.classList.add('opacity-100');

                if (pushState) history.pushState({ mode: 'login' }, '', '/login');
                if (pageTitle) pageTitle.textContent = 'Connexion | HosBank';

            } else {
                textLogin.style.opacity = '0';
                illustrLogin.style.opacity = '0';
                formLogin.style.opacity = '0';

                purplePanel.style.transform = 'translate3d(0, 0, 0)';
                creamPanel.style.transform = 'translate3d(54vw, 0, 0)';
                logoContainer.style.transform = 'translate3d(0, 0, 0)';
                textContainer.style.transform = 'translate3d(0, 0, 0)';
                illustrContainer.style.transform = 'translate3d(0, 0, 0)';

                cornerDecor.classList.remove('left-0', 'rounded-tr-[54px]');
                cornerDecor.classList.add('right-0', 'rounded-tl-[54px]');

                curveLeft.classList.add('opacity-0', 'pointer-events-none');
                curveLeft.classList.remove('opacity-100');
                curveRight.classList.remove('opacity-0', 'pointer-events-none');
                curveRight.classList.add('opacity-100');

                if (pushState) history.pushState({ mode: 'register' }, '', '/register');
                if (pageTitle) pageTitle.textContent = 'Inscription | HosBank';
            }

            setTimeout(() => {
                if (targetMode === 'login') {
                    textRegister.classList.add('hidden');
                    textLogin.classList.remove('hidden');
                    illustrRegister.classList.add('hidden');
                    illustrLogin.classList.remove('hidden');
                    formRegister.classList.add('hidden');
                    formLogin.classList.remove('hidden');

                    requestAnimationFrame(() => {
                        textLogin.style.opacity = '1';
                        illustrLogin.style.opacity = '1';
                        formLogin.style.opacity = '1';
                    });
                } else {
                    textLogin.classList.add('hidden');
                    textRegister.classList.remove('hidden');
                    illustrLogin.classList.add('hidden');
                    illustrRegister.classList.remove('hidden');
                    formLogin.classList.add('hidden');
                    formRegister.classList.remove('hidden');

                    requestAnimationFrame(() => {
                        textRegister.style.opacity = '1';
                        illustrRegister.style.opacity = '1';
                        formRegister.style.opacity = '1';
                    });
                }
            }, 250);

            setTimeout(() => {
                isAnimating = false;
            }, 750);
        }

        window.addEventListener('popstate', (e) => {
            const target = (e.state && e.state.mode) ? e.state.mode : (location.pathname.includes('register') ? 'register' : 'login');
            switchMode(target, false);
        });

        window.addEventListener('resize', () => {
            const isDesktop = window.innerWidth >= 1024;
            const purplePanel = document.getElementById('purplePanel');
            const creamPanel = document.getElementById('creamPanel');
            const logoContainer = document.getElementById('logoContainer');
            const textContainer = document.getElementById('textContainer');
            const illustrContainer = document.getElementById('illustrContainer');

            if (isDesktop) {
                if (currentMode === 'login') {
                    purplePanel.style.transform = 'translate3d(46vw, 0, 0)';
                    creamPanel.style.transform = 'translate3d(0, 0, 0)';
                    logoContainer.style.transform = 'translate3d(110px, 0, 0)';
                    textContainer.style.transform = 'translate3d(110px, 0, 0)';
                    illustrContainer.style.transform = 'translate3d(90px, 0, 0)';
                } else {
                    purplePanel.style.transform = 'translate3d(0, 0, 0)';
                    creamPanel.style.transform = 'translate3d(54vw, 0, 0)';
                    logoContainer.style.transform = 'translate3d(0, 0, 0)';
                    textContainer.style.transform = 'translate3d(0, 0, 0)';
                    illustrContainer.style.transform = 'translate3d(0, 0, 0)';
                }
            } else {
                purplePanel.style.transform = 'none';
                creamPanel.style.transform = 'none';
                logoContainer.style.transform = 'none';
                textContainer.style.transform = 'none';
                illustrContainer.style.transform = 'none';
            }
        });
    </script>
</body>
</html>
