<!DOCTYPE html>
<html lang="fr" class="h-full overflow-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title id="pageTitle"><%= initialMode === 'register' ? 'Inscription | HosBank' : 'Connexion | HosBank' %></title>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        theme: {
                            purple: '#746B92',
                            purpleHover: '#635B7E',
                            purpleLight: '#8A81A5',
                            cream: '#F6EFE0',
                            creamDark: '#EFE7D4',
                            borderLine: '#D8CEBB',
                            placeholder: '#9D937F',
                            textDark: '#282330',
                            coralLogo: '#E97A7A',
                            coralAccent: '#FF6F61'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        brand: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
        }
        html, body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #F6EFE0;
            color: #282330;
            font-family: 'Inter', sans-serif;
        }

        .underline-input {
            border: none;
            border-bottom: 1.5px solid #D8CEBB;
            background: transparent;
            outline: none;
            transition: border-color 0.2s ease, padding-left 0.2s ease;
            color: #282330;
        }
        .underline-input::placeholder {
            color: #9D937F;
            font-weight: 400;
        }
        .underline-input:focus {
            border-bottom-color: #746B92;
            padding-left: 2px;
        }

        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #F6EFE0 inset !important;
            -webkit-text-fill-color: #282330 !important;
        }

        .panel-slide-transition {
            transition: transform 750ms cubic-bezier(0.65, 0, 0.35, 1);
            will-change: transform;
        }

        .inner-content-slide {
            transition: transform 750ms cubic-bezier(0.65, 0, 0.35, 1), opacity 400ms ease;
            will-change: transform, opacity;
        }

        .fade-swap-transition {
            transition: opacity 300ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .curve-fade-transition {
            transition: opacity 450ms ease;
        }

        .brand-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        @media (max-width: 1023px) {
            #purplePanel,
            #creamPanel,
            #logoContainer,
            #textContainer,
            #illustrContainer {
                transform: none !important;
                transition: none !important;
            }
            .panel-slide-transition,
            .inner-content-slide {
                transition: none !important;
            }
            #purplePanel {
                min-height: 220px !important;
                height: 220px !important;
            }
            #textContainer {
                min-height: 110px !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
                margin-top: auto !important;
                margin-bottom: auto !important;
            }
        }
    </style>
</head>
<body class="w-full min-h-screen overflow-x-hidden overflow-y-auto lg:overflow-hidden lg:h-screen lg:w-screen relative select-none bg-[#F6EFE0]">

    <div id="authViewport" class="w-full min-h-screen lg:h-full relative overflow-x-hidden overflow-y-auto lg:overflow-hidden flex flex-col lg:flex-row">

        <div 
            id="purplePanel" 
            class="relative lg:absolute lg:top-0 lg:bottom-0 lg:left-0 w-full lg:w-[54vw] h-auto lg:h-full bg-[#746B92] text-white p-6 sm:p-8 lg:p-16 flex flex-col justify-between rounded-b-[28px] sm:rounded-b-[36px] lg:rounded-none z-20 overflow-hidden panel-slide-transition shrink-0 shadow-md lg:shadow-none"
            style="transform: <%= initialMode === 'login' ? 'translate3d(46vw, 0, 0)' : 'translate3d(0, 0, 0)' %>;"
        >
            <div id="curveRight" class="hidden lg:block absolute top-0 right-0 bottom-0 w-[180px] h-full pointer-events-none z-30 curve-fade-transition <%= initialMode === 'login' ? 'opacity-0 pointer-events-none' : 'opacity-100' %>">
                <svg viewBox="0 0 180 800" preserveAspectRatio="none" class="w-full h-full">
                    <path d="M 180,0 L 40,0 C 120,160 210,380 0,800 L 180,800 Z" fill="#F6EFE0"></path>
                </svg>
            </div>

            <div id="curveLeft" class="hidden lg:block absolute top-0 left-0 bottom-0 w-[180px] h-full pointer-events-none -translate-x-[1px] z-30 curve-fade-transition <%= initialMode === 'login' ? 'opacity-100' : 'opacity-0 pointer-events-none' %>">
                <svg viewBox="0 0 180 800" preserveAspectRatio="none" class="w-full h-full">
                    <path d="M 0,0 L 35,0 C 5,120 160,220 140,400 C 125,540 50,680 0,800 Z" fill="#F6EFE0"></path>
                </svg>
            </div>

            <div 
                id="logoContainer" 
                class="relative z-40 flex items-center inner-content-slide"
                style="transform: <%= initialMode === 'login' ? 'translate3d(110px, 0, 0)' : 'translate3d(0, 0, 0)' %>;"
            >
                <a href="/" class="inline-flex items-center select-none group cursor-pointer" title="HosBank">
                    <div class="flex items-center">
                        <svg class="h-7 sm:h-[30px] w-auto mr-[2px] transition-transform duration-200 group-hover:scale-[1.03]" viewBox="0 0 25 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="0" y="2" width="5.5" height="24" rx="1.5" fill="#FFFFFF"/>
                            <rect x="18.5" y="2" width="5.5" height="24" rx="1.5" fill="#FFFFFF"/>
                            <path d="M5.5 17.5 L18.5 10.5 L18.5 15.2 L5.5 22.2 Z" fill="#E97A7A"/>
                        </svg>

                        <div class="flex items-baseline brand-wordmark">
                            <span class="text-[26px] sm:text-[28px] font-[800] tracking-[-0.04em] text-white leading-none">os</span>
                            <span class="text-[26px] sm:text-[28px] font-[800] tracking-[-0.03em] text-white/95 leading-none ml-[0.5px]">Bank</span>
                            <span class="w-[6.5px] h-[6.5px] rounded-full bg-[#E97A7A] ml-1.5 self-end mb-1 shadow-[0_0_8px_rgba(233,122,122,0.65)]"></span>
                        </div>
                    </div>
                </a>
            </div>

            <div 
                id="textContainer"
                class="relative z-40 my-4 sm:my-6 lg:my-auto max-w-md inner-content-slide"
                style="transform: <%= initialMode === 'login' ? 'translate3d(110px, 0, 0)' : 'translate3d(0, 0, 0)' %>;"
            >
                <div id="textRegister" class="fade-swap-transition <%= initialMode === 'register' ? 'opacity-100 block' : 'opacity-0 hidden' %>">
                    <h1 class="text-2xl sm:text-3xl lg:text-[42px] font-bold tracking-tight leading-[1.15] text-white">
                        Heureux de vous compter parmi nous !
                    </h1>
                    <p class="text-[13px] sm:text-[14px] text-[#DDD7EB] font-normal leading-relaxed mt-2 sm:mt-4 max-w-xs">
                        Rejoignez des milliers de clients qui font confiance à HosBank pour une gestion bancaire moderne, fluide et sécurisée.
                    </p>
                </div>

                <div id="textLogin" class="fade-swap-transition <%= initialMode === 'login' ? 'opacity-100 block' : 'opacity-0 hidden' %>">
                    <h2 class="text-2xl sm:text-3xl lg:text-[44px] font-bold tracking-tight leading-[1.15] text-white">
                        Ravi de vous revoir !
                    </h2>
                    <p class="text-xs sm:text-sm lg:text-base text-[#DDD7EB] font-normal leading-relaxed mt-1 sm:mt-3">
                        Reprenez là où vous vous étiez arrêté
                    </p>
                </div>
            </div>

