                        <g id="woman-right">
                            <path d="M256 200 L250 298" stroke="#252F3C" stroke-width="12" stroke-linecap="round"/>
                            <path d="M276 200 L286 298" stroke="#252F3C" stroke-width="12" stroke-linecap="round"/>
                            <ellipse cx="248" cy="303" rx="9" ry="5" fill="#171D24"/>
                            <ellipse cx="290" cy="303" rx="9" ry="5" fill="#171D24"/>

                            <path d="M246 150 L290 150 L286 204 L252 204 Z" fill="#F4CEC4"/>
