                    <svg viewBox="0 0 460 340" class="w-full h-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <ellipse cx="230" cy="190" rx="170" ry="110" fill="#887EA2" opacity="0.45"/>
                        <ellipse cx="230" cy="305" rx="180" ry="14" fill="#62597C" opacity="0.6"/>
