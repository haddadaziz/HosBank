<% const userRole=typeof role !=='undefined' ? role : (typeof currentRole !=='undefined' ? currentRole : 'admin' );
    const path=typeof currentPath !=='undefined' ? currentPath : (typeof activePath !=='undefined' ? activePath : '' );
    const currentUser=(typeof user !=='undefined' && user) ? user : ((typeof admin !=='undefined' && admin) ? admin : {
    name: userRole==='admin' ? 'Admin HosBank' : (userRole==='advisor' ? 'Karim Bennani' : 'Client HosBank' ), role:
    userRole==='admin' ? 'Superviseur' : (userRole==='advisor' ? 'Conseiller Clientèle' : 'Particulier' ), avatar:
    userRole==='admin' ? 'HB' : (userRole==='advisor' ? 'KB' : 'CL' ) }); %>

    <aside class="admin-sidebar" id="adminSidebar">
        <!-- En-tête Sidebar : Logo HosBank Officiel -->
        <div class="sidebar-brand">
            <a href="<%= userRole === 'admin' ? '/admin/dashboard' : (userRole === 'advisor' ? '/advisor/dashboard' : '/client/dashboard') %>"
                class="hosbank-logo" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
                <img src="/images/logo-white.svg" alt="HosBank" style="height: 28px; width: auto;" />
                <% if (userRole==='admin' ) { %>
                    <span class="hosbank-badge-admin"
                        style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: rgba(233, 122, 122, 0.2); color: #E97A7A; padding: 2px 7px; border-radius: 6px; border: 1px solid rgba(233, 122, 122, 0.35);">Admin</span>
                    <% } else if (userRole==='advisor' ) { %>
                        <span class="hosbank-badge-advisor"
                            style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: rgba(116, 107, 146, 0.25); color: #FFFFFF; padding: 2px 7px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.2);">Pro</span>
                    <% } %>
            </a>
            <button type="button" class="sidebar-mobile-close" id="sidebarMobileClose" aria-label="Fermer le menu">&times;</button>
        </div>

        <!-- Navigation Principale -->
        <nav class="sidebar-nav"
            style="flex: 1; margin-top: 24px; display: flex; flex-direction: column; gap: 6px; overflow-y: auto;">
            <% if (userRole==='admin' ) { %>
                <div class="nav-section-title">Navigation Principale</div>

                <a href="/admin/dashboard" class="nav-item <%= path === '/admin/dashboard' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    <span>Tableau de bord</span>
                </a>

                <a href="/admin/clients" class="nav-item <%= path === '/admin/clients' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <span>Clients</span>
                </a>

                <a href="/admin/accounts" class="nav-item <%= path === '/admin/accounts' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span>Comptes & Cartes</span>
                </a>

                <a href="/admin/transactions" class="nav-item <%= path === '/admin/transactions' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                    <span>Virements & Flux</span>
                    <span class="nav-badge">3</span>
                </a>

                <div class="nav-section-title" style="margin-top: 14px;">Contrôle & Sécurité</div>

                <a href="/admin/kyc" class="nav-item <%= path === '/admin/kyc' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Vérification KYC</span>
                    <span class="nav-badge" style="background-color: var(--primary, #746B92);">2</span>
                </a>

                <a href="/admin/requests" class="nav-item <%= path === '/admin/requests' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                    <span>Demandes & Réclamations</span>
                </a>

                <a href="/admin/settings" class="nav-item <%= path === '/admin/settings' ? 'active' : '' %>">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Paramètres & Audit</span>
                </a>

                <% } else if (userRole==='advisor' ) { %>
                    <div class="nav-section-title">Portefeuille & Suivi</div>

                    <a href="/advisor/dashboard" class="nav-item <%= path === '/advisor/dashboard' ? 'active' : '' %>">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span>Clients Affectés</span>
                        <span class="nav-badge">38</span>
                    </a>

                    <a href="/advisor/dashboard#demandes" class="nav-item">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>Demandes Bancaires</span>
                        <span class="nav-badge" style="background-color: #E97A7A;">5</span>
                    </a>

                    <a href="/advisor/dashboard#oppositions" class="nav-item">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                        <span>Oppositions Carte</span>
                        <span class="nav-badge" style="background-color: #EF4444;">1</span>
                    </a>

                    <a href="/advisor/dashboard#reclamations" class="nav-item">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                        <span>Réclamations</span>
                        <span class="nav-badge" style="background-color: #E97A7A;">2</span>
                    </a>

                    <% } else { %>
                        <div class="nav-section-title">Mes Services</div>

                        <a href="/client/dashboard" class="nav-item <%= (path === '/client/dashboard' || path === '/client') ? 'active' : '' %>">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                            </svg>
                            <span>Mes Comptes</span>
                        </a>

                        <a href="/client/transfers" class="nav-item <%= path === '/client/transfers' ? 'active' : '' %>">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                            </svg>
                            <span>Virements</span>
                        </a>

                        <a href="/client/cards" class="nav-item <%= path === '/client/cards' ? 'active' : '' %>">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                            </svg>
                            <span>Mes Cartes</span>
                        </a>

                        <a href="/client/documents" class="nav-item <%= path === '/client/documents' ? 'active' : '' %>">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <span>RIB & Relevés</span>
                        </a>
                        <% } %>
        </nav>

        <!-- Pied de Sidebar : Profil & Déconnexion -->
        <div class="sidebar-footer" style="padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="admin-profile-pill"
                style="display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 12px; background: rgba(255, 255, 255, 0.06);">
                <div class="admin-profile-avatar"
                    style="width: 38px; height: 38px; border-radius: 50%; background: #746B92; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; color: #FFFFFF; flex-shrink: 0;">
                    <%= currentUser.avatar || 'HB' %>
                </div>
                <div class="admin-profile-info" style="flex: 1; overflow: hidden;">
                    <div class="admin-profile-name"
                        style="font-size: 0.84rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; color: #FFFFFF;">
                        <%= currentUser.name %>
                    </div>
                    <% if (userRole !=='client' ) { %>
                        <div class="admin-profile-role"
                            style="font-size: 0.7rem; color: rgba(255, 255, 255, 0.5); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                            <%= currentUser.role %>
                        </div>
                        <% } %>
                </div>

                <a href="<%= userRole === 'admin' ? '/admin/logout' : '/logout' %>" title="Déconnexion"
                    style="color: rgba(255,255,255,0.6); padding: 4px; display: flex; align-items: center; justify-content: center; text-decoration: none; border-radius: 6px; transition: color 0.15s ease;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </a>
            </div>
        </div>
    </aside>