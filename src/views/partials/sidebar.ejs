<% 
    const userRole = typeof role !== 'undefined' ? role : (typeof currentRole !== 'undefined' ? currentRole : 'admin');
    const path = typeof currentPath !== 'undefined' ? currentPath : (typeof activePath !== 'undefined' ? activePath : '');
    const currentUser = (typeof user !== 'undefined' && user) ? user : ((typeof admin !== 'undefined' && admin) ? admin : ((typeof advisor !== 'undefined' && advisor) ? advisor : {
        name: userRole === 'admin' ? 'Admin HosBank' : (userRole === 'advisor' ? 'Aziz Haddad' : 'Alexandre Moreau'),
        role: userRole === 'admin' ? 'Superviseur' : (userRole === 'advisor' ? 'Conseiller Clientèle' : 'Particulier')
    }));

    // Calcul dynamique des initiales prénom + nom (ex: "Alexandre Moreau" -> "AM")
    let initials = '';
    if (currentUser.prenom && currentUser.nom) {
        initials = (currentUser.prenom.trim().charAt(0) + currentUser.nom.trim().charAt(0)).toUpperCase();
    } else if (currentUser.name) {
        const parts = currentUser.name.trim().split(/\s+/).filter(Boolean);
        if (parts.length >= 2) {
            initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
        } else if (parts.length === 1) {
            initials = parts[0].substring(0, 2).toUpperCase();
        }
    }
    if (!initials || initials === 'CL') {
        if (currentUser.avatar && currentUser.avatar !== 'CL') {
            initials = currentUser.avatar;
        } else {
            initials = userRole === 'admin' ? 'HB' : (userRole === 'advisor' ? 'AH' : 'AM');
        }
    }
%>

    <!-- Barre Mobile avec Menu Hamburger pour tous les rôles -->
    <header class="mobile-nav-header">
        <button type="button" class="mobile-hamburger-btn" id="mobileMenuToggle" aria-label="Ouvrir le menu">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <a href="<%= userRole === 'admin' ? '/admin/dashboard' : (userRole === 'advisor' ? '/advisor/dashboard' : '/client/dashboard') %>" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
            <img src="/images/logo-white.svg" alt="HosBank" style="height: 26px; width: auto;" />
            <% if (userRole === 'admin') { %>
                <span style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase; background: rgba(233, 122, 122, 0.25); color: #E97A7A; padding: 2px 7px; border-radius: 6px; border: 1px solid rgba(233, 122, 122, 0.4);">Admin</span>
            <% } %>
        </a>

        <a href="<%= userRole === 'client' ? '/client/profile' : (userRole === 'advisor' ? '/advisor/profile' : '/admin/dashboard') %>" class="mobile-avatar-pill" title="Mon Profil">
            <%= initials %>
        </a>
    </header>

