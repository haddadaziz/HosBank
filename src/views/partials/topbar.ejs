<header class="admin-topbar">
    <div style="display: flex; align-items: center; gap: 12px;">
        <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menu de navigation">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <div class="topbar-search">
            <svg width="18" height="18" fill="none" stroke="#746D82" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" id="tableLiveSearch" placeholder="Rechercher client, IBAN, opération...">
        </div>
    </div>

    <div class="topbar-actions">
        <button class="icon-button" title="Système en ligne" style="color: var(--status-success);">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
        </button>

        <button type="button" class="icon-button" title="Notifications & Alertes">
            <span class="btn-dot"></span>
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
        </button>

        <div style="display: flex; align-items: center; gap: 10px; margin-left: 6px;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                A
            </div>
            <div class="topbar-admin-name" style="font-size: 0.88rem; font-weight: 600; color: var(--text-main);">
                <%= typeof admin !== 'undefined' && admin ? admin.name : 'Administrateur' %>
            </div>
        </div>

        <a href="/logout" class="icon-button" title="Se déconnecter" style="color: #DC2626; margin-left: 6px;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
        </a>
    </div>
</header>
