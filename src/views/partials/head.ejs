<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | HosBank' : 'HosBank | Banque Digitale Sécurisée' %></title>
    
    <meta name="description" content="HosBank - Plateforme bancaire en ligne sécurisée. Accédez à vos comptes, virements et cartes en toute simplicité.">
    <meta name="theme-color" content="#746B92">
    
    <!-- Favicon HosBank -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#F0F7FF',
                            100: '#E0EFFF',
                            500: '#3B82F6',
                            600: '#2563EB',
                            700: '#1D4ED8',
                            800: '#1E40AF',
                        },
                        bank: {
                            dark: '#0B0E14',
                            surface: '#121722',
                            surfaceHover: '#161D2B',
                            border: '#1E2638',
                            borderHover: '#2E3952',
                            input: '#0E131D',
                            muted: '#64748B',
                            subtle: '#94A3B8',
                            text: '#F8FAFC'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                    },
                    boxShadow: {
                        'fintech': '0 20px 40px -15px rgba(0, 0, 0, 0.65)',
                        'glow': '0 0 25px -5px rgba(37, 99, 235, 0.25)',
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-bank-dark text-bank-text font-sans antialiased min-h-screen selection:bg-brand-600 selection:text-white">
