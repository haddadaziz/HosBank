<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-num { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-[#F8F9FA] text-[#282330] min-h-screen antialiased">

    <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- Sidebar unifiée HosBank pour Conseiller -->
        <%- include('../partials/sidebar', { role: 'advisor', currentPath: '/advisor/claims', user: advisor, metrics: metrics }) %>

        <!-- Contenu Principal -->
        <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 max-w-[1400px] w-full min-w-0 space-y-6">

            <!-- En-tête de page -->
            <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-[#282330] tracking-tight">Réclamations Clients</h1>
                    <p class="text-sm text-[#7A6F82] mt-1">Traitement et suivi des contestations bancaires et demandes d'assistance</p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="filterClaims('ALL')" class="claim-filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#746B92] text-white shadow-xs transition-colors">
                        Toutes (<%= claims.length %>)
                    </button>
                    <button onclick="filterClaims('En cours')" class="claim-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#7A6F82] hover:text-[#282330] border border-[#D8CEBB] transition-colors">
                        En cours
                    </button>
                    <button onclick="filterClaims('Ouverte')" class="claim-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#7A6F82] hover:text-[#282330] border border-[#D8CEBB] transition-colors">
                        Ouvertes
                    </button>
                    <button onclick="filterClaims('Clôturée')" class="claim-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#7A6F82] hover:text-[#282330] border border-[#D8CEBB] transition-colors">
                        Clôturées
                    </button>
                </div>
            </header>

            <!-- Notifications -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center gap-3 shadow-xs">
                    <span>✅ La réponse officielle a été enregistrée et transmise au client.</span>
                </div>
            <% } %>

            <!-- Grille des réclamations -->
            <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 shadow-sm">
                <% if (claims.length === 0) { %>
                    <div class="py-16 px-4 text-center bg-[#FAF5ED]/50 rounded-2xl border border-dashed border-[#D8CEBB]">
                        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center border border-[#D8CEBB]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                        </div>
                        <h3 class="text-sm font-bold text-[#282330]" id="claimsEmptyTitle">Aucune réclamation enregistrée</h3>
                        <p class="text-xs text-[#7A6F82] mt-1 max-w-sm mx-auto" id="claimsEmptyDesc">Vous n'avez aucune réclamation client ouverte ou en cours pour le moment.</p>
                    </div>
                <% } else { %>
                    <div id="claimsCardsContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                        <% claims.forEach(c => { %>
                            <div class="bg-[#FAF5ED] border border-[#D8CEBB] hover:border-[#746B92] rounded-2xl p-5 space-y-4 claim-row shadow-xs transition-all duration-200 flex flex-col justify-between group" data-status="<%= c.status %>">
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-xs font-bold text-[#746B92] bg-[#EFE7D4] px-2.5 py-1 rounded-lg"><%= c.id %></span>
                                            <% if (c.priority === 'Haute') { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#E97A7A] text-white">PRIORITÉ HAUTE</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#EFE7D4] text-[#7A6F82]">Normale</span>
                                            <% } %>
                                        </div>
                                        <div>
                                            <% if (c.status === 'Ouverte') { %>
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800">
                                                    Ouverte
                                                </span>
                                            <% } else if (c.status === 'En cours') { %>
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800">
                                                    En cours
                                                </span>
                                            <% } else { %>
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800">
                                                    Clôturée
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div>
                                        <h4 class="font-bold text-sm text-[#282330] group-hover:text-[#746B92] transition-colors"><%= c.object %></h4>
                                        <div class="flex items-center justify-between mt-1 text-xs text-[#7A6F82]">
                                            <span>Client : <strong class="text-[#282330] font-semibold"><%= c.clientName %></strong></span>
                                            <span class="text-[11px] font-mono text-[#9D937F]"><%= c.date %></span>
                                        </div>
                                    </div>

                                    <div class="bg-white p-3 rounded-xl border border-[#D8CEBB]/80 text-[#282330] text-xs leading-relaxed shadow-2xs">
                                        <span class="text-[10px] font-bold text-[#9D937F] uppercase tracking-wider block mb-1">Motif de la contestation</span>
                                        <p class="text-[#282330] line-clamp-3"><%= c.description %></p>
                                    </div>

                                    <% if (c.response) { %>
                                        <div class="text-[11px] text-[#7A6F82] bg-emerald-50 p-2.5 rounded-lg border border-emerald-200">
                                            <span class="font-bold text-emerald-900">Réponse transmise :</span> <%= c.response %>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="pt-3 border-t border-[#D8CEBB] flex items-center justify-between">
                                    <span class="text-[10px] text-[#9D937F]">Réf : <%= c.id %></span>
                                    <button 
                                        type="button"
                                        class="btn-open-claim px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer"
                                        data-id="<%= c.dbId || c.id %>"
                                        data-client="<%= c.clientName %>"
                                        data-object="<%= c.object %>"
                                        data-status="<%= c.status %>"
                                        data-response="<%= c.response || '' %>"
                                    >
                                        <span>Répondre</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div id="claimFilterEmpty" class="hidden py-16 px-4 text-center bg-[#FAF5ED]/50 rounded-2xl border border-dashed border-[#D8CEBB]">
                        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center border border-[#D8CEBB]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                        </div>
                        <h3 class="text-sm font-bold text-[#282330]">Aucune réclamation trouvée</h3>
                        <p class="text-xs text-[#7A6F82] mt-1 max-w-sm mx-auto">Aucune réclamation ne correspond au statut sélectionné.</p>
                    </div>
                <% } %>
            </div>

        </main>
    </div>

    <!-- Modal Réclamation -->
    <div id="claimModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
        <div class="bg-[#FFFFFF] border border-[#D8CEBB] rounded-2xl max-w-lg w-full p-6 shadow-xl relative animate-fade">
            <button onclick="closeClaimModal()" class="absolute top-4 right-4 text-[#7A6F82] hover:text-[#282330] p-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <h3 class="text-base font-bold text-[#282330]">Traiter la Réclamation</h3>
            <p class="text-xs text-[#7A6F82] mt-0.5" id="modalClaimClient">Client : </p>

            <form action="/advisor/claim/resolve" method="POST" class="mt-4 space-y-4">
                <input type="hidden" name="claimId" id="modalClaimId">

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Objet de la réclamation</label>
                    <input type="text" id="modalClaimObject" readonly class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3 py-2 text-xs text-[#282330] font-medium">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Statut de résolution</label>
                    <select name="newStatus" id="modalClaimStatusSelect" class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3 py-2 text-xs text-[#282330] focus:outline-none focus:border-[#746B92]">
                        <option value="Clôturée">Clôturer la réclamation (Résolue)</option>
                        <option value="En cours">Maintenir en cours d'instruction</option>
                        <option value="Ouverte">Laisser ouverte</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Réponse officielle communiquée au client</label>
                    <textarea 
                        name="responseText" 
                        id="modalClaimResponseText" 
                        rows="4" 
                        required
                        placeholder="Rédigez la réponse détaillée et la décision officielle de la banque..."
                        class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl p-3 text-xs text-[#282330] placeholder-[#9D937F] focus:outline-none focus:border-[#746B92]"
                    ></textarea>
                </div>

                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeClaimModal()" class="px-4 py-2 rounded-xl text-xs font-medium text-[#7A6F82] hover:bg-[#FAF5ED] transition-colors">
                        Annuler
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-sm transition-colors">
                        Enregistrer et notifier le client
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function filterClaims(status, ev) {
            const e = ev || window.event;
            document.querySelectorAll('.claim-filter-btn').forEach(b => {
                b.classList.remove('bg-[#746B92]', 'text-white', 'shadow-xs');
                b.classList.add('bg-white', 'text-[#7A6F82]');
            });
            if (e && (e.currentTarget || e.target)) {
                const targetBtn = e.currentTarget || e.target;
                targetBtn.classList.remove('bg-white', 'text-[#7A6F82]');
                targetBtn.classList.add('bg-[#746B92]', 'text-white', 'shadow-xs');
            }

            const rows = document.querySelectorAll('.claim-row');
            let visibleCount = 0;
            rows.forEach(r => {
                if (status === 'ALL' || r.getAttribute('data-status') === status) {
                    r.style.display = 'flex';
                    visibleCount++;
                } else {
                    r.style.display = 'none';
                }
            });

            const filterEmpty = document.getElementById('claimFilterEmpty');
            if (filterEmpty) {
                if (visibleCount === 0 && rows.length > 0) {
                    filterEmpty.classList.remove('hidden');
                } else {
                    filterEmpty.classList.add('hidden');
                }
            }

            const claimsEmptyTitle = document.getElementById('claimsEmptyTitle');
            const claimsEmptyDesc = document.getElementById('claimsEmptyDesc');
            if (claimsEmptyTitle && claimsEmptyDesc && rows.length === 0) {
                if (status === 'ALL') {
                    claimsEmptyTitle.textContent = "Aucune réclamation enregistrée";
                    claimsEmptyDesc.textContent = "Vous n'avez aucune réclamation client ouverte ou en cours pour le moment.";
                } else {
                    claimsEmptyTitle.textContent = "Aucune réclamation trouvée";
                    claimsEmptyDesc.textContent = "Aucune réclamation ne correspond au statut « " + status + " ».";
                }
            }
        }

        function openClaimModal(id, client, obj, status, response) {
            document.getElementById('modalClaimId').value = id;
            document.getElementById('modalClaimClient').textContent = 'Client : ' + client;
            document.getElementById('modalClaimObject').value = obj;
            document.getElementById('modalClaimResponseText').value = response || '';
            document.getElementById('modalClaimStatusSelect').value = status || 'Clôturée';
            document.getElementById('claimModal').classList.remove('hidden');
        }

        function closeClaimModal() {
            document.getElementById('claimModal').classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.btn-open-claim').forEach(btn => {
                btn.addEventListener('click', () => {
                    openClaimModal(
                        btn.dataset.id,
                        btn.dataset.client,
                        btn.dataset.object,
                        btn.dataset.status,
                        btn.dataset.response
                    );
                });
            });
        });
    </script>
</body>
</html>
