<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-num { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-[#F8F9FA] text-[#282330] min-h-screen antialiased">

    <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- Sidebar unifiée HosBank pour Conseiller -->
        <%- include('../partials/sidebar', { role: 'advisor', currentPath: '/advisor/profile', user: advisor }) %>

        <!-- Contenu Principal -->
        <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 max-w-[1200px] w-full min-w-0 space-y-6">

            <!-- En-tête de page -->
            <header>
                <div class="flex items-center gap-2 text-xs font-semibold text-[#9D937F] mb-2">
                    <a href="/advisor/dashboard" class="hover:text-[#746B92] transition-colors">Espace Conseiller</a>
                    <span>/</span>
                    <span class="text-[#282330]">Mon Profil & Sécurité</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-[#282330] tracking-tight">Mon Profil Conseiller</h1>
                <p class="text-sm text-[#7A6F82] mt-1">Consultez vos informations professionnelles et sécurisez vos identifiants d'accès</p>
            </header>

            <!-- Notifications / Alertes -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-xs">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span><%= success %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center justify-between shadow-xs">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span><%= error %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-rose-700 hover:text-rose-900 font-bold">&times;</button>
                </div>
            <% } %>

            <!-- Carte d'identité Conseiller -->
            <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 lg:p-7 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                    <div class="w-16 h-16 rounded-2xl bg-[#746B92] text-white flex items-center justify-center font-extrabold text-xl shadow-xs border-2 border-white shrink-0">
                        <%= advisor.avatar || 'AH' %>
                    </div>
                    <div>
                        <div class="flex items-center gap-3">
                            <h2 class="text-xl font-bold text-[#282330]"><%= advisor.civilite || 'M.' %> <%= advisor.name %></h2>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#FAF5ED] text-[#746B92] border border-[#D8CEBB]">
                                Conseiller Clientèle
                            </span>
                        </div>
                        <p class="text-xs text-[#7A6F82] mt-1"><%= advisor.agency || 'HosBank Agence Centrale • Paris Opéra' %></p>
                        <div class="flex items-center gap-4 mt-2 text-[11px] text-[#9D937F]">
                            <span>Affectation : <strong class="text-[#282330]"><%= advisor.dateCreation || '2024' %></strong></span>
                            <span>•</span>
                            <span class="flex items-center gap-1.5 text-emerald-600 font-semibold">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                Session active
                            </span>
                        </div>
                    </div>
                </div>

                <div class="sm:text-right shrink-0">
                    <span class="text-[11px] text-[#9D937F] block">Identifiant Agent</span>
                    <span class="font-mono text-xs font-bold text-[#746B92] bg-[#FAF5ED] px-3 py-1.5 rounded-xl border border-[#D8CEBB] inline-block mt-1">
                        ADV-00<%= advisor.id || 2 %>
                    </span>
                </div>
            </div>

            <!-- Grille 2 Colonnes : Coordonnées & Mot de passe -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                <!-- Carte 1 : Coordonnées Professionnelles -->
                <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 pb-4 mb-5 border-b border-[#EFE7D4]">
                            <div class="w-9 h-9 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center shrink-0 border border-[#D8CEBB]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-[#282330]">Coordonnées Professionnelles</h3>
                                <p class="text-xs text-[#7A6F82]">Informations de contact associées à vos clients</p>
                            </div>
                        </div>

                        <form action="/advisor/profile" method="POST" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-[#282330] mb-1.5">Nom et Prénom</label>
                                <input 
                                    type="text" 
                                    value="<%= advisor.name %>" 
                                    readonly 
                                    class="w-full bg-[#FAF5ED]/60 border border-[#D8CEBB] rounded-xl px-3.5 py-2.5 text-xs text-[#282330] font-medium cursor-not-allowed"
                                >
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-[#282330] mb-1.5">E-mail professionnel</label>
                                <input 
                                    type="email" 
                                    value="<%= advisor.email %>" 
                                    readonly 
                                    class="w-full bg-[#FAF5ED]/60 border border-[#D8CEBB] rounded-xl px-3.5 py-2.5 text-xs text-[#282330] font-medium cursor-not-allowed"
                                >
                                <p class="text-[10px] text-[#9D937F] mt-1">Géré par l'administration HosBank.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-[#282330] mb-1.5">Ligne téléphonique directe</label>
                                <input 
                                    type="text" 
                                    name="phone" 
                                    value="<%= advisor.phone %>" 
                                    required
                                    class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3.5 py-2.5 text-xs text-[#282330] font-medium focus:outline-none focus:border-[#746B92] transition-colors"
                                    placeholder="+33 1 42 68 55 00"
                                >
                            </div>

                            <div class="pt-2">
                                <button 
                                    type="submit" 
                                    class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-xs transition-colors cursor-pointer"
                                >
                                    Enregistrer les coordonnées
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Carte 2 : Sécurité & Changement de Mot de Passe -->
                <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 pb-4 mb-5 border-b border-[#EFE7D4]">
                            <div class="w-9 h-9 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center shrink-0 border border-[#D8CEBB]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-[#282330]">Modifier mon mot de passe</h3>
                                <p class="text-xs text-[#7A6F82]">Mise à jour sécurisée de vos accès</p>
                            </div>
                        </div>

                        <form action="/advisor/profile/password" method="POST" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-[#282330] mb-1.5">Mot de passe actuel</label>
                                <input 
                                    type="password" 
                                    name="currentPassword" 
                                    required 
                                    placeholder="••••••••••••"
                                    class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3.5 py-2.5 text-xs text-[#282330] font-medium focus:outline-none focus:border-[#746B92] transition-colors"
                                >
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-[#282330] mb-1.5">Nouveau mot de passe</label>
                                <input 
                                    type="password" 
                                    name="newPassword" 
                                    required 
                                    minlength="8"
                                    placeholder="8 caractères minimum"
                                    class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3.5 py-2.5 text-xs text-[#282330] font-medium focus:outline-none focus:border-[#746B92] transition-colors"
                                >
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-[#282330] mb-1.5">Confirmer le nouveau mot de passe</label>
                                <input 
                                    type="password" 
                                    name="confirmPassword" 
                                    required 
                                    minlength="8"
                                    placeholder="Confirmer votre mot de passe"
                                    class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3.5 py-2.5 text-xs text-[#282330] font-medium focus:outline-none focus:border-[#746B92] transition-colors"
                                >
                            </div>

                            <div class="pt-2">
                                <button 
                                    type="submit" 
                                    class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-xs transition-colors cursor-pointer"
                                >
                                    Mettre à jour le mot de passe
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>

        </main>
    </div>

</body>
</html>
