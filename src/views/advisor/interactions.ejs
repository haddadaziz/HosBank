<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-num { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-[#F8F9FA] text-[#282330] min-h-screen antialiased">

    <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- Sidebar unifiée HosBank pour Conseiller -->
        <%- include('../partials/sidebar', { role: 'advisor', currentPath: '/advisor/interactions', user: advisor, metrics: metrics }) %>

        <!-- Contenu Principal -->
        <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 max-w-[1400px] w-full min-w-0 space-y-6">

            <!-- En-tête de page -->
            <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-[#282330] tracking-tight">Journal d'Interactions</h1>
                    <p class="text-sm text-[#7A6F82] mt-1">Historique d'audit et traçabilité des opérations de vos clients</p>
                </div>

                <div class="relative w-full sm:w-72">
                    <input 
                        type="text" 
                        id="interactionSearchInput"
                        placeholder="Filtrer l'historique..." 
                        class="w-full bg-white border border-[#D8CEBB] rounded-xl pl-9 pr-3 py-2 text-xs text-[#282330] placeholder-[#9D937F] focus:outline-none focus:border-[#746B92] shadow-xs"
                        oninput="filterInteractions(this.value)"
                    >
                    <svg class="w-4 h-4 text-[#9D937F] absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
            </header>

            <!-- Grille / Cartes des interactions -->
            <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#EFE7D4]">
                    <div class="text-sm font-bold text-[#282330]">
                        <span id="interactionCountBadge"><%= interactions.length %></span> événement(s) tracé(s)
                    </div>
                </div>

                <% if (interactions.length === 0) { %>
                    <div class="py-16 px-4 text-center bg-[#FAF5ED]/50 rounded-2xl border border-dashed border-[#D8CEBB]">
                        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center border border-[#D8CEBB]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <h3 class="text-sm font-bold text-[#282330]">Aucune interaction enregistrée</h3>
                        <p class="text-xs text-[#7A6F82] mt-1 max-w-sm mx-auto">L'historique des actions, demandes et traçabilités de vos clients apparaîtra ici sous forme de cartes d'activité.</p>
                    </div>
                <% } else { %>
                    <div id="interactionsContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                        <% interactions.forEach(it => { %>
                            <div class="bg-[#FAF5ED] border border-[#D8CEBB] hover:border-[#746B92] rounded-2xl p-5 space-y-3.5 transition-all duration-200 shadow-xs flex flex-col justify-between group interaction-card">
                                <div class="space-y-3">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 <%= it.type.includes('Opposition') || it.type.includes('Alerte') ? 'bg-[#FAF0EE] text-[#E97A7A]' : 'bg-white border border-[#D8CEBB] text-[#746B92]' %>">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                            </div>
                                            <span class="text-xs font-bold text-[#282330] line-clamp-1"><%= it.type %></span>
                                        </div>
                                        <span class="text-[10px] font-mono text-[#9D937F] bg-white px-2 py-0.5 rounded-md border border-[#D8CEBB]/60 shrink-0"><%= it.date %></span>
                                    </div>

                                    <% if (it.client) { %>
                                        <div class="text-xs text-[#7A6F82]">Client : <strong class="text-[#282330] font-semibold"><%= it.client %></strong></div>
                                    <% } %>

                                    <div class="bg-white p-3 rounded-xl border border-[#D8CEBB]/80 text-[#282330] text-xs leading-relaxed shadow-2xs">
                                        <p><%= it.summary || 'Opération enregistrée dans le système' %></p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

        </main>
    </div>

    <script>
        function filterInteractions(query) {
            const q = query.toLowerCase().trim();
            const cards = document.querySelectorAll('.interaction-card');
            let visibleCount = 0;
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                if (text.includes(q)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            const badge = document.getElementById('interactionCountBadge');
            if (badge) badge.textContent = visibleCount;
        }
    </script>
</body>
</html>
