                    <textarea 
                        name="responseText" 
                        id="modalClaimResponseText" 
                        rows="4" 
                        required
                        placeholder="Rédigez la réponse détaillée et la solution apportée au client..."
                        class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl p-3 text-xs text-[#282330] placeholder-[#9D937F] focus:outline-none focus:border-[#746B92]"
                    ></textarea>
                </div>

                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeClaimModal()" class="px-4 py-2 rounded-xl text-xs font-medium text-[#7A6F82] hover:bg-[#FAF5ED]">
                        Annuler
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-sm">
                        Envoyer la réponse
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function switchTab(tabId, filterValue = null) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-[#746B92]', 'text-white', 'shadow-sm');
                btn.classList.add('text-[#7A6F82]');
            });

            const activeTab = document.getElementById(tabId);
            const activeBtn = document.getElementById('btn-' + tabId);

            if (activeTab) activeTab.classList.add('active');
            if (activeBtn) {
                activeBtn.classList.add('bg-[#746B92]', 'text-white', 'shadow-sm');
                activeBtn.classList.remove('text-[#7A6F82]');
            }

            if (filterValue && tabId === 'tabDemands') {
                filterDemands(filterValue);
            }
        }

        function filterDemands(type) {
            const rows = document.querySelectorAll('.demand-row');
            const buttons = document.querySelectorAll('.demand-filter-btn');

            buttons.forEach(b => {
                b.classList.remove('bg-[#746B92]', 'text-white');
                b.classList.add('bg-[#FAF5ED]', 'text-[#7A6F82]');
            });

            if (event && event.target) {
                event.target.classList.add('bg-[#746B92]', 'text-white');
                event.target.classList.remove('bg-[#FAF5ED]', 'text-[#7A6F82]');
            }

            rows.forEach(row => {
                if (type === 'ALL' || row.getAttribute('data-type') === type) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function filterClientTable(query) {
            const q = query.toLowerCase();
            const rows = document.querySelectorAll('.client-row');
            rows.forEach(r => {
                const text = r.textContent.toLowerCase();
                r.style.display = text.includes(q) ? '' : 'none';
            });
        }


        function openDemandModal(id, type, clientName, details) {
            document.getElementById('modalDemandId').value = id;
            document.getElementById('modalDemandTitle').textContent = `Traiter la demande : ${type} (${id})`;
            document.getElementById('modalDemandClient').textContent = `Client : ${clientName}`;
            document.getElementById('modalDemandDetails').textContent = details;
            document.getElementById('demandModal').classList.remove('hidden');
        }
        function closeDemandModal() {
            document.getElementById('demandModal').classList.add('hidden');
        }

        function openClientDetailModal(client) {
            document.getElementById('cliModalAvatar').textContent = client.name.charAt(0);
            document.getElementById('cliModalName').textContent = `${client.civilite} ${client.name}`;
            document.getElementById('cliModalJoined').textContent = client.joinedDate;
            document.getElementById('cliModalCin').textContent = client.cin;
            document.getElementById('cliModalEmail').textContent = client.email;
            document.getElementById('cliModalPhone').textContent = client.phone;

            const accList = document.getElementById('cliModalAccountsList');
            accList.innerHTML = '';
            client.accounts.forEach(acc => {
                accList.innerHTML += `
                    <div class="bg-[#FAF5ED] p-3 rounded-xl border border-[#D8CEBB] flex items-center justify-between">
                        <div>
                            <span class="font-bold text-xs text-[#282330]">${acc.type}</span>
                            <div class="text-[10px] font-mono text-[#7A6F82]">RIB : ${acc.rib}</div>
                        </div>
                        <span class="font-bold font-num text-xs text-[#746B92]">${acc.balance.toLocaleString('fr-FR', { minimumFractionDigits: 2 })} ${acc.currency}</span>
                    </div>
                `;
            });

            const cardsList = document.getElementById('cliModalCardsList');
            cardsList.innerHTML = '';
            if (client.cards.length === 0) {
                cardsList.innerHTML = '<div class="text-xs text-[#9D937F] italic">Aucune carte active.</div>';
            } else {
                client.cards.forEach(card => {
                    cardsList.innerHTML += `
                        <div class="bg-[#FAF5ED] p-3 rounded-xl border border-[#D8CEBB] flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#746B92]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                                <div>
                                    <span class="font-bold text-xs text-[#282330]">${card.type}</span>
                                    <div class="text-[10px] font-mono text-[#7A6F82]">${card.number} • Exp : ${card.expires}</div>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded text-[10px] font-semibold ${card.status.includes('Opposition') ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'}">
                                ${card.status}
                            </span>
                        </div>
                    `;
                });
            }

            document.getElementById('clientDetailModal').classList.remove('hidden');
        }
        function closeClientDetailModal() {
            document.getElementById('clientDetailModal').classList.add('hidden');
        }

        function openClaimModal(id, clientName, object, currentStatus, currentResponse) {
            document.getElementById('modalClaimId').value = id;
            document.getElementById('modalClaimClient').textContent = `Client : ${clientName} (${id})`;
            document.getElementById('modalClaimObject').value = object;
            document.getElementById('modalClaimStatusSelect').value = currentStatus === 'Clôturée' ? 'Clôturée' : 'Clôturée';
            document.getElementById('modalClaimResponseText').value = currentResponse;
            document.getElementById('claimModal').classList.remove('hidden');
        }
        function closeClaimModal() {
            document.getElementById('claimModal').classList.add('hidden');
        }
    </script>
</body>
</html>
