<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        theme: {
                            purple: '#746B92',
                            purpleHover: '#635B7E',
                            purpleLight: '#8A81A5',
                            cream: '#F6EFE0',
                            creamDark: '#EFE7D4',
                            borderLine: '#D8CEBB',
                            placeholder: '#9D937F',
                            textDark: '#282330',
                            coralLogo: '#E97A7A',
                            coralHover: '#D96565'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        brand: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #F6EFE0;
            color: #282330;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
        }

        .font-num {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #EFE7D4;
        }
        ::-webkit-scrollbar-thumb {
            background: #746B92;
            border-radius: 3px;
        }

        .tab-pane {
            display: none;
            opacity: 0;
            transition: opacity 0.25s ease-in-out;
        }
        .tab-pane.active {
            display: block;
            opacity: 1;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">


    <header class="w-full bg-[#746B92] text-white px-4 sm:px-8 py-3.5 shadow-md flex items-center justify-between sticky top-0 z-40">
        <div class="flex items-center gap-4">
            <a href="/advisor/dashboard" class="flex items-center group select-none">
                <svg class="h-7 sm:h-[30px] w-auto mr-[2px] transition-transform duration-200 group-hover:scale-105" viewBox="0 0 25 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="0" y="2" width="5.5" height="24" rx="1.5" fill="#FFFFFF"/>
                    <rect x="18.5" y="2" width="5.5" height="24" rx="1.5" fill="#FFFFFF"/>
                    <path d="M5.5 17.5 L18.5 10.5 L18.5 15.2 L5.5 22.2 Z" fill="#E97A7A"/>
                </svg>
                <div class="flex items-baseline font-brand">
                    <span class="text-[25px] font-[800] tracking-[-0.04em] text-white leading-none">os</span>
                    <span class="text-[25px] font-[800] tracking-[-0.03em] text-white/95 leading-none ml-[0.5px]">Bank</span>
                    <span class="w-[6px] h-[6px] rounded-full bg-[#E97A7A] ml-1.5 self-end mb-1"></span>
                </div>
            </a>


        </div>

        <div class="flex items-center gap-3">
                <div class="flex items-center gap-2.5 bg-white/10 px-3 py-1.5 rounded-xl border border-white/15">
                    <div class="w-7 h-7 rounded-lg bg-[#E97A7A] text-white font-bold text-xs flex items-center justify-center shadow-xs">
                        <%= advisor.avatar %>
                    </div>
                    <div class="hidden sm:flex flex-col text-left">
                        <span class="text-xs font-semibold leading-tight text-white"><%= advisor.name %></span>
                        <span class="text-[10px] text-[#DDD7EB]">Conseiller HosBank</span>
                    </div>
                </div>

                <a 
                    href="/login" 
                    title="Déconnexion" 
                    class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-white/90 hover:text-white transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                </a>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <div onclick="switchTab('tabClients')" class="bg-[#FFFFFF] border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-sm transition-all duration-200 cursor-pointer group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-[#7A6F82]">Clients Affectés</span>
                    <div class="w-8 h-8 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-3xl font-bold font-num text-[#282330]"><%= metrics.assignedClients %></span>
                </div>
                <p class="text-[11px] text-[#9D937F] mt-1">Clients particuliers & professionnels</p>
            </div>

            <div onclick="switchTab('tabDemands')" class="bg-[#FFFFFF] border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-sm transition-all duration-200 cursor-pointer group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-[#7A6F82]">Demandes à Traiter</span>
                    <div class="w-8 h-8 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-3xl font-bold font-num text-[#282330]"><%= metrics.pendingDemands %></span>
                </div>
                <p class="text-[11px] text-[#9D937F] mt-1">RIB, Épargne, PIN & Cartes</p>
            </div>

            <div onclick="switchTab('tabDemands', 'Opposition Carte')" class="bg-[#FFFFFF] border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-sm transition-all duration-200 cursor-pointer group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-[#7A6F82]">Oppositions Carte</span>
                    <div class="w-8 h-8 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-3xl font-bold font-num text-[#282330]"><%= metrics.cardOppositions %></span>
                </div>
                <p class="text-[11px] text-[#9D937F] mt-1">Perte ou vol déclaré par le client</p>
            </div>

            <div onclick="switchTab('tabClaims')" class="bg-[#FFFFFF] border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-sm transition-all duration-200 cursor-pointer group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-[#7A6F82]">Réclamations Clients</span>
                    <div class="w-8 h-8 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-3xl font-bold font-num text-[#282330]"><%= metrics.openClaims %></span>
                </div>
                <p class="text-[11px] text-[#9D937F] mt-1">Contestations & demandes d'assistance</p>
            </div>

        </div>

        <div class="bg-[#EFE7D4] p-1.5 rounded-2xl border border-[#D8CEBB] flex flex-wrap gap-1.5">
            <button 
                onclick="switchTab('tabOverview')" 
                id="btn-tabOverview" 
                class="tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#746B92] text-white shadow-sm flex items-center gap-2"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                Vue d'ensemble
            </button>

            <button 
                onclick="switchTab('tabClients')" 
                id="btn-tabClients" 
                class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-[#7A6F82] hover:text-[#282330] flex items-center gap-2"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                Clients Affectés
                <span class="w-5 h-5 rounded-full bg-[#E97A7A] text-white text-[10px] font-bold flex items-center justify-center">
                    <%= clients.length %>
                </span>
            </button>

            <button 
                onclick="switchTab('tabDemands')" 
                id="btn-tabDemands" 
                class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-[#7A6F82] hover:text-[#282330] flex items-center gap-2"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Demandes Bancaires
                <% if (metrics.pendingDemands > 0) { %>
                    <span class="w-5 h-5 rounded-full bg-[#E97A7A] text-white text-[10px] font-bold flex items-center justify-center">
                        <%= metrics.pendingDemands %>
                    </span>
                <% } %>
            </button>

            <button 
                onclick="switchTab('tabClaims')" 
                id="btn-tabClaims" 
                class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-[#7A6F82] hover:text-[#282330] flex items-center gap-2"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
                Réclamations
                <span class="w-5 h-5 rounded-full bg-[#E97A7A] text-white text-[10px] font-bold flex items-center justify-center">
                    <%= claims.length %>
                </span>
            </button>

            <button 
                onclick="switchTab('tabInteractions')" 
                id="btn-tabInteractions" 
                class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-[#7A6F82] hover:text-[#282330] flex items-center gap-2"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Journal d'Interactions
            </button>
        </div>


        <div id="tabOverview" class="tab-pane active space-y-6">
            


            <div class="bg-[#FFFFFF] border border-[#D8CEBB] rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-base font-bold text-[#282330]">Demandes clients en attente</h2>
                        <p class="text-xs text-[#7A6F82]">Validation requise par le chargé de clientèle</p>
                    </div>
                    <button onclick="switchTab('tabDemands')" class="text-xs font-semibold text-[#746B92] hover:underline">
                        Tout afficher →
                    </button>
                </div>

                <div class="divide-y divide-[#EFE7D4]">
                    <% const pendingList = demands.filter(d => d.status === 'En attente').slice(0, 5); %>
                    <% if (pendingList.length === 0) { %>
                        <div class="py-8 text-center text-xs text-[#9D937F]">Aucune demande en attente actuellement.</div>
                    <% } else { %>
                        <% pendingList.forEach(dem => { %>
                            <div class="py-3.5 flex items-center justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 <%= dem.priority === 'URGENT' ? 'bg-[#FAF0EE] text-[#E97A7A]' : 'bg-[#FAF5ED] text-[#746B92]' %>">
                                        <% if (dem.type === 'Opposition Carte') { %>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                        <% } else if (dem.type === 'Carte Virtuelle') { %>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                                        <% } else if (dem.type === 'Compte d\'Épargne') { %>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <% } else { %>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                        <% } %>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-[#282330]"><%= dem.type %></span>
                                            <% if (dem.priority === 'URGENT') { %>
                                                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-[#E97A7A] text-white">URGENT</span>
                                            <% } %>
                                        </div>
                                        <p class="text-[11px] text-[#7A6F82]">Client : <span class="font-medium text-[#282330]"><%= dem.clientName %></span> • <%= dem.date %></p>
                                    </div>
                                </div>

                                <button 
                                    onclick="openDemandModal('<%= dem.id %>', '<%= dem.type %>', '<%= dem.clientName %>', '<%= dem.details %>')"
                                    class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white transition-colors"
                                >
                                    Traiter
                                </button>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

        </div>


        <div id="tabClients" class="tab-pane space-y-4">
            
            <div class="bg-[#FFFFFF] border border-[#D8CEBB] rounded-2xl p-6 shadow-sm">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-bold text-[#282330]">Portefeuille des Clients Affectés</h2>
                        <p class="text-xs text-[#7A6F82]">Liste des clients sous la responsabilité de <%= advisor.name %></p>
                    </div>

                    <div class="flex items-center gap-3 w-full sm:w-auto">
                        <input 
                            type="text" 
                            id="clientFilterInput"
                            placeholder="Filtrer par nom, CIN, ville..." 
                            class="w-full sm:w-64 bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3 py-1.5 text-xs text-[#282330] placeholder-[#9D937F] focus:outline-none focus:border-[#746B92]"
                            oninput="filterClientTable(this.value)"
                        >
                    </div>
                </div>

                <div id="clientsCardsContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                    <% clients.forEach(cli => { %>
                        <% 
                            const totalBalance = cli.accounts.reduce((acc, a) => acc + a.balance, 0); 
                        %>
                        <div class="bg-[#FAF5ED] border border-[#D8CEBB] hover:border-[#746B92] rounded-2xl p-5 space-y-3.5 client-row shadow-xs transition-all duration-200 flex flex-col justify-between group">
                            <div class="space-y-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-[#EFE7D4] text-[#746B92] font-bold text-sm flex items-center justify-center shrink-0 group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                                        <%= cli.name.charAt(0) %>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-sm text-[#282330] leading-tight"><%= cli.civilite %> <%= cli.name %></h4>
                                        <span class="text-[11px] font-mono text-[#7A6F82]">CIN : <%= cli.cin %> • <%= cli.city %></span>
                                    </div>
                                </div>

                                <div class="bg-white p-3 rounded-xl border border-[#D8CEBB]/80 flex items-baseline justify-between">
                                    <span class="text-[11px] text-[#7A6F82]">Solde Cumulé</span>
                                    <span class="text-base font-bold font-num text-[#746B92]">
                                        <%= totalBalance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> MAD
                                    </span>
                                </div>

                                <div class="text-xs text-[#7A6F82] space-y-0.5">
                                    <div class="truncate text-[11px] text-[#282330]">
                                        <span class="text-[#9D937F]">Email :</span> <%= cli.email %>
                                    </div>
                                    <div class="text-[11px] font-mono text-[#7A6F82]">
                                        <span class="text-[#9D937F] font-sans">Tél :</span> <%= cli.phone %>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-3 border-t border-[#D8CEBB] flex items-center justify-between gap-2">
                                <span class="text-[10px] text-[#9D937F]">Client depuis <%= cli.joinedDate %></span>
                                <div class="flex items-center gap-2">
                                    <a 
                                        href="/advisor/clients/<%= cli.id %>"
                                        class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#FAF5ED] hover:bg-[#746B92] text-[#746B92] hover:text-white border border-[#D8CEBB] shadow-xs transition-all flex items-center gap-1 cursor-pointer"
                                        title="Voir la Fiche 360° complète"
                                    >
                                        <span>Fiche 360°</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                    </a>
                                    <button 
                                        type="button"
                                        onclick='openClientDetailModal(<%= JSON.stringify(cli) %>)'
                                        class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-xs transition-colors flex items-center gap-1 cursor-pointer"
                                    >
                                        <span>Aperçu</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="mt-6 pt-4 border-t border-[#D8CEBB] flex flex-col sm:flex-row items-center justify-between gap-4">
                    <span class="text-xs text-[#7A6F82]">
                        Affichage de <span class="font-semibold text-[#282330]">1</span> à <span class="font-semibold text-[#282330]">6</span> sur <span class="font-semibold text-[#282330]"><%= clients.length %></span> clients
                    </span>

                    <div class="flex items-center gap-1.5 select-none">
