            <button onclick="closeClaimModal()" class="absolute top-4 right-4 text-[#7A6F82] hover:text-[#282330] p-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <h3 class="text-base font-bold text-[#282330]">Traiter la Réclamation</h3>
            <p class="text-xs text-[#7A6F82] mt-0.5" id="modalClaimClient">Client : </p>

            <form action="/advisor/claim/resolve" method="POST" class="mt-4 space-y-4">
                <input type="hidden" name="claimId" id="modalClaimId">

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Objet de la réclamation</label>
                    <input type="text" id="modalClaimObject" readonly class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3 py-2 text-xs text-[#282330] font-medium">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Nouveau statut</label>
                    <select name="newStatus" id="modalClaimStatusSelect" class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3 py-2 text-xs text-[#282330] focus:outline-none focus:border-[#746B92]">
                        <option value="Clôturée">Clôturer la réclamation (Résolue)</option>
                        <option value="En cours">Maintenir en cours d'instruction</option>
                        <option value="Ouverte">Reclasser Ouverte</option>
                    </select>
