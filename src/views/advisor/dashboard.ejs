                        name="advisorComment" 
                        id="modalDemandComment" 
                        rows="3" 
                        placeholder="Ex: Demande validée avec succès. Le document sera disponible dans votre espace sous 24h."
                        class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl p-3 text-xs text-[#282330] placeholder-[#9D937F] focus:outline-none focus:border-[#746B92]"
                    ></textarea>
