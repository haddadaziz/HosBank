                        Annuler
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-sm transition-colors">
                        Enregistrer la décision
                    </button>
                </div>
            </form>
        </div>
