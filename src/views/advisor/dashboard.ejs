<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-num { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-[#F8F9FA] text-[#282330] min-h-screen antialiased">

    <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- 1. Barre latérale unifiée HosBank pour Conseiller -->
        <%- include('../partials/sidebar', { role: 'advisor', currentPath: '/advisor/dashboard', user: advisor, metrics: metrics }) %>

        <!-- 2. Contenu principal du Conseiller -->
        <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 max-w-[1400px] w-full min-w-0 space-y-8">

            <!-- En-tête de bienvenue -->
            <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-[#282330] tracking-tight">
                        Vue d'ensemble
                    </h1>
                    <p class="text-sm text-[#7A6F82] mt-1">
                        Tableau de bord de gestion et supervision du portefeuille de <%= advisor.name %>
                    </p>
                </div>
            </header>

            <!-- Notifications de succès ou d'erreur -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center gap-3 shadow-xs">
                    <span>✅ Action enregistrée avec succès.</span>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center gap-3 shadow-xs">
                    <span>⚠️ <%= error %></span>
                </div>
            <% } %>

            <!-- Grille des 4 indicateurs clés (KPIs) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                
                <!-- Carte 1 : Clients Affectés -->
                <a href="/advisor/clients" class="bg-white border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-xs transition-all duration-200 block group hover:-translate-y-0.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#7A6F82]">Clients Affectés</span>
                        <div class="w-9 h-9 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-3xl font-extrabold font-num text-[#282330]"><%= metrics.assignedClients %></span>
                    </div>
                    <p class="text-[11px] text-[#746B92] font-semibold mt-2 group-hover:underline flex items-center gap-1">
                        <span>Consulter la liste</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </p>
                </a>

                <!-- Carte 2 : Demandes à Traiter -->
                <a href="/advisor/demands" class="bg-white border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-xs transition-all duration-200 block group hover:-translate-y-0.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#7A6F82]">Demandes à Traiter</span>
                        <div class="w-9 h-9 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-3xl font-extrabold font-num text-[#282330]"><%= metrics.pendingDemands %></span>
                    </div>
                    <p class="text-[11px] text-[#746B92] font-semibold mt-2 group-hover:underline flex items-center gap-1">
                        <span>Traiter les demandes</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </p>
                </a>

                <!-- Carte 3 : Oppositions Carte -->
                <a href="/advisor/demands" class="bg-white border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-xs transition-all duration-200 block group hover:-translate-y-0.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#7A6F82]">Oppositions Carte</span>
                        <div class="w-9 h-9 rounded-xl bg-[#FAF0EE] text-[#E97A7A] flex items-center justify-center group-hover:bg-[#E97A7A] group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-3xl font-extrabold font-num text-[#282330]"><%= metrics.cardOppositions %></span>
                    </div>
                    <p class="text-[11px] text-[#E97A7A] font-semibold mt-2 group-hover:underline flex items-center gap-1">
                        <span>Urgences déclarées</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </p>
                </a>

                <!-- Carte 4 : Réclamations en cours -->
                <a href="/advisor/claims" class="bg-white border border-[#D8CEBB] hover:border-[#746B92] p-5 rounded-2xl shadow-xs transition-all duration-200 block group hover:-translate-y-0.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#7A6F82]">Réclamations en cours</span>
                        <div class="w-9 h-9 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center group-hover:bg-[#746B92] group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-3xl font-extrabold font-num text-[#282330]"><%= metrics.openClaims %></span>
                    </div>
                    <p class="text-[11px] text-[#746B92] font-semibold mt-2 group-hover:underline flex items-center gap-1">
                        <span>Répondre aux clients</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </p>
                </a>

            </div>

            <!-- Section 1 : Demandes Clients Récentes en Attente -->
            <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#EFE7D4]">
                    <div>
                        <h2 class="text-base font-bold text-[#282330]">Demandes en attente d'instruction</h2>
                        <p class="text-xs text-[#7A6F82]">Validation requise par le chargé de clientèle</p>
                    </div>
                    <a href="/advisor/demands" class="text-xs font-bold text-[#746B92] hover:underline flex items-center gap-1">
                        <span>Voir toutes les demandes</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>

                <div class="divide-y divide-[#EFE7D4]">
                    <% const pendingList = demands.filter(d => d.status === 'En attente' || d.status === 'En instruction').slice(0, 5); %>
                    <% if (pendingList.length === 0) { %>
                        <div class="py-10 text-center text-xs text-[#9D937F]">
                            Aucune demande en attente actuellement.
                        </div>
                    <% } else { %>
                        <% pendingList.forEach(dem => { %>
                            <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 <%= dem.priority === 'URGENT' ? 'bg-[#FAF0EE] text-[#E97A7A]' : 'bg-[#FAF5ED] text-[#746B92]' %>">
                                        <% if (dem.type === 'Opposition Carte') { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                        <% } else if (dem.type === 'Carte Virtuelle') { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                                        <% } else if (dem.type === 'Compte d\'Épargne') { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <% } else { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        <% } %>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-[#282330]"><%= dem.type %></span>
                                            <% if (dem.priority === 'URGENT') { %>
                                                <span class="px-2 py-0.2 rounded-full text-[9px] font-bold bg-[#E97A7A] text-white">URGENT</span>
                                            <% } %>
                                        </div>
                                        <p class="text-[11px] text-[#7A6F82]">Client : <span class="font-semibold text-[#282330]"><%= dem.clientName %></span> • <%= dem.date %></p>
                                    </div>
                                </div>

                                <button 
                                    type="button"
                                    class="btn-open-demand px-4 py-1.5 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-xs transition-colors self-end sm:self-center cursor-pointer"
                                    data-id="<%= dem.dbId || dem.id %>"
                                    data-type="<%= dem.type %>"
                                    data-client="<%= dem.clientName %>"
                                    data-details="<%= dem.details %>"
                                >
                                    Traiter
                                </button>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Section 2 : Activité Récente du Journal -->
            <div class="bg-white border border-[#D8CEBB] rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#EFE7D4]">
                    <div>
                        <h2 class="text-base font-bold text-[#282330]">Dernières interactions du portefeuille</h2>
                        <p class="text-xs text-[#7A6F82]">Activités récentes et historique d'audit</p>
                    </div>
                    <a href="/advisor/interactions" class="text-xs font-bold text-[#746B92] hover:underline flex items-center gap-1">
                        <span>Voir tout le journal</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>

                <% const recentInteractions = interactions.slice(0, 6); %>
                <% if (recentInteractions.length === 0) { %>
                    <div class="py-12 px-4 text-center bg-[#FAF5ED]/50 rounded-2xl border border-dashed border-[#D8CEBB]">
                        <div class="w-11 h-11 mx-auto mb-2.5 rounded-xl bg-[#FAF5ED] text-[#746B92] flex items-center justify-center border border-[#D8CEBB]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <h3 class="text-xs font-bold text-[#282330]">Aucune interaction enregistrée</h3>
                        <p class="text-[11px] text-[#7A6F82] mt-0.5">Toutes les actions et opérations de vos clients s'afficheront ici en temps réel.</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                        <% recentInteractions.forEach(it => { %>
                            <div class="bg-[#FAF5ED] border border-[#D8CEBB] hover:border-[#746B92] rounded-2xl p-4 space-y-3 transition-all duration-200 shadow-xs flex flex-col justify-between group">
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <div class="w-7 h-7 rounded-lg bg-white border border-[#D8CEBB] text-[#746B92] flex items-center justify-center shrink-0">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            </div>
                                            <span class="text-xs font-bold text-[#282330] line-clamp-1"><%= it.type %></span>
                                        </div>
                                    </div>
                                    <% if (it.client) { %>
                                        <div class="text-[11px] text-[#7A6F82]">Client : <strong class="text-[#282330]"><%= it.client %></strong></div>
                                    <% } %>
                                    <p class="text-xs text-[#282330] bg-white p-2.5 rounded-xl border border-[#D8CEBB]/80 line-clamp-2"><%= it.summary || 'Opération enregistrée' %></p>
                                </div>
                                <div class="pt-2 border-t border-[#D8CEBB]/60 text-[10px] font-mono text-[#9D937F]">
                                    <%= it.date %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

        </main>
    </div>

    <!-- Modale de traitement d'une demande -->
    <div id="demandModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
        <div class="bg-[#FFFFFF] border border-[#D8CEBB] rounded-2xl max-w-lg w-full p-6 shadow-xl relative animate-fade">
            <!-- Bouton pour fermer la modale -->
            <button onclick="closeDemandModal()" class="absolute top-4 right-4 text-[#7A6F82] hover:text-[#282330] p-1 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <!-- Titre et sous-titre de la modale -->
            <h3 class="text-base font-bold text-[#282330]" id="modalDemandTitle">Traiter la demande</h3>
            <p class="text-xs text-[#7A6F82] mt-0.5" id="modalDemandClient">Client : </p>

            <!-- Contenu de la demande -->
            <div class="my-4 p-3.5 bg-[#FAF5ED] rounded-xl border border-[#D8CEBB] text-xs text-[#282330]">
                <span class="font-semibold text-[#746B92]">Objet / Contenu de la demande :</span>
                <p id="modalDemandDetails" class="mt-1 font-normal leading-relaxed"></p>
            </div>

            <!-- Formulaire de validation ou rejet -->
            <form action="/advisor/demand/update" method="POST" class="space-y-4">
                <input type="hidden" name="demandId" id="modalDemandId">

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Statut de la demande</label>
                    <select name="newStatus" id="modalDemandStatus" class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl px-3 py-2 text-xs text-[#282330] focus:outline-none focus:border-[#746B92]">
                        <option value="Validée">Valider la demande (Accepter)</option>
                        <option value="Rejetée">Rejeter la demande (Refuser)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#282330] mb-1.5">Commentaire / Réponse transmise au client</label>
                    <textarea 
                        name="advisorComment" 
                        id="modalDemandComment" 
                        rows="3" 
                        placeholder="Ex: Demande validée avec succès. Les informations ont été mises à jour dans votre espace."
                        class="w-full bg-[#FAF5ED] border border-[#D8CEBB] rounded-xl p-3 text-xs text-[#282330] placeholder-[#9D937F] focus:outline-none focus:border-[#746B92]"
                    ></textarea>
                </div>

                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeDemandModal()" class="px-4 py-2 rounded-xl text-xs font-medium text-[#7A6F82] hover:bg-[#FAF5ED] transition-colors cursor-pointer">
                        Annuler
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-[#746B92] hover:bg-[#635B7E] text-white shadow-sm transition-colors cursor-pointer">
                        Enregistrer la décision
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script simple et clair pour la modale (Style Junior) -->
    <script>
        // 1. Ouvrir la modale et remplir les champs
        function openDemandModal(id, type, clientName, details) {
            document.getElementById('modalDemandId').value = id;
            document.getElementById('modalDemandTitle').textContent = 'Traiter la demande : ' + type;
            document.getElementById('modalDemandClient').textContent = 'Client : ' + clientName;
            document.getElementById('modalDemandDetails').textContent = details || 'Aucun détail fourni';

            const modal = document.getElementById('demandModal');
            if (modal) {
                modal.classList.remove('hidden');
            }
        }

        // 2. Fermer la modale
        function closeDemandModal() {
            const modal = document.getElementById('demandModal');
            if (modal) {
                modal.classList.add('hidden');
            }
        }

        // 3. Attacher l'événement click sur tous les boutons "Traiter"
        document.querySelectorAll('.btn-open-demand').forEach(function(bouton) {
            bouton.addEventListener('click', function() {
                const id = this.dataset.id;
                const type = this.dataset.type;
                const client = this.dataset.client;
                const details = this.dataset.details;
                openDemandModal(id, type, client, details);
            });
        });
    </script>
</body>
</html>
