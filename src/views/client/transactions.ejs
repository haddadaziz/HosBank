<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#F8F9FA]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Style Sidebar -->
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        hos: {
                            dark: '#29223A',
                            hover: '#3C3352',
                            primary: '#746B92',
                            cream: '#F6EFE0',
                            surface: '#FFFFFF',
                            bg: '#F8F9FA'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans text-gray-900 bg-[#F8F9FA] min-h-screen antialiased">

<%
// Helper pour générer l'URL avec les filtres conservés
function buildUrl(targetPage, overrides = {}) {
    const p = new URLSearchParams();
    p.set('page', targetPage);
    const acc = overrides.accountId !== undefined ? overrides.accountId : filters.accountId;
    const dir = overrides.direction !== undefined ? overrides.direction : filters.direction;
    const per = overrides.period !== undefined ? overrides.period : filters.period;
    const s = overrides.search !== undefined ? overrides.search : filters.search;

    if (acc) p.set('accountId', acc);
    if (dir && dir !== 'ALL') p.set('direction', dir);
    if (per && per !== 'all') p.set('period', per);
    if (s) p.set('search', s);
    return '/client/transactions?' + p.toString();
}

// URL d'export CSV
const exportUrl = buildUrl(1) + '&export=csv';
const hasActiveFilters = !!(filters.accountId || (filters.direction && filters.direction !== 'ALL') || (filters.period && filters.period !== 'all') || filters.search);
%>

<div class="flex min-h-screen">
    <!-- Sidebar unifiée multi-rôles -->
    <%- include('../partials/sidebar', { role: 'client', currentPath: '/client/transactions', user: user }) %>

    <!-- Zone principale -->
    <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 pt-20 lg:pt-10 max-w-[1400px] w-full min-w-0">
        
        <!-- En-tête -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <a href="/client/dashboard" class="text-xs text-gray-400 hover:text-hos-primary font-bold transition-colors">← Tableau de bord</a>
                </div>
                <h1 class="text-2xl lg:text-3xl font-extrabold text-hos-dark tracking-tight">
                    Historique des Opérations
                </h1>
                <p class="text-sm text-gray-500 mt-1">Consultez, filtrez et exportez l'ensemble de vos mouvements bancaires avec traçabilité complète.</p>
            </div>
        </header>

        <!-- Cartes récapitulatives de la sélection (Statistiques HOS-28) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Crédits (Entrées)</span>
                    <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">↓</span>
                </div>
                <div class="text-xl font-extrabold text-emerald-600 mt-2">
                    +<%= stats.totalCredits.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                </div>
            </div>

            <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Débits (Sorties)</span>
                    <span class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-xs font-bold">↑</span>
                </div>
                <div class="text-xl font-extrabold text-hos-dark mt-2">
                    -<%= stats.totalDebits.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                </div>
            </div>

        </div>

        <!-- Formulaire de recherche et filtres multicritères (HOS-28) -->
        <form method="GET" action="/client/transactions" class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm mb-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                
                <!-- Recherche textuelle -->
                <div class="md:col-span-4 relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></span>
                    <input 
                        type="text" 
                        name="search" 
                        value="<%= filters.search %>" 
                        placeholder="Rechercher par libellé ou référence..." 
                        class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary outline-none text-xs text-gray-700 transition-colors"
                    >
                </div>

                <!-- Sélecteur de compte -->
                <div class="md:col-span-3">
                    <select name="accountId" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary outline-none text-xs text-gray-700 bg-white cursor-pointer">
                        <option value="">Tous les comptes bancaires</option>
                        <% accounts.forEach(acc => { %>
                            <option value="<%= acc.id %>" <%= String(filters.accountId) === String(acc.id) ? 'selected' : '' %>>
                                <%= acc.accountNumber %> (<%= acc.type %>) - <%= acc.balance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- Sélecteur de période -->
                <div class="md:col-span-2">
                    <select name="period" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary outline-none text-xs text-gray-700 bg-white cursor-pointer">
                        <option value="all" <%= filters.period === 'all' ? 'selected' : '' %>>Toutes les dates</option>
                        <option value="month" <%= filters.period === 'month' ? 'selected' : '' %>>Ce mois-ci</option>
                        <option value="3months" <%= filters.period === '3months' ? 'selected' : '' %>>3 derniers mois</option>
                        <option value="year" <%= filters.period === 'year' ? 'selected' : '' %>>Année 2026</option>
                    </select>
                </div>

                <!-- Sélecteur de sens (Débit / Crédit) -->
                <div class="md:col-span-2">
                    <select name="direction" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary outline-none text-xs text-gray-700 bg-white cursor-pointer">
                        <option value="ALL" <%= (!filters.direction || filters.direction === 'ALL') ? 'selected' : '' %>>Tous flux (±)</option>
                        <option value="CREDIT" <%= filters.direction === 'CREDIT' ? 'selected' : '' %>>Crédits (+)</option>
                        <option value="DEBIT" <%= filters.direction === 'DEBIT' ? 'selected' : '' %>>Débits (-)</option>
                    </select>
                </div>

                <!-- Boutons d'action -->
                <div class="md:col-span-1 flex items-center gap-2">
                    <button type="submit" class="w-full py-2.5 px-3 bg-hos-dark hover:bg-hos-hover text-white text-xs font-bold rounded-xl shadow-sm transition-all text-center">
                        Filtrer
                    </button>
                </div>
            </div>

            <!-- Raccourcis rapides et réinitialisation -->
            <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100 text-xs">
                <div class="flex items-center gap-2 text-gray-500">
                    <span class="font-medium text-[11px] text-gray-400">Filtre rapide flux :</span>
                    <a href="<%= buildUrl(1, { direction: 'ALL' }) %>" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all <%= (!filters.direction || filters.direction === 'ALL') ? 'bg-hos-dark text-white' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>">
                        Toutes (<%= pagination.totalCount %>)
                    </a>
                    <a href="<%= buildUrl(1, { direction: 'CREDIT' }) %>" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all <%= filters.direction === 'CREDIT' ? 'bg-emerald-600 text-white' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>">
                        Crédits (+)
                    </a>
                    <a href="<%= buildUrl(1, { direction: 'DEBIT' }) %>" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all <%= filters.direction === 'DEBIT' ? 'bg-rose-600 text-white' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>">
                        Débits (-)
                    </a>
                </div>

                <% if (hasActiveFilters) { %>
                    <div>
                        <a href="/client/transactions" class="text-rose-600 hover:text-rose-700 font-bold text-[11px] underline">
                            ✕ Réinitialiser les filtres
                        </a>
                    </div>
                <% } %>
            </div>
        </form>

        <!-- Liste des opérations sous forme de cartes (Responsive Mobile & PC) -->
        <div class="space-y-3 mb-6">
            <% if (transactions && transactions.length > 0) { %>
                <% transactions.forEach(tx => { 
                    const isCredit = (tx.direction === 'CREDIT');
                %>
                    <!-- Carte Opération -->
                    <div class="group bg-white hover:bg-gray-50/75 border border-gray-100 hover:border-gray-200/80 rounded-2xl p-4 sm:px-5 sm:py-3.5 shadow-sm hover:shadow-xs transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
                        
                        <!-- Côté Gauche : Icône + Libellé + Date & Référence -->
                        <div class="flex items-center gap-3.5 min-w-0">
                            <!-- Icône Visuelle -->
                            <div class="w-11 h-11 sm:w-10 sm:h-10 rounded-2xl sm:rounded-xl flex items-center justify-center font-bold text-sm shrink-0 shadow-xs transition-transform group-hover:scale-105 <%= isCredit ? 'bg-emerald-50 text-emerald-600 border border-emerald-100/60' : 'bg-rose-50 text-rose-600 border border-rose-100/60' %>">
                                <% if (isCredit) { %>
                                    <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                                    </svg>
                                <% } else { %>
                                    <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                                    </svg>
                                <% } %>
                            </div>

                            <!-- Informations Texte Essentielles -->
                            <div class="min-w-0 flex-1">
                                <div class="font-bold text-sm text-hos-dark truncate group-hover:text-hos-primary transition-colors">
                                    <%= tx.label %>
                                </div>
                                <div class="flex items-center gap-2 text-xs text-gray-400 mt-0.5">
                                    <span class="font-medium"><%= tx.dateFormatted %></span>
                                    <% if (tx.reference) { %>
                                        <span class="text-gray-300">•</span>
                                        <span class="font-mono text-[11px] text-gray-400 truncate max-w-[160px] sm:max-w-none"><%= tx.reference %></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Côté Droit : Badge Statut & Montant -->
                        <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0 pt-2.5 sm:pt-0 border-t border-gray-50 sm:border-0">
                            <!-- Badge Léger (visible sur desktop et mobile) -->
                            <span class="px-2.5 py-1 rounded-lg text-[10px] sm:text-[11px] font-bold tracking-wide uppercase <%= isCredit ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/50' : 'bg-gray-100 text-gray-600 border border-gray-200/60' %>">
                                <%= isCredit ? 'Crédit' : 'Débit' %>
                            </span>

                            <!-- Montant -->
                            <div class="text-right font-extrabold text-base sm:text-base tracking-tight <%= isCredit ? 'text-emerald-600' : 'text-hos-dark' %>">
                                <%= isCredit ? '+' : '-' %><%= tx.amount.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                            </div>
                        </div>

                    </div>
                <% }) %>
            <% } else { %>
                <!-- État vide -->
                <div class="py-16 px-6 text-center bg-white rounded-3xl border border-dashed border-gray-200 shadow-sm">
                    <div class="w-14 h-14 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-3 text-2xl text-gray-400">
                        💸
                    </div>
                    <div class="font-bold text-sm text-hos-dark mb-1">Aucune opération trouvée</div>
                    <p class="text-xs text-gray-500 max-w-sm mx-auto">
                        Aucun mouvement bancaire ne correspond à vos critères de recherche actuels.
                    </p>
                    <% if (hasActiveFilters) { %>
                        <a href="/client/transactions" class="inline-block mt-4 px-4 py-2 bg-hos-dark hover:bg-hos-hover text-white rounded-xl text-xs font-bold transition-all shadow-sm">
                            Effacer tous les filtres
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- Pagination Dynamique (HOS-27) -->
        <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">
            <div>
                <% if (pagination.totalCount > 0) { %>
                    Affichage de <span class="font-bold text-hos-dark"><%= pagination.from %></span> à <span class="font-bold text-hos-dark"><%= pagination.to %></span> sur <span class="font-bold text-hos-dark"><%= pagination.totalCount %></span> opérations
                <% } else { %>
                    0 opération
                <% } %>
            </div>

            <% if (pagination.totalPages > 1) { %>
                <div class="flex items-center gap-1">
                    <!-- Précédent -->
                    <% if (pagination.hasPrev) { %>
                        <a href="<%= buildUrl(pagination.currentPage - 1) %>" class="px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-hos-dark font-medium transition-all">
                            ← Précédent
                        </a>
                    <% } else { %>
                        <span class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-300 cursor-not-allowed">
                            ← Précédent
                        </span>
                    <% } %>

                    <!-- Numéros de page -->
                    <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                        <% if (p === pagination.currentPage) { %>
                            <span class="px-3 py-1.5 rounded-lg bg-hos-dark text-white font-bold">
                                <%= p %>
                            </span>
                        <% } else { %>
                            <a href="<%= buildUrl(p) %>" class="px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-gray-700 font-medium transition-all">
                                <%= p %>
                            </a>
                        <% } %>
                    <% } %>

                    <!-- Suivant -->
                    <% if (pagination.hasNext) { %>
                        <a href="<%= buildUrl(pagination.currentPage + 1) %>" class="px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-hos-dark font-medium transition-all">
                            Suivant →
                        </a>
                    <% } else { %>
                        <span class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-300 cursor-not-allowed">
                            Suivant →
                        </span>
                    <% } %>
                </div>
            <% } %>
        </div>

    </main>
</div>

</body>
</html>
