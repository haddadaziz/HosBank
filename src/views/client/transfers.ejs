<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#FAF9F7]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Style Sidebar -->
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        hos: {
                            dark: '#1E182A',
                            accent: '#282138',
                            hover: '#3E3455',
                            primary: '#685E86',
                            coral: '#E97A7A',
                            surface: '#FFFFFF',
                            bg: '#FAF9F7'
                        }
                    },
                    boxShadow: {
                        'premium': '0 10px 30px -4px rgba(30, 24, 42, 0.06)',
                        'modal': '0 25px 50px -12px rgba(30, 24, 42, 0.25)'
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans text-gray-900 bg-[#FAF9F7] min-h-screen antialiased">

<div class="flex min-h-screen">
    <!-- Sidebar unifiée multi-rôles -->
    <%- include('../partials/sidebar', { role: 'client', currentPath: '/client/transfers', user: user }) %>

    <!-- Zone principale -->
    <main class="flex-1 p-4 sm:p-6 lg:p-10 max-w-[1400px] w-full ml-0 lg:ml-[260px] transition-all">
        
        <!-- En-tête de page -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 text-hos-primary text-xs font-bold tracking-wide uppercase mb-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Espace Virements Bancaires
                </div>
                <h1 class="text-2xl lg:text-3xl font-extrabold text-hos-dark tracking-tight">
                    Virements Bancaires
                </h1>
                <p class="text-sm text-gray-500 mt-0.5">Effectuez des virements et gérez votre liste de bénéficiaires.</p>
            </div>
            
            <button type="button" onclick="openBeneficiaryModal()" 
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-hos-dark hover:bg-hos-hover text-white text-xs font-bold shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                <span>Ajouter un bénéficiaire</span>
            </button>
        </header>

        <!-- Messages Flash / Feedback -->
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <span><%= successMessage %></span>
                </div>
                <a href="/client/transfers" class="text-emerald-700 hover:text-emerald-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } %>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200/80 text-rose-800 text-sm font-semibold flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-7 h-7 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/></svg>
                    </div>
                    <span><%= errorMessage %></span>
                </div>
                <a href="/client/transfers" class="text-rose-700 hover:text-rose-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } %>

        <!-- Grille Principale 2 Colonnes -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Colonne Gauche : Formulaire de Virement (6 colonnes) -->
            <div class="lg:col-span-6 bg-white border border-gray-100 rounded-3xl p-6 sm:p-8 shadow-premium">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-extrabold text-hos-dark">Émettre un virement</h2>
                    <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">✓ SEPA Certifié</span>
                </div>

                <form action="/client/transfers" method="POST" onsubmit="event.preventDefault(); document.getElementById('transferSuccess').classList.remove('hidden');" class="space-y-5">
                    
                    <!-- 1. Compte émetteur -->
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Compte à débiter</label>
                        <% if (typeof accounts !== 'undefined' && accounts && accounts.length > 0) { 
                            const defaultAcc = accounts[0];
                        %>
                            <div class="p-4 rounded-2xl border border-gray-200/80 bg-gradient-to-r from-gray-50 to-purple-50/20 flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-hos-dark text-white flex items-center justify-center font-bold text-sm shadow-sm">
                                        💳
                                    </div>
                                    <div>
                                        <div class="font-extrabold text-sm text-hos-dark"><%= defaultAcc.type === 'COURANT' ? 'Compte Courant Principal' : 'Compte Épargne' %></div>
                                        <div class="font-mono text-xs text-gray-400 mt-0.5"><%= defaultAcc.iban %></div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[11px] font-semibold text-gray-400 uppercase">Solde disponible</div>
                                    <div class="font-extrabold text-base text-hos-dark"><%= defaultAcc.balance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="p-4 rounded-2xl border border-gray-200 bg-gray-50 text-sm text-gray-500">
                                Aucun compte bancaire disponible.
                            </div>
                        <% } %>
                    </div>

                    <!-- 2. Bénéficiaire -->
                    <div>
                        <label for="selectBeneficiary" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Bénéficiaire</label>
                        <div class="relative">
                            <select name="beneficiaryId" id="selectBeneficiary" required 
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-sm font-semibold bg-white cursor-pointer appearance-none transition-all">
                                <% if (typeof beneficiaries !== 'undefined' && beneficiaries && beneficiaries.length > 0) { %>
                                    <% beneficiaries.forEach(b => { %>
                                        <option value="<%= b.id %>"><%= b.intitule %> (<%= b.iban %>)</option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="" disabled selected>Aucun bénéficiaire enregistré</option>
                                <% } %>
                            </select>
                            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Montant -->
                    <div>
                        <label for="inputAmount" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Montant (€)</label>
                        <div class="relative">
                            <input type="number" id="inputAmount" step="0.01" min="0.50" max="15000" placeholder="0,00" required 
                                   class="w-full pl-5 pr-12 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-xl font-extrabold text-hos-dark transition-all">
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-lg font-bold text-gray-400">€</span>
                        </div>
                    </div>

                    <!-- 4. Motif -->
                    <div>
                        <label for="inputMotif" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Motif</label>
                        <input type="text" id="inputMotif" placeholder="Ex: Loyer, Remboursement..." required 
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-sm text-gray-800 transition-all">
                    </div>

                    <!-- Bouton d'action -->
                    <button type="submit" 
                            class="w-full bg-gradient-to-r from-hos-dark to-hos-hover hover:from-[#15111D] hover:to-hos-dark text-white py-3.5 px-6 rounded-2xl font-extrabold text-sm shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer">
                        <span>Valider et envoyer le virement</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>

                    <!-- Feedback de succès simulé -->
                    <div id="transferSuccess" class="hidden mt-4 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium space-y-1">
                        <div class="flex items-center gap-2 font-bold text-sm text-emerald-700">
                            <span>✓ Virement validé avec succès !</span>
                        </div>
                        <p>Les fonds ont été débités et transmis au bénéficiaire.</p>
                    </div>
                </form>
            </div>

            <!-- Colonne Droite : Tableau clair des Bénéficiaires (6 colonnes) -->
            <div class="lg:col-span-6 bg-white border border-gray-100 rounded-3xl p-6 sm:p-8 shadow-premium">
                
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-hos-dark">Liste des bénéficiaires</h2>
                        <p class="text-xs text-gray-400 mt-0.5">Destinataires enregistrés pour vos virements</p>
                    </div>
                    <span class="text-xs bg-purple-50 text-purple-700 font-extrabold px-3 py-1 rounded-full">
                        <%= (typeof beneficiaries !== 'undefined' && beneficiaries) ? beneficiaries.length : 0 %> enregistré<%= (typeof beneficiaries !== 'undefined' && beneficiaries && beneficiaries.length > 1) ? 's' : '' %>
                    </span>
                </div>

                <%
                function maskIban(iban) {
                    if (!iban) return '';
                    const clean = iban.replace(/\s+/g, '');
                    if (clean.length < 10) return iban;
                    const start = clean.slice(0, 4);
                    const end = clean.slice(-4);
                    return start + ' •••• •••• •••• ' + end;
                }
                %>

                <!-- Tableau clair selon Cahier des Charges : Nom, IBAN masqué partiellement, Date d'ajout, Bouton suppression -->
                <div class="overflow-x-auto rounded-2xl border border-gray-100">
                    <% if (typeof beneficiaries !== 'undefined' && beneficiaries && beneficiaries.length > 0) { %>
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50/80 border-b border-gray-100 text-gray-400 font-bold uppercase text-[11px] tracking-wider">
                                    <th class="py-3 px-4">Nom</th>
                                    <th class="py-3 px-4">IBAN masqué</th>
                                    <th class="py-3 px-4">Date d'ajout</th>
                                    <th class="py-3 px-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-xs">
                                <% beneficiaries.forEach(b => { 
                                    const maskedIban = maskIban(b.iban);
                                %>
                                    <tr class="hover:bg-gray-50/60 transition-colors">
                                        <!-- 1. Nom -->
                                        <td class="py-3.5 px-4 font-extrabold text-hos-dark">
                                            <%= b.intitule %>
                                        </td>
                                        
                                        <!-- 2. IBAN masqué partiellement pour la sécurité -->
                                        <td class="py-3.5 px-4">
                                            <span class="font-mono font-semibold text-gray-600 bg-gray-50 px-2 py-1 rounded-md border border-gray-200/60 tracking-wider">
                                                <%= maskedIban %>
                                            </span>
                                        </td>
                                        
                                        <!-- 3. Date d'ajout -->
                                        <td class="py-3.5 px-4 text-gray-500 font-medium">
                                            <%= b.dateAjout || '-' %>
                                        </td>
                                        
                                        <!-- 4. Bouton de suppression -->
                                        <td class="py-3.5 px-4 text-right">
                                            <button type="button" 
                                                    onclick="openDeleteModal('<%= b.id %>', '<%= b.intitule.replace(/'/g, '\\\'') %>', '<%= maskedIban %>')"
                                                    class="text-gray-300 hover:text-rose-600 p-2 rounded-xl hover:bg-rose-50 transition-all cursor-pointer inline-flex items-center justify-center" 
                                                    title="Supprimer ce bénéficiaire">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="text-center py-12 px-4 text-xs text-gray-400">
                            Aucun bénéficiaire enregistré pour le moment.<br>
                            <button type="button" onclick="openBeneficiaryModal()" class="mt-2 text-hos-primary font-bold hover:underline">
                                + Ajouter un bénéficiaire
                            </button>
                        </div>
                    <% } %>
                </div>

            </div>

        </div>

    </main>
</div>

<!-- ==========================================================
     MODAL AJOUT BÉNÉFICIAIRE AVEC VALIDATION STRICTE IBAN
     ========================================================== -->
<div id="addBeneficiaryModal" class="fixed inset-0 bg-[#171320]/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md p-6 sm:p-8 shadow-modal transition-all animate-scale-up">
        
        <div class="flex justify-between items-center mb-1">
            <h3 class="text-lg font-extrabold text-hos-dark">Ajouter un bénéficiaire</h3>
            <button type="button" onclick="closeBeneficiaryModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold p-1 leading-none">&times;</button>
        </div>

        <p class="text-xs text-gray-500 mb-6">
            Saisissez l'intitulé et l'IBAN avec vérification immédiate.
        </p>

        <form id="formAddBeneficiary" action="/client/beneficiaries" method="POST" novalidate>
            <div class="space-y-4">
                
                <!-- 1. Intitulé du compte -->
                <div>
                    <label for="inputIntitule" class="block text-xs font-bold text-hos-dark mb-1">
                        Intitulé du bénéficiaire <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="inputIntitule" name="intitule" placeholder="Ex: Cabinet Médical, Sophie Martin..." required minlength="2" maxlength="100"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-sm font-semibold transition-all">
                    <span id="intituleHelp" class="text-[11px] text-gray-400 mt-1 block">Au moins 2 caractères.</span>
                </div>

                <!-- 2. IBAN avec Validation Immédiate Modulo 97 -->
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label for="inputIban" class="block text-xs font-bold text-hos-dark">
                            IBAN <span class="text-rose-500">*</span>
                        </label>
                        <span id="ibanValidationBadge" class="text-[11px] font-bold text-gray-400">En attente</span>
                    </div>
                    <div class="relative">
                        <input type="text" id="inputIban" name="iban" placeholder="FR76 3000 4012 3456 7890 1234 567" required maxlength="42"
                               class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none font-mono text-sm uppercase tracking-wider transition-all">
                        <div id="ibanCheckIcon" class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/></svg>
                        </div>
                    </div>
                    <div id="ibanHelpText" class="text-[11px] text-gray-400 mt-1">
                        Format SEPA (27 caractères pour la France). Clé Modulo 97 vérifiée en direct.
                    </div>
                </div>
            </div>

            <!-- Boîte d'erreur du formulaire modal -->
            <div id="modalErrorAlert" class="hidden mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold"></div>

            <!-- Actions du Modal -->
            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" onclick="closeBeneficiaryModal()" class="px-4 py-2 text-xs font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                    Annuler
                </button>
                <button type="submit" id="btnSubmitBeneficiary" class="px-5 py-2.5 text-xs font-bold text-white bg-hos-dark hover:bg-hos-hover rounded-xl shadow-md transition-all cursor-pointer">
                    <span>Enregistrer</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================================
     MODAL DE CONFIRMATION DE SÉCURITÉ - SUPPRESSION
     ========================================================== -->
<div id="deleteBeneficiaryModal" class="fixed inset-0 bg-[#171320]/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md p-6 sm:p-8 shadow-modal transition-all animate-scale-up">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
        </div>
        
        <h3 class="text-lg font-extrabold text-hos-dark mb-1">Confirmation de sécurité</h3>
        
        <p class="text-xs text-gray-500 mb-4 leading-relaxed">
            Êtes-vous certain de vouloir supprimer ce bénéficiaire ? Cette opération est irréversible.
        </p>

        <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100 mb-6 space-y-2">
            <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400 font-semibold">Nom :</span>
                <span id="deleteModalBeneficiaryName" class="font-extrabold text-hos-dark"></span>
            </div>
            <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400 font-semibold">IBAN masqué :</span>
                <span id="deleteModalBeneficiaryIban" class="font-mono text-gray-700 font-bold"></span>
            </div>
        </div>

        <form id="deleteBeneficiaryForm" method="POST" action="">
            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2.5 text-xs font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                    Annuler
                </button>
                <button type="submit" class="px-5 py-2.5 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-md transition-all cursor-pointer">
                    <span>Confirmer la suppression</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // ==========================================================
    // Validation IBAN - Algorithme International Modulo 97 (ISO 7064)
    // ==========================================================
    function isValidIban(iban) {
        if (!iban || typeof iban !== 'string') return false;
        const clean = iban.replace(/\s+/g, '').toUpperCase();
        
        // Regex de base SEPA
        const generalRegex = /^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$/;
        if (!generalRegex.test(clean)) return false;

        // Longueur exacte pour la France (27 caractères)
        if (clean.startsWith('FR') && clean.length !== 27) return false;

        // Déplacement des 4 premiers caractères à la fin
        const rearranged = clean.slice(4) + clean.slice(0, 4);

        // Conversion lettres en chiffres (A=10 ... Z=35)
        let numericString = '';
        for (let i = 0; i < rearranged.length; i++) {
            const code = rearranged.charCodeAt(i);
            if (code >= 65 && code <= 90) {
                numericString += (code - 55).toString();
            } else {
                numericString += rearranged[i];
            }
        }

        // Modulo 97 avec BigInt
        try {
            return BigInt(numericString) % 97n === 1n;
        } catch {
            return false;
        }
    }

    // Formatage avec espacement par blocs de 4
    function formatIbanInput(value) {
        const clean = value.replace(/[^A-Za-z0-9]/g, '').toUpperCase();
        return clean.replace(/(.{4})/g, '$1 ').trim();
    }

    // Modal Ajout Bénéficiaire
    function openBeneficiaryModal() {
        document.getElementById('addBeneficiaryModal').classList.remove('hidden');
        document.getElementById('inputIntitule').focus();
    }

    function closeBeneficiaryModal() {
        document.getElementById('addBeneficiaryModal').classList.add('hidden');
        document.getElementById('modalErrorAlert').classList.add('hidden');
    }

    // Modal Suppression Bénéficiaire (Confirmation de sécurité)
    function openDeleteModal(id, name, maskedIban) {
        document.getElementById('deleteBeneficiaryForm').action = '/client/beneficiaries/' + id + '/delete';
        document.getElementById('deleteModalBeneficiaryName').textContent = name;
        document.getElementById('deleteModalBeneficiaryIban').textContent = maskedIban;
        document.getElementById('deleteBeneficiaryModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteBeneficiaryModal').classList.add('hidden');
    }

    // Fermeture avec touche Échap
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeBeneficiaryModal();
            closeDeleteModal();
        }
    });

    // Validation en Temps Réel de l'IBAN & Intitulé
    document.addEventListener('DOMContentLoaded', () => {
        const ibanInput = document.getElementById('inputIban');
        const ibanBadge = document.getElementById('ibanValidationBadge');
        const ibanIcon = document.getElementById('ibanCheckIcon');
        const ibanHelp = document.getElementById('ibanHelpText');
        const intituleInput = document.getElementById('inputIntitule');
        const intituleHelp = document.getElementById('intituleHelp');
        const form = document.getElementById('formAddBeneficiary');
        const errorAlert = document.getElementById('modalErrorAlert');

        ibanInput.addEventListener('input', () => {
            ibanInput.value = formatIbanInput(ibanInput.value);
            const rawVal = ibanInput.value.replace(/\s+/g, '').toUpperCase();

            if (rawVal.length === 0) {
                ibanInput.className = "w-full pl-4 pr-10 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary outline-none font-mono text-sm uppercase tracking-wider transition-all";
                ibanBadge.textContent = "En attente";
                ibanBadge.className = "text-[11px] font-bold text-gray-400";
                ibanIcon.innerHTML = `<svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/></svg>`;
                ibanHelp.textContent = "Format SEPA (27 caractères pour la France). Clé Modulo 97 vérifiée en direct.";
                ibanHelp.className = "text-[11px] text-gray-400 mt-1";
                return;
            }

            const valid = isValidIban(rawVal);

            if (valid) {
                ibanInput.className = "w-full pl-4 pr-10 py-2.5 rounded-xl border-2 border-emerald-500 focus:ring-1 focus:ring-emerald-200 outline-none font-mono text-sm uppercase tracking-wider bg-emerald-50/20 text-emerald-950 font-bold transition-all";
                ibanBadge.textContent = "✓ IBAN Valide";
                ibanBadge.className = "text-[11px] font-bold text-emerald-600";
                ibanIcon.innerHTML = `<svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;
                ibanHelp.textContent = "✓ Clé bancaire Modulo 97 vérifiée et conforme.";
                ibanHelp.className = "text-[11px] text-emerald-600 font-semibold mt-1";
            } else if (rawVal.length >= 8) {
                ibanInput.className = "w-full pl-4 pr-10 py-2.5 rounded-xl border-2 border-rose-400 focus:ring-1 focus:ring-rose-100 outline-none font-mono text-sm uppercase tracking-wider bg-rose-50/20 text-rose-950 transition-all";
                ibanBadge.textContent = "✗ Non conforme";
                ibanBadge.className = "text-[11px] font-bold text-rose-500";
                ibanIcon.innerHTML = `<svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
                ibanHelp.textContent = rawVal.startsWith('FR') && rawVal.length !== 27 
                    ? `Longueur requise pour la France : 27 caractères (${rawVal.length}/27 saisis).` 
                    : "Clé de contrôle ou structure de l'IBAN incorrecte.";
                ibanHelp.className = "text-[11px] text-rose-500 font-semibold mt-1";
            }
        });

        intituleInput.addEventListener('input', () => {
            const val = intituleInput.value.trim();
            if (val.length >= 2) {
                intituleHelp.textContent = "✓ Intitulé valide.";
                intituleHelp.className = "text-[11px] text-emerald-600 font-semibold mt-1 block";
                intituleInput.classList.remove('border-rose-400');
                intituleInput.classList.add('border-emerald-400');
            } else {
                intituleHelp.textContent = "Au moins 2 caractères requis.";
                intituleHelp.className = "text-[11px] text-gray-400 mt-1 block";
                intituleInput.classList.remove('border-emerald-400');
            }
        });

        form.addEventListener('submit', (e) => {
            errorAlert.classList.add('hidden');
            const intitule = intituleInput.value.trim();
            const iban = ibanInput.value.replace(/\s+/g, '').toUpperCase();

            if (intitule.length < 2) {
                e.preventDefault();
                errorAlert.textContent = "L'intitulé du compte doit comporter au moins 2 caractères.";
                errorAlert.classList.remove('hidden');
                intituleInput.focus();
                return;
            }

            if (!isValidIban(iban)) {
                e.preventDefault();
                errorAlert.textContent = "L'IBAN saisi n'est pas conforme à la norme bancaire (erreur de clé Modulo 97).";
                errorAlert.classList.remove('hidden');
                ibanInput.focus();
                return;
            }
        });
    });
</script>
</body>
</html>
