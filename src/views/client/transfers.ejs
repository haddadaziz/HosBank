<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#FAF9F7]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Style Sidebar -->
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        hos: {
                            dark: '#1E182A',
                            accent: '#282138',
                            hover: '#3E3455',
                            primary: '#685E86',
                            coral: '#E97A7A',
                            surface: '#FFFFFF',
                            bg: '#FAF9F7'
                        }
                    },
                    boxShadow: {
                        'premium': '0 10px 30px -4px rgba(30, 24, 42, 0.06)',
                        'modal': '0 25px 50px -12px rgba(30, 24, 42, 0.25)'
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans text-gray-900 bg-[#FAF9F7] min-h-screen antialiased">

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Sidebar unifiée multi-rôles -->
    <%- include('../partials/sidebar', { role: 'client', currentPath: '/client/transfers', user: user }) %>

    <!-- Zone principale -->
    <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 max-w-[1400px] w-full min-w-0 transition-all">
                <!-- Feedback et Notifications -->
        <% if (success === 'transfer_completed') { %>
            <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold flex items-center justify-between shadow-sm animate-fade-in">
                <div class="flex items-center gap-3">
                    <span class="text-xl">✅</span>
                    <div>
                        <span class="block text-emerald-900">Virement de <%= amount ? Number(amount).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) : '' %> € exécuté avec succès !</span>
                        <span class="text-xs font-normal text-emerald-700">
                            Destinataire : <strong><%= dest %></strong> &bull; Référence SEPA : <strong class="font-mono"><%= ref %></strong>. Les fonds ont été débités en temps réel.
                        </span>
                    </div>
                </div>
                <a href="/client/transfers" class="text-emerald-700 hover:text-emerald-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } else if ((typeof successMessage !== 'undefined' && successMessage && successMessage.includes("supprimé")) || (typeof req !== 'undefined' && req.query && req.query.deleted)) { %>
            <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold flex items-center justify-between shadow-sm animate-fade-in">
                <div class="flex items-center gap-3">
                    <span class="text-xl">🗑️</span>
                    <div>
                        <span class="block text-emerald-900">Bénéficiaire supprimé avec succès !</span>
                        <span class="text-xs font-normal text-emerald-700">Le destinataire a bien été supprimé définitivement de votre carnet.</span>
                    </div>
                </div>
                <a href="/client/transfers" class="text-emerald-700 hover:text-emerald-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } else if (success === 'beneficiary_added' || success === '1' || (typeof successMessage !== 'undefined' && successMessage)) { %>
            <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold flex items-center justify-between shadow-sm animate-fade-in">
                <div class="flex items-center gap-3">
                    <span class="text-xl">✨</span>
                    <div>
                        <span class="block text-emerald-900"><%= successMessage || "Opération réussie !" %></span>
                        <span class="text-xs font-normal text-emerald-700">Vous pouvez désormais émettre des virements immédiats vers ce compte.</span>
                    </div>
                </div>
                <a href="/client/transfers" class="text-emerald-700 hover:text-emerald-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } else if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold flex items-center justify-between shadow-sm animate-fade-in">
                <div class="flex items-center gap-3">
                    <span class="text-xl">⚠️</span>
                    <span><%= errorMessage %></span>
                </div>
                <a href="/client/transfers" class="text-rose-700 hover:text-rose-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } else if (typeof error !== 'undefined' && error) { %>
            <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold flex items-center justify-between shadow-sm animate-fade-in">
                <div class="flex items-center gap-3">
                    <span class="text-xl">⚠️</span>
                    <span><%= error %></span>
                </div>
                <a href="/client/transfers" class="text-rose-700 hover:text-rose-900 text-lg font-bold p-1 leading-none">&times;</a>
            </div>
        <% } %>

        <!-- En-tête -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 text-hos-primary text-xs font-bold tracking-wide uppercase mb-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Espace Virements Bancaires
                </div>
                <h1 class="text-2xl lg:text-3xl font-extrabold text-hos-dark tracking-tight">
                    Virements & Bénéficiaires
                </h1>
                <p class="text-sm text-gray-500 mt-0.5">Effectuez des virements et gérez votre liste de bénéficiaires.</p>
            </div>
            
            <button type="button" onclick="openBeneficiaryModal()" 
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-hos-dark hover:bg-hos-hover text-white text-xs font-bold shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                <span>Ajouter un bénéficiaire</span>
            </button>
        </header>

        <!-- Grille Principale 2 Colonnes -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Colonne Gauche : Formulaire de Virement (6 colonnes) -->
            <div class="lg:col-span-6 bg-white border border-gray-100 rounded-3xl p-6 sm:p-8 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-extrabold text-hos-dark">Émettre un virement</h2>
                    <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">✓ SEPA Certifié</span>
                </div>

                <form action="/client/transfers" method="POST" class="space-y-5">
                    
                    <!-- 1. Compte émetteur (Dynamique) -->
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Compte émetteur</label>
                        <% if (typeof accounts !== 'undefined' && accounts && accounts.length > 0) { %>
                            <select name="sourceAccountId" id="sourceAccountSelect" onchange="updateSourceAccountDisplay()" required 
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-1 focus:ring-hos-primary outline-none text-sm font-semibold bg-white mb-2.5">
                                <% accounts.forEach((acc, idx) => { %>
                                    <option value="<%= acc.id %>" 
                                            data-balance="<%= acc.balance %>" 
                                            data-overdraft="<%= acc.overdraft || 0 %>"
                                            data-iban="<%= acc.iban %>"
                                            data-number="<%= (acc.accountNumber || '').replace(/^CPT-/, '') %>"
                                            data-type="<%= acc.type === 'COURANT' ? 'Compte Courant Principal' : 'Compte Épargne' %>"
                                            <%= idx === 0 ? 'selected' : '' %>>
                                        <%= acc.type === 'COURANT' ? 'Compte Courant' : 'Compte Épargne' %> (<%= (acc.accountNumber || '').replace(/^CPT-/, '') %>) - Solde : <%= acc.balance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                                    </option>
                                <% }) %>
                            </select>

                            <!-- Badge récapitulatif du compte sélectionné -->
                            <div class="p-4 rounded-2xl border border-gray-200/80 bg-gray-50/60 flex items-center justify-between">
                                <div>
                                    <div id="displayAccountType" class="font-bold text-sm text-hos-dark">
                                        <%= accounts[0].type === 'COURANT' ? 'Compte Courant Principal' : 'Compte Épargne' %>
                                    </div>
                                    <div id="displayAccountIban" class="font-mono text-xs text-gray-400 mt-0.5">
                                        <%= accounts[0].iban %>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[11px] font-semibold text-gray-400 uppercase">Solde disponible</div>
                                    <div id="displayAccountBalance" class="font-extrabold text-sm text-hos-dark">
                                        <%= accounts[0].balance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="p-4 rounded-2xl bg-rose-50 text-rose-700 text-xs font-semibold">
                                Aucun compte actif trouvé pour émettre des virements.
                            </div>
                        <% } %>
                    </div>

                    <!-- 2. Bénéficiaire -->
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Bénéficiaire destinataire</label>
                            <button type="button" onclick="openBeneficiaryModal()" class="text-xs font-bold text-hos-primary hover:underline flex items-center gap-1">
                                <span>+</span> Nouveau bénéficiaire
                            </button>
                        </div>
                        
                        <select name="beneficiaryId" id="selectBeneficiary" required 
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-1 focus:ring-hos-primary outline-none text-sm font-semibold bg-white">
                            <% if (typeof beneficiaries !== 'undefined' && beneficiaries && beneficiaries.length > 0) { %>
                                <option value="">-- Sélectionnez un bénéficiaire --</option>
                                <% beneficiaries.forEach(b => { %>
                                    <option value="<%= b.id %>">
                                        <%= b.intitule %> (<%= b.iban %>)
                                    </option>
                                <% }) %>
                            <% } else { %>
                                <option value="" disabled selected>Aucun bénéficiaire enregistré. Cliquez sur "+ Nouveau bénéficiaire".</option>
                            <% } %>
                        </select>
                    </div>

                    <!-- 3. Montant -->
                    <div>
                        <label for="transferAmount" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Montant du virement (€)</label>
                        <div class="relative">
                            <input type="number" name="amount" id="transferAmount" step="0.01" min="0.50" max="5000" placeholder="0,00" required 
                                   class="w-full pl-5 pr-12 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-xl font-extrabold text-hos-dark transition-all">
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-lg font-bold text-gray-400">€</span>
                        </div>
                        <div class="flex items-center justify-between text-[11px] text-gray-400 mt-1">
                            <span>Plafond instantané autorisé : 5 000,00 € par opération.</span>
                        </div>
                    </div>

                    <!-- 4. Motif -->
                    <div>
                        <label for="inputMotif" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Motif (libellé sur le relevé)</label>
                        <input type="text" name="motif" id="inputMotif" placeholder="Ex: Remboursement repas, Facture électricité..." required 
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-sm text-gray-800 transition-all">
                    </div>

                    <!-- Récapitulatif -->
                    <div class="p-4 rounded-xl bg-gray-50 border border-gray-100 text-xs text-gray-600 space-y-2">
                        <div class="flex justify-between">
                            <span>Type de virement</span>
                            <span class="font-bold text-hos-dark">SEPA Instantané</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Frais de transfert</span>
                            <span class="font-bold text-emerald-600">Gratuit (0,00 €)</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Délai d'exécution</span>
                            <span class="font-bold text-hos-dark">Instantané</span>
                        </div>
                    </div>

                    <!-- Bouton d'action -->
                    <button type="submit" 
                            class="w-full bg-hos-dark hover:bg-hos-hover text-white py-3.5 px-6 rounded-2xl font-extrabold text-sm shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer">
                        <span>Valider et envoyer le virement</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                </form>
            </div>

            <!-- Colonne Droite : Tableau clair des Bénéficiaires (6 colonnes) -->
            <div class="lg:col-span-6 bg-white border border-gray-100 rounded-3xl p-6 sm:p-8 shadow-sm">
                
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-hos-dark">Liste des bénéficiaires</h2>
                        <p class="text-xs text-gray-400 mt-0.5">Destinataires enregistrés pour vos virements</p>
                    </div>
                    <span class="text-xs bg-purple-50 text-purple-700 font-extrabold px-3 py-1 rounded-full">
                        <%= (typeof beneficiaries !== 'undefined' && beneficiaries) ? beneficiaries.length : 0 %> actif<%= (typeof beneficiaries !== 'undefined' && beneficiaries && beneficiaries.length > 1) ? 's' : '' %>
                    </span>
                </div>

                <%
                function maskIban(iban) {
                    if (!iban) return '';
                    const clean = iban.replace(/\s+/g, '');
                    if (clean.length < 10) return iban;
                    const start = clean.slice(0, 4);
                    const end = clean.slice(-4);
                    return start + ' •••• •••• •••• ' + end;
                }
                %>

                <!-- Tableau clair selon Cahier des Charges : Nom, IBAN masqué partiellement, Date d'ajout, Bouton suppression -->
                <div class="overflow-x-auto rounded-2xl border border-gray-100">
                    <% if (typeof beneficiaries !== 'undefined' && beneficiaries && beneficiaries.length > 0) { %>
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50/80 border-b border-gray-100 text-gray-400 font-bold uppercase text-[11px] tracking-wider">
                                    <th class="py-3 px-4">Nom</th>
                                    <th class="py-3 px-4">IBAN masqué</th>
                                    <th class="py-3 px-4">Date d'ajout</th>
                                    <th class="py-3 px-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-xs">
                                <% beneficiaries.forEach(b => { 
                                    const maskedIban = maskIban(b.iban);
                                %>
                                    <tr class="hover:bg-gray-50/60 transition-colors">
                                        <!-- 1. Nom -->
                                        <td class="py-3.5 px-4 font-extrabold text-hos-dark">
                                            <%= b.intitule %>
                                        </td>
                                        
                                        <!-- 2. IBAN masqué partiellement pour la sécurité -->
                                        <td class="py-3.5 px-4">
                                            <span class="font-mono font-semibold text-gray-600 bg-gray-50 px-2 py-1 rounded-md border border-gray-200/60 tracking-wider">
                                                <%= maskedIban %>
                                            </span>
                                        </td>
                                        
                                        <!-- 3. Date d'ajout -->
                                        <td class="py-3.5 px-4 text-gray-500 font-medium">
                                            <%= b.dateAjout || '-' %>
                                        </td>
                                        
                                        <!-- 4. Bouton de suppression avec modal de confirmation -->
                                        <td class="py-3.5 px-4 text-right">
                                            <button type="button" 
                                                    onclick="openDeleteModal('<%= b.id %>', '<%= b.intitule.replace(/'/g, '\\\'') %>', '<%= maskedIban %>')"
                                                    class="text-gray-300 hover:text-rose-600 p-2 rounded-xl hover:bg-rose-50 transition-all cursor-pointer inline-flex items-center justify-center" 
                                                    title="Supprimer ce bénéficiaire">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="text-center py-12 px-4 text-xs text-gray-400">
                            Aucun bénéficiaire enregistré pour le moment.<br>
                            <button type="button" onclick="openBeneficiaryModal()" class="mt-2 text-hos-primary font-bold hover:underline">
                                + Ajouter un bénéficiaire
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>

    </main>
</div>

<!-- ==========================================================
     MODAL AJOUT BÉNÉFICIAIRE AVEC VALIDATION STRICTE IBAN
     ========================================================== -->
<div id="addBeneficiaryModal" class="fixed inset-0 bg-[#171320]/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md p-6 lg:p-8 shadow-2xl animate-[fadeIn_0.2s_ease-out]">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-extrabold text-hos-dark">Ajouter un bénéficiaire</h3>
            <button type="button" onclick="closeBeneficiaryModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold p-1 leading-none transition-colors cursor-pointer">&times;</button>
        </div>

        <p class="text-xs text-gray-500 mb-6 leading-relaxed">
            Renseignez les coordonnées bancaires SEPA du destinataire pour vos futurs virements en toute sécurité.
        </p>

        <form id="formAddBeneficiary" action="/client/beneficiaries" method="POST" novalidate>
            <div class="space-y-4">
                
                <!-- 1. Intitulé du compte -->
                <div>
                    <label for="inputIntitule" class="block text-xs font-bold text-hos-dark mb-1">
                        Intitulé du bénéficiaire <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="inputIntitule" name="intitule" placeholder="Ex: Cabinet Médical, Sophie Martin..." required minlength="2" maxlength="100"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none text-sm font-semibold transition-all">
                    <span id="intituleHelp" class="text-[11px] text-gray-400 mt-1 block">Au moins 2 caractères requis.</span>
                </div>

                <!-- 2. IBAN avec Validation Immédiate Modulo 97 -->
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label for="inputIban" class="block text-xs font-bold text-hos-dark">
                            IBAN <span class="text-rose-500">*</span>
                        </label>
                        <span id="ibanValidationBadge" class="text-[11px] font-bold text-gray-400">En attente</span>
                    </div>
                    <div class="relative">
                        <input type="text" id="inputIban" name="iban" placeholder="FR76 3000 4012 3456 7890 1234 567" required maxlength="42"
                               class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none font-mono text-sm uppercase tracking-wider transition-all">
                        <div id="ibanCheckIcon" class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/></svg>
                        </div>
                    </div>
                    <div id="ibanHelpText" class="text-[11px] text-gray-400 mt-1">
                        Format SEPA (27 caractères pour la France). Clé Modulo 97 vérifiée en direct.
                    </div>
                </div>

                <!-- 3. BIC optionnel -->
                <div>
                    <label for="inputBic" class="block text-xs font-bold text-hos-dark mb-1">Code BIC / SWIFT (optionnel)</label>
                    <input type="text" id="inputBic" name="bic" placeholder="HOSBFR2P" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/10 outline-none font-mono text-sm uppercase transition-all">
                </div>
            </div>

            <!-- Boîte d'erreur du formulaire modal -->
            <div id="modalErrorAlert" class="hidden mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold"></div>

            <!-- Actions du Modal -->
            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" onclick="closeBeneficiaryModal()" class="px-4 py-2 text-xs font-bold text-gray-600 hover:bg-gray-100 active:scale-95 rounded-xl transition-all cursor-pointer">
                    Annuler
                </button>
                <button type="submit" id="btnSubmitBeneficiary" class="px-5 py-2.5 text-xs font-bold text-white bg-hos-dark hover:bg-hos-hover active:scale-95 rounded-xl shadow-md transition-all cursor-pointer">
                    <span>Enregistrer</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================================
     MODAL DE CONFIRMATION DE SÉCURITÉ - SUPPRESSION
     ========================================================== -->
<div id="deleteBeneficiaryModal" class="fixed inset-0 bg-[#171320]/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md p-6 sm:p-8 shadow-modal transition-all animate-scale-up">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
        </div>
        
        <h3 class="text-lg font-extrabold text-hos-dark mb-1">Confirmation de sécurité</h3>
        
        <p class="text-xs text-gray-500 mb-4 leading-relaxed">
            Êtes-vous certain de vouloir supprimer ce bénéficiaire ? Cette opération est irréversible.
        </p>

        <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100 mb-6 space-y-2">
            <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400 font-semibold">Nom :</span>
                <span id="deleteModalBeneficiaryName" class="font-extrabold text-hos-dark"></span>
            </div>
            <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400 font-semibold">IBAN masqué :</span>
                <span id="deleteModalBeneficiaryIban" class="font-mono text-gray-700 font-bold"></span>
            </div>
        </div>

        <form id="deleteBeneficiaryForm" method="POST" action="">
            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2.5 text-xs font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                    Annuler
                </button>
                <button type="submit" class="px-5 py-2.5 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-md transition-all cursor-pointer">
                    <span>Confirmer la suppression</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // ==========================================================
    // Script Développeur Junior : Gestion des Modales et Formulaires
    // ==========================================================

    // 1. Fonction simple de vérification de l'IBAN
    function isValidIban(iban) {
        if (!iban) return false;
        // On enlève les espaces et on met tout en majuscules
        const clean = iban.replace(/\s+/g, '').toUpperCase();

        // En France, un IBAN commence par 'FR' et fait 27 caractères
        if (clean.startsWith('FR')) {
            return clean.length === 27;
        }

        // Pour les autres pays SEPA, entre 15 et 34 caractères
        return clean.length >= 15 && clean.length <= 34;
    }

    // 2. Formater l'IBAN avec des espaces tous les 4 caractères
    function formatIbanInput(value) {
        const clean = value.replace(/[^A-Za-z0-9]/g, '').toUpperCase();
        return clean.replace(/(.{4})/g, '$1 ').trim();
    }

    // 3. Fonctions pour ouvrir et fermer la modale d'ajout
    function openBeneficiaryModal() {
        const modal = document.getElementById('addBeneficiaryModal');
        if (modal) {
            modal.classList.remove('hidden');
            const input = document.getElementById('inputIntitule');
            if (input) input.focus();
        }
    }

    function closeBeneficiaryModal() {
        const modal = document.getElementById('addBeneficiaryModal');
        const alertBox = document.getElementById('modalErrorAlert');
        if (modal) modal.classList.add('hidden');
        if (alertBox) alertBox.classList.add('hidden');
    }

    // 4. Fonctions pour ouvrir et fermer la modale de suppression
    function openDeleteModal(id, name, maskedIban) {
        const form = document.getElementById('deleteBeneficiaryForm');
        const nameEl = document.getElementById('deleteModalBeneficiaryName');
        const ibanEl = document.getElementById('deleteModalBeneficiaryIban');
        const modal = document.getElementById('deleteBeneficiaryModal');

        if (form) form.action = '/client/beneficiaries/' + id + '/delete';
        if (nameEl) nameEl.textContent = name;
        if (ibanEl) ibanEl.textContent = maskedIban;
        if (modal) modal.classList.remove('hidden');
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteBeneficiaryModal');
        if (modal) modal.classList.add('hidden');
    }

    // 5. Fermeture pratique avec la touche Échap
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeBeneficiaryModal();
            closeDeleteModal();
        }
    });

    // 6. Mise à jour de l'affichage du compte source sélectionné pour le virement
    function updateSourceAccountDisplay() {
        const select = document.getElementById('sourceAccountSelect');
        if (!select) return;

        const opt = select.options[select.selectedIndex];
        if (!opt) return;

        const type = opt.getAttribute('data-type');
        const iban = opt.getAttribute('data-iban');
        const balance = parseFloat(opt.getAttribute('data-balance') || 0);

        const typeEl = document.getElementById('displayAccountType');
        const ibanEl = document.getElementById('displayAccountIban');
        const balanceEl = document.getElementById('displayAccountBalance');

        if (typeEl) typeEl.textContent = type;
        if (ibanEl) ibanEl.textContent = iban;
        if (balanceEl) balanceEl.textContent = balance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' €';
    }

    // 7. Vérification des champs lors de la saisie
    document.addEventListener('DOMContentLoaded', function() {
        const ibanInput = document.getElementById('inputIban');
        const ibanBadge = document.getElementById('ibanValidationBadge');
        const ibanIcon = document.getElementById('ibanCheckIcon');
        const ibanHelp = document.getElementById('ibanHelpText');
        const intituleInput = document.getElementById('inputIntitule');
        const intituleHelp = document.getElementById('intituleHelp');
        const form = document.getElementById('formAddBeneficiary');
        const errorAlert = document.getElementById('modalErrorAlert');

        if (ibanInput && ibanBadge) {
            ibanInput.addEventListener('input', function() {
                ibanInput.value = formatIbanInput(ibanInput.value);
                const val = ibanInput.value.replace(/\s+/g, '').toUpperCase();

                if (val.length === 0) {
                    ibanBadge.textContent = "En attente";
                    ibanBadge.className = "text-[11px] font-bold text-gray-400";
                    return;
                }

                if (isValidIban(val)) {
                    ibanBadge.textContent = "✓ IBAN Valide";
                    ibanBadge.className = "text-[11px] font-bold text-emerald-600";
                    if (ibanHelp) ibanHelp.textContent = "✓ Format d'IBAN correct.";
                } else {
                    ibanBadge.textContent = "✗ Non conforme";
                    ibanBadge.className = "text-[11px] font-bold text-rose-500";
                    if (ibanHelp) ibanHelp.textContent = "Longueur attendue pour la France : 27 caractères (" + val.length + "/27 saisis).";
                }
            });
        }

        if (intituleInput && intituleHelp) {
            intituleInput.addEventListener('input', function() {
                const text = intituleInput.value.trim();
                if (text.length >= 2) {
                    intituleHelp.textContent = "✓ Intitulé valide.";
                    intituleHelp.className = "text-[11px] text-emerald-600 font-semibold mt-1 block";
                } else {
                    intituleHelp.textContent = "Au moins 2 caractères requis.";
                    intituleHelp.className = "text-[11px] text-gray-400 mt-1 block";
                }
            });
        }

        if (form && errorAlert) {
            form.addEventListener('submit', function(event) {
                errorAlert.classList.add('hidden');
                const intitule = intituleInput ? intituleInput.value.trim() : '';
                const iban = ibanInput ? ibanInput.value.replace(/\s+/g, '').toUpperCase() : '';

                if (intitule.length < 2) {
                    event.preventDefault();
                    errorAlert.textContent = "L'intitulé du compte doit comporter au moins 2 caractères.";
                    errorAlert.classList.remove('hidden');
                    return;
                }

                if (!isValidIban(iban)) {
                    event.preventDefault();
                    errorAlert.textContent = "L'IBAN saisi n'est pas conforme (27 caractères requis pour un compte français).";
                    errorAlert.classList.remove('hidden');
                    return;
                }
            });
        }
    });
</script>
</body>
</html>
