<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#F8F9FA]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    },
                    colors: {
                        hos: {
                            dark: '#29223A',
                            hover: '#3C3352',
                            primary: '#746B92',
                            cream: '#F6EFE0',
                            surface: '#FFFFFF',
                            bg: '#F8F9FA'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans text-gray-900 bg-[#F8F9FA] min-h-screen antialiased">

<div class="flex min-h-screen">
    <!-- Sidebar unifiée HosBank -->
    <%- include('../partials/sidebar', { role: 'client', currentPath: '/client/dashboard', user: user }) %>

    <!-- Zone principale -->
    <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 pt-20 lg:pt-10 max-w-[1400px] w-full min-w-0">
        
        <!-- En-tête avec Fil d'Ariane -->
        <header class="mb-8">
            <div class="flex items-center gap-2 mb-2">
                <a href="/client/dashboard" class="text-xs text-gray-400 hover:text-hos-primary font-bold flex items-center gap-1 transition-colors">
                    ← Tableau de bord
                </a>
                <span class="text-xs text-gray-300">/</span>
                <span class="text-xs text-gray-500 font-medium">Détails du compte</span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-2xl <%= account.type === 'COURANT' ? 'bg-hos-dark text-white' : 'bg-emerald-600 text-white' %> flex items-center justify-center font-bold text-xl shadow-sm">
                        <%= account.type === 'COURANT' ? '💳' : '✨' %>
                    </div>
                    <div>
                        <div class="flex items-center gap-2.5">
                            <h1 class="text-2xl lg:text-3xl font-extrabold text-hos-dark tracking-tight">
                                <%= account.type === 'COURANT' ? 'Compte Courant' : "Livret d'Épargne" %>
                            </h1>
                            <span class="text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full border <%= account.status === 'ACTIF' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-gray-100 text-gray-600' %>">
                                <%= account.status %>
                            </span>
                        </div>
                        <div class="text-xs text-gray-400 font-mono mt-0.5 flex items-center gap-2">
                            <span>N° : <%= (account.accountNumber || '').replace(/^CPT-/, '') %></span>
                            <span>•</span>
                            <span>Ouvert le <%= account.openingDate || '16/09/2026' %></span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5 flex-wrap">
                    <a href="/client/transfers" class="inline-flex items-center gap-2 bg-hos-dark hover:bg-hos-hover text-white px-4 py-2.5 rounded-xl text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5">
                        <span>↗</span> Faire un virement
                    </a>
                    <a href="/client/documents?accountId=<%= account.id %>" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-hos-dark border border-gray-200 hover:border-hos-primary px-4 py-2.5 rounded-xl text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5">
                        <span>📄</span> Éditer RIB
                    </a>
                    <a href="/client/documents/rib/print?accountId=<%= account.id %>" target="_blank" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-hos-dark border border-gray-200 hover:border-hos-primary px-3.5 py-2.5 rounded-xl text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5" title="Imprimer ou enregistrer en PDF">
                        <span>🖨️</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- Hero Carte Solde & Caractéristiques du Compte -->
        <div class="bg-white border border-gray-100 rounded-3xl p-6 lg:p-8 shadow-sm mb-8 relative overflow-hidden">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div>
                    <span class="text-xs uppercase tracking-wider text-gray-400 font-bold block mb-1">
                        Solde disponible en temps réel
                    </span>
                    <div class="text-4xl lg:text-5xl font-extrabold text-hos-dark tracking-tight flex items-baseline">
                        <%= Number(account.balance).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        <span class="text-2xl font-bold text-hos-primary ml-1.5">€</span>
                    </div>

                    <div class="flex items-center gap-4 mt-3 text-xs text-gray-500">
                        <% if (account.type === 'EPARGNE') { %>
                            <span class="inline-flex items-center gap-1.5 font-medium">
                                <span>📈</span> Taux d'intérêt annuel : <strong class="text-emerald-700"><%= (account.interestRate || 3).toFixed(2) %>% brut</strong>
                            </span>
                            <span>•</span>
                        <% } %>
                        <span>•</span>
                        <span>Devise : <strong><%= account.currency %> (Euro)</strong></span>
                    </div>
                </div>

                <!-- IBAN direct avec copie en 1 clic -->
                <div class="bg-gray-50/80 p-4 rounded-2xl border border-gray-200/80 max-w-md w-full">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block mb-1">
                        Identifiant IBAN du compte
                    </span>
                    <div class="font-mono text-sm font-extrabold text-hos-dark flex items-center justify-between gap-2">
                        <span class="truncate"><%= account.formattedIban %></span>
                        <button type="button" onclick="navigator.clipboard.writeText('<%= account.cleanIban %>'); alert('IBAN copié !');" class="text-xs text-hos-primary hover:underline font-sans font-bold bg-white px-2.5 py-1 rounded-lg border border-gray-200 hover:border-hos-primary transition-all shrink-0">
                            Copier
                        </button>
                    </div>
                    <div class="text-[10px] text-gray-400 mt-2 flex items-center justify-between pt-2 border-t border-gray-200/60 font-mono">
                        <span>BIC : <strong class="text-gray-600"><%= account.bic %></strong></span>
                        <span>Code Banque : <strong class="text-gray-600">30004</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3 Cartes de Statistiques Mensuelles (HOS-19) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Entrées ce mois</span>
                    <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">↓</span>
                </div>
                <div class="text-2xl font-extrabold text-emerald-600 mt-2">
                    +<%= stats.monthCredits.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                </div>
                <span class="text-[11px] text-gray-400 mt-1 block">Flux créditeurs enregistrés</span>
            </div>

            <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Dépenses ce mois</span>
                    <span class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-sm">↑</span>
                </div>
                <div class="text-2xl font-extrabold text-hos-dark mt-2">
                    -<%= stats.monthDebits.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                </div>
                <span class="text-[11px] text-gray-400 mt-1 block">Débits et virements émis</span>
            </div>

            <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Mouvements ce mois</span>
                    <span class="w-8 h-8 rounded-xl bg-purple-50 text-hos-primary flex items-center justify-center font-bold text-sm">#</span>
                </div>
                <div class="text-2xl font-extrabold text-hos-dark mt-2">
                    <%= stats.totalOperationsCount %> écriture<%= stats.totalOperationsCount > 1 ? 's' : '' %>
                </div>
                <span class="text-[11px] text-gray-400 mt-1 block">Sur la période en cours</span>
            </div>
        </div>

        <!-- Grille 2 Colonnes : Opérations & Moyens de Paiement (HOS-19) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
            
            <!-- Colonne Gauche : Opérations récentes du compte (8 colonnes) -->
            <div class="lg:col-span-8">
                <div class="bg-white border border-gray-100 rounded-3xl p-6 lg:p-8 shadow-sm">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-lg font-bold text-hos-dark">Opérations du compte</h2>
                            <p class="text-xs text-gray-400 mt-0.5">Derniers mouvements enregistrés sur ce compte</p>
                        </div>
                        <a href="/client/transactions?accountId=<%= account.id %>" class="text-xs font-bold text-hos-primary hover:underline flex items-center gap-1">
                            Historique filtré complet →
                        </a>
                    </div>

                    <div class="divide-y divide-gray-100">
                        <% if (recentOperations && recentOperations.length > 0) { %>
                            <% recentOperations.forEach(op => { %>
                                <div class="flex items-center justify-between py-4 hover:bg-gray-50/70 rounded-xl px-2 transition-colors">
                                    <div class="flex items-center gap-3.5">
                                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0 <%= op.direction === 'CREDIT' ? 'bg-emerald-100 text-emerald-600' : 'bg-gray-100 text-gray-700' %>">
                                            <%= op.direction === 'CREDIT' ? '↓' : '↑' %>
                                        </div>
                                        <div>
                                            <div class="font-bold text-sm text-hos-dark"><%= op.label %></div>
                                            <div class="text-xs text-gray-400 mt-0.5">
                                                <%= op.dateFormatted %> • <span class="font-medium text-gray-600"><%= op.category || 'Opération' %></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div class="font-extrabold text-sm sm:text-base <%= op.direction === 'CREDIT' ? 'text-emerald-600' : 'text-hos-dark' %>">
                                            <%= op.direction === 'CREDIT' ? '+' : '-' %><%= Number(op.amount).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                                        </div>
                                        <div class="text-[11px] font-mono text-gray-400 mt-0.5">
                                            Solde : <%= Number(op.balanceAfter).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="py-12 text-center text-gray-400 text-xs">
                                Aucune opération enregistrée sur ce compte bancaire.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Colonne Droite : Cartes rattachées & Coordonnées (4 colonnes) -->
            <div class="lg:col-span-4 space-y-6">
                
                <!-- Cartes associées au compte -->
                <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-sm text-hos-dark">Cartes associées</h3>
                        <a href="/client/cards" class="text-xs font-bold text-hos-primary hover:underline">Gérer →</a>
                    </div>

                    <% if (cards && cards.length > 0) { %>
                        <div class="space-y-3">
                            <% cards.forEach(card => { %>
                                <div class="p-4 rounded-2xl bg-gradient-to-br from-[#29223A] to-[#3C3352] text-white shadow-sm">
                                    <div class="flex justify-between items-center mb-3">
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-[#F6EFE0]">
                                            <%= card.type === 'VIRTUELLE' ? 'Carte Virtuelle' : 'HosBank Titanium' %>
                                        </span>
                                        <span class="text-[9px] font-extrabold px-2 py-0.5 rounded uppercase <%= card.status === 'ACTIF' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300' %>">
                                            <%= card.status %>
                                        </span>
                                    </div>
                                    <div class="font-mono text-sm tracking-widest font-bold mb-2">
                                        <%= card.maskedPan %>
                                    </div>
                                    <div class="flex justify-between items-center text-[10px] text-gray-300 pt-2 border-t border-white/10 font-mono">
                                        <span>EXP : <%= card.expiry %></span>
                                        <span>Plafond : <%= card.monthlyLimit ? card.monthlyLimit + '€/m' : 'Standard' %></span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 text-center">
                            <span class="text-2xl block mb-2">💳</span>
                            <div class="font-bold text-xs text-hos-dark mb-1">Aucune carte rattachée</div>
                            <p class="text-[11px] text-gray-500 mb-3">Créez une carte virtuelle instantanée pour régler vos achats sécurisés.</p>
                            <a href="/client/cards" class="inline-block px-3 py-1.5 bg-hos-dark text-white text-xs font-bold rounded-lg shadow-sm">
                                Commander une carte
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Détails techniques du compte -->
                <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm">
                    <h3 class="font-bold text-sm text-hos-dark mb-4">Informations bancaires</h3>
                    
                    <div class="space-y-3 text-xs">
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="text-gray-400">Code Banque</span>
                            <span class="font-mono font-bold text-hos-dark">30004</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="text-gray-400">Code Guichet</span>
                            <span class="font-mono font-bold text-hos-dark">01234</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="text-gray-400">N° de Compte</span>
                            <span class="font-mono font-bold text-hos-dark"><%= account.cleanIban.slice(14, 25) %></span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="text-gray-400">Clé RIB</span>
                            <span class="font-mono font-bold text-hos-dark"><%= account.cleanIban.slice(25, 27) %></span>
                        </div>
                        <div class="flex justify-between py-2">
                            <span class="text-gray-400">Établissement</span>
                            <span class="font-semibold text-hos-dark">HosBank S.A.</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </main>
</div>

</body>
</html>
