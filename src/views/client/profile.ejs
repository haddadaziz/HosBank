<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#F8F9FA]">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CDN avec configuration des couleurs HosBank -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        hos: {
                            dark: '#29223A',      // Violet profond HosBank
                            hover: '#3C3352',     // Hover boutons sombres
                            primary: '#746B92',   // Prune signature HosBank
                            cream: '#F6EFE0',     // Crème douce
                            surface: '#FFFFFF',
                            bg: '#F8F9FA'
                        }
                    }
                }
            }
        }
    </script>
</head>

<body class="font-sans text-gray-900 bg-[#F8F9FA] min-h-screen antialiased">

    <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- Sidebar unifiée HosBank -->
        <%- include('../partials/sidebar', { role: 'client', currentPath: '/client/profile', user: user }) %>

        <!-- Contenu Principal -->
        <main class="ml-0 lg:ml-[275px] flex-1 p-4 sm:p-6 lg:p-10 lg:pt-10 max-w-[1400px] w-full min-w-0">

            <!-- Fil d'ariane & Titre -->
            <header class="mb-8">
                <nav class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-3">
                    <a href="/client/dashboard" class="hover:text-hos-primary transition-colors">Espace Client</a>
                    <span>/</span>
                    <span class="text-hos-dark">Mon Profil & Coordonnées</span>
                </nav>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl lg:text-3xl font-extrabold text-hos-dark tracking-tight">
                            Profil & Informations Personnelles
                        </h1>
                        <p class="text-sm text-gray-500 mt-1">
                            Consultez vos données bancaires certifiées et mettez à jour vos coordonnées en toute autonomie.
                        </p>
                    </div>
                </div>
            </header>

            <!-- Alertes Notifications -->
            <% if (success) { %>
                <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span><%= success %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 font-bold">&times;</button>
                </div>
            <% } %>

            <% if (error) { %>
                <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span><%= error %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-rose-600 hover:text-rose-900 font-bold">&times;</button>
                </div>
            <% } %>

            <!-- Hero Identity Card (HOS-38) -->
            <div class="bg-white border border-gray-100 rounded-3xl p-6 lg:p-8 shadow-sm mb-8 relative overflow-hidden">
                <div class="absolute -top-12 -right-12 w-48 h-48 bg-gradient-to-br from-hos-primary/10 via-hos-cream/30 to-transparent rounded-full blur-2xl pointer-events-none"></div>

                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
                    <div class="flex items-center gap-5">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#746B92] to-[#29223A] text-white flex items-center justify-center font-extrabold text-2xl shadow-md border-2 border-white shrink-0">
                            <%= profile.initials %>
                        </div>
                        <div>
                            <div class="flex flex-wrap items-center gap-2.5">
                                <h2 class="text-xl lg:text-2xl font-extrabold text-hos-dark">
                                    <%= profile.civilite ? profile.civilite + ' ' : '' %><%= profile.prenom %> <%= profile.nom %>
                                </h2>
                            </div>
                            <div class="text-xs text-gray-500 mt-1 flex flex-wrap items-center gap-4">
                                <span>Numéro de compte : <strong class="text-hos-dark font-mono"><%= (profile.accountNumber || 'Non assigné').replace(/^CPT-/, '') %></strong></span>
                                <span>•</span>
                                <span>Membre HosBank depuis le : <strong class="text-hos-dark"><%= profile.dateCreation %></strong></span>
                            </div>
                        </div>
                    </div>

                    <!-- Mini compteurs de services rattachés -->
                    <div class="flex items-center gap-3 shrink-0">
                        <div class="bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3 text-center min-w-[100px]">
                            <span class="text-xs text-gray-400 font-bold block uppercase tracking-wider">Comptes</span>
                            <span class="text-xl font-extrabold text-hos-dark"><%= stats.activeAccounts %></span>
                        </div>
                        <div class="bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3 text-center min-w-[100px]">
                            <span class="text-xs text-gray-400 font-bold block uppercase tracking-wider">Cartes</span>
                            <span class="text-xl font-extrabold text-hos-dark"><%= stats.activeCards %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grille 2 Colonnes : Coordonnées & Sécurité -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                <!-- Colonne Gauche : Formulaire de modification des Coordonnées (7 colonnes, HOS-39) -->
                <div class="lg:col-span-7 space-y-8">

                    <!-- Formulaire Coordonnées Modifiables (HOS-39) -->
                    <div class="bg-white border border-gray-100 rounded-3xl p-6 lg:p-8 shadow-sm">
                        <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-6">
                            <div>
                                <h3 class="text-lg font-bold text-hos-dark">Mes Coordonnées de Contact</h3>
                                <p class="text-xs text-gray-500 mt-0.5">Modifiez votre adresse et numéro de téléphone en temps réel.</p>
                            </div>
                        </div>

                        <form action="/client/profile" method="POST" class="space-y-6">
                            <!-- Téléphone -->
                            <div>
                                <label for="telephone" class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
                                    Numéro de Téléphone Portable <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                        </svg>
                                    </div>
                                    <input type="tel" id="telephone" name="telephone" required
                                        value="<%= profile.telephone || '' %>"
                                        placeholder="+33 6 12 34 56 78"
                                        class="w-full pl-10 pr-4 py-3 bg-gray-50 hover:bg-white focus:bg-white rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/20 text-sm font-semibold text-hos-dark outline-none transition-all">
                                </div>
                                <span class="text-[11px] text-gray-400 mt-1 block">Utilisé pour l'authentification 3D Secure et les alertes SMS.</span>
                            </div>

                            <!-- Adresse Postale -->
                            <div>
                                <label for="adressePostale" class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
                                    Adresse Postale Complète <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute top-3 left-0 pl-3.5 pointer-events-none text-gray-400">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                    </div>
                                    <textarea id="adressePostale" name="adressePostale" rows="3" required
                                        placeholder="Numéro, rue, code postal, ville et pays"
                                        class="w-full pl-10 pr-4 py-3 bg-gray-50 hover:bg-white focus:bg-white rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/20 text-sm font-semibold text-hos-dark outline-none transition-all leading-relaxed"><%= profile.adressePostale || '' %></textarea>
                                </div>
                                <span class="text-[11px] text-gray-400 mt-1 block">Adresse postale et fiscale figurant sur vos relevés de compte et RIB officiels.</span>
                            </div>

                            <div class="pt-2 flex items-center justify-end">
                                <button type="submit"
                                    class="inline-flex items-center gap-2 bg-hos-dark hover:bg-hos-hover text-white px-6 py-3 rounded-xl text-sm font-bold shadow-sm transition-all hover:-translate-y-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    Enregistrer mes coordonnées
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Fiche d'Identité Sécurisée en lecture seule (HOS-38) -->
                    <div class="bg-white border border-gray-100 rounded-3xl p-6 lg:p-8 shadow-sm">
                        <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-6">
                            <div>
                                <h3 class="text-lg font-bold text-hos-dark">État Civil & Informations Certifiées</h3>
                                <p class="text-xs text-gray-500 mt-0.5">Données vérifiées par les services de conformité HosBank.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
                            <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-100">
                                <span class="text-xs text-gray-400 font-bold block uppercase tracking-wider mb-1">Civilité</span>
                                <div class="font-extrabold text-hos-dark"><%= profile.civilite || 'Non renseigné' %></div>
                            </div>

                            <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-100">
                                <span class="text-xs text-gray-400 font-bold block uppercase tracking-wider mb-1">Nom de famille</span>
                                <div class="font-extrabold text-hos-dark"><%= profile.nom %></div>
                            </div>

                            <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-100">
                                <span class="text-xs text-gray-400 font-bold block uppercase tracking-wider mb-1">Prénom</span>
                                <div class="font-extrabold text-hos-dark"><%= profile.prenom %></div>
                            </div>

                            <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-100">
                                <span class="text-xs text-gray-400 font-bold block uppercase tracking-wider mb-1">Adresse E-mail</span>
                                <div class="font-extrabold text-hos-dark truncate"><%= profile.email %></div>
                            </div>
                        </div>


                    </div>
                </div>

                <!-- Colonne Droite : Conseiller Dédié & Sécurité Mot de Passe (5 colonnes) -->
                <div class="lg:col-span-5 space-y-8">

                    <% if (typeof advisor !== 'undefined' && advisor && advisor.fullName) { %>
                        <!-- Fiche Conseiller Dédié -->
                        <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm relative overflow-hidden">
                            <div class="text-xs uppercase tracking-wider text-gray-400 font-bold mb-4">
                                Votre Conseiller Référent
                            </div>

                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-14 h-14 rounded-2xl bg-hos-cream text-hos-dark font-extrabold flex items-center justify-center text-lg shrink-0">
                                    <%= advisor.fullName.split(' ').map(n=>n[0]).join('') %>
                                </div>
                                <div>
                                    <h4 class="font-extrabold text-hos-dark text-base"><%= advisor.fullName %></h4>
                                    <span class="text-xs text-hos-primary font-bold">Conseiller Clientèle Dédié</span>
                                    <div class="text-xs text-gray-400 mt-0.5"><%= advisor.agency %></div>
                                </div>
                            </div>

                            <div class="space-y-2.5 text-xs text-gray-600 pt-3 border-t border-gray-100">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                    <span class="font-semibold text-hos-dark font-mono"><%= advisor.email %></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                    <span class="font-semibold text-hos-dark"><%= advisor.phone %></span>
                                </div>
                            </div>

                            <div class="mt-5">
                                <a href="/client/documents" class="w-full inline-flex items-center justify-center gap-2 bg-[#F6EFE0] hover:bg-[#ebdcc0] text-hos-dark font-bold text-xs px-4 py-2.5 rounded-xl transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                    </svg>
                                    Poser une question ou réclamation
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Fiche État initial : Aucun Conseiller Dédié -->
                        <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm relative overflow-hidden">
                            <div class="text-xs uppercase tracking-wider text-gray-400 font-bold mb-4">
                                Votre Conseiller Référent
                            </div>
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0 border border-amber-200/50">
                                    ⏳
                                </div>
                                <div>
                                    <h4 class="font-extrabold text-hos-dark text-base">Aucun conseiller attitré</h4>
                                    <span class="text-xs text-amber-700 font-bold bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200/60 mt-0.5 inline-block">En cours d'attribution</span>
                                </div>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed pt-3 border-t border-gray-100">
                                Un chargé de clientèle vous sera affecté par la direction bancaire dans les prochaines 24h ouvrées. En cas de besoin urgent, notre pôle support reste joignable à <span class="font-semibold text-hos-dark font-mono">contact@hosbank.fr</span>.
                            </p>
                        </div>
                    <% } %>

                    <!-- Modification du Mot de Passe -->
                    <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm">
                        <div class="pb-3 border-b border-gray-100 mb-5">
                            <h3 class="text-base font-bold text-hos-dark">Sécurité du Compte</h3>
                            <p class="text-xs text-gray-500 mt-0.5">Modifier votre mot de passe de connexion.</p>
                        </div>

                        <form action="/client/profile/password" method="POST" class="space-y-4">
                            <div>
                                <label for="currentPassword" class="block text-xs font-bold text-gray-500 mb-1.5">
                                    Mot de passe actuel
                                </label>
                                <input type="password" id="currentPassword" name="currentPassword" required
                                    placeholder="••••••••"
                                    class="w-full px-3.5 py-2.5 bg-gray-50 hover:bg-white focus:bg-white rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/20 text-xs font-semibold text-hos-dark outline-none transition-all">
                            </div>

                            <div>
                                <label for="newPassword" class="block text-xs font-bold text-gray-500 mb-1.5">
                                    Nouveau mot de passe
                                </label>
                                <input type="password" id="newPassword" name="newPassword" required minlength="8"
                                    placeholder="8 caractères minimum"
                                    class="w-full px-3.5 py-2.5 bg-gray-50 hover:bg-white focus:bg-white rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/20 text-xs font-semibold text-hos-dark outline-none transition-all">
                            </div>

                            <div>
                                <label for="confirmPassword" class="block text-xs font-bold text-gray-500 mb-1.5">
                                    Confirmer le mot de passe
                                </label>
                                <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8"
                                    placeholder="••••••••"
                                    class="w-full px-3.5 py-2.5 bg-gray-50 hover:bg-white focus:bg-white rounded-xl border border-gray-200 focus:border-hos-primary focus:ring-2 focus:ring-hos-primary/20 text-xs font-semibold text-hos-dark outline-none transition-all">
                            </div>

                            <button type="submit"
                                class="w-full inline-flex items-center justify-center gap-2 bg-hos-dark hover:bg-hos-hover text-white px-4 py-2.5 rounded-xl text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5 mt-2">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                                Mettre à jour le mot de passe
                            </button>
                        </form>
                    </div>

                </div>
            </div>

        </main>
    </div>

</body>
</html>
