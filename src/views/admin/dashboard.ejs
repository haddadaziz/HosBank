<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ==========================================================================
           HOSBANK 2026 — ADMIN DASHBOARD · PREMIUM FINTECH UI
           100% Conforme au Cahier des Charges
           ========================================================================== */

        :root {
            --p50:  #F4F2F9;
            --p100: #E8E5F3;
            --p200: #C9C3E3;
            --p400: #8B7EC8;
            --p600: #4E4580;
            --p700: #3E3455;
            --p800: #2D2540;
            --p900: #1C162A;

            --accent-green:  #10B981;
            --accent-blue:   #3B82F6;
            --accent-coral:  #F87171;

            --surface:     #FFFFFF;
            --surface-alt: #FAFAF9;
            --border:      rgba(62, 52, 85, 0.09);
            --border-mid:  rgba(62, 52, 85, 0.17);

            --text-h:     #1C162A;
            --text-body:  #3D3652;
            --text-muted: #7B739A;
            --text-faint: #ADA8C0;

            --shadow-xs: 0 1px 3px rgba(28,22,42,0.04);
            --shadow-sm: 0 2px 8px rgba(28,22,42,0.06);
            --shadow-md: 0 4px 20px rgba(28,22,42,0.07);
            --shadow-lg: 0 10px 40px rgba(28,22,42,0.10);
            --shadow-xl: 0 20px 60px rgba(28,22,42,0.13);

            --radius-sm: 10px;
            --radius-md: 16px;
            --radius-lg: 22px;
            --radius-xl: 28px;

            --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        body { background: var(--p50); }

        .admin-content {
            padding: 28px 32px 56px;
            max-width: 1440px;
        }

        /* ── Page Header ───────────────────────────────────────── */
        .db-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .db-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--p400);
            margin-bottom: 8px;
        }

        .db-eyebrow-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--p400);
            animation: pulse-dot 2.4s ease-in-out infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.7); }
        }

        .db-title {
            font-size: 2.05rem;
            font-weight: 800;
            color: var(--text-h);
            letter-spacing: -0.04em;
            line-height: 1.12;
            margin: 0 0 5px;
        }

        .db-sub {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 500;
            margin: 0;
        }

        .btn-ghost-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 18px;
            border-radius: 50px;
            background: var(--surface);
            border: 1px solid var(--border-mid);
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--p700);
            text-decoration: none;
            box-shadow: var(--shadow-sm);
            transition: all 0.22s var(--ease-out);
        }

        .btn-ghost-pill:hover {
            background: var(--p700);
            color: #fff;
            border-color: var(--p700);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md), 0 0 0 3px rgba(62,52,85,0.12);
        }

        .btn-ghost-pill svg {
            transition: transform 0.22s var(--ease-out);
        }

        .btn-ghost-pill:hover svg {
            transform: rotate(-10deg) scale(1.1);
        }

        /* ── KPI Grid ──────────────────────────────────────────── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 28px;
        }

        @media (max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 680px)  { .kpi-grid { grid-template-columns: 1fr; } }

        .kpi-card {
            position: relative;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 26px 24px 22px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.28s var(--ease-spring), box-shadow 0.28s var(--ease-out), border-color 0.2s;
            cursor: default;
        }

        .kpi-card:hover {
            transform: translateY(-5px) scale(1.008);
            box-shadow: var(--shadow-xl);
            border-color: var(--border-mid);
        }

        /* top accent stripe */
        .kpi-card::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        }

        .kpi-green::after  { background: linear-gradient(90deg, #10B981, #34D399); }
        .kpi-purple::after { background: linear-gradient(90deg, #3E3455, #8B7EC8); }
        .kpi-blue::after   { background: linear-gradient(90deg, #3B82F6, #60A5FA); }
        .kpi-coral::after  { background: linear-gradient(90deg, #F87171, #FBBF24); }

        /* background glow blob */
        .kpi-glow {
            position: absolute;
            width: 200px; height: 200px;
            border-radius: 50%;
            right: -50px; bottom: -70px;
            opacity: 0.05;
            pointer-events: none;
            filter: blur(40px);
            transition: opacity 0.3s;
        }
        .kpi-card:hover .kpi-glow { opacity: 0.13; }
        .kpi-green  .kpi-glow { background: #10B981; }
        .kpi-purple .kpi-glow { background: #3E3455; }
        .kpi-blue   .kpi-glow { background: #3B82F6; }
        .kpi-coral  .kpi-glow { background: #F87171; }

        /* KPI icon */
        .kpi-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
            flex-shrink: 0;
            transition: transform 0.28s var(--ease-spring);
        }
        .kpi-card:hover .kpi-icon { transform: scale(1.12) rotate(-4deg); }

        .kpi-green  .kpi-icon { background: rgba(16,185,129,0.12);  color: #10B981; }
        .kpi-purple .kpi-icon { background: rgba(62,52,85,0.10);    color: var(--p700); }
        .kpi-blue   .kpi-icon { background: rgba(59,130,246,0.12);  color: #2563EB; }
        .kpi-coral  .kpi-icon { background: rgba(248,113,113,0.14); color: #DC2626; }

        /* KPI value */
        .kpi-value {
            font-size: 2.1rem;
            font-weight: 800;
            color: var(--text-h);
            letter-spacing: -0.04em;
            line-height: 1.1;
            font-variant-numeric: tabular-nums;
            margin-bottom: 4px;
        }

        .kpi-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        /* KPI footer */
        .kpi-footer {
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px dashed var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
        }

        .kpi-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 9px;
            background: var(--surface-alt);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-body);
        }

        .kpi-chip-dot {
            width: 5px; height: 5px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* Progress bar */
        .kpi-progress {
            width: 100%;
            height: 5px;
            background: var(--border);
            border-radius: 99px;
            overflow: hidden;
            margin-top: 10px;
            margin-bottom: 2px;
        }

        .kpi-progress-fill {
            height: 100%;
            border-radius: 99px;
            background: linear-gradient(90deg, #3B82F6, #10B981);
            transform-origin: left;
            animation: bar-in 0.9s var(--ease-out) both;
        }

        @keyframes bar-in {
            from { transform: scaleX(0); }
            to   { transform: scaleX(1); }
        }

        /* ── Split layout ─────────────────────────────────────── */
        .db-split {
            display: grid;
            grid-template-columns: 1.9fr 1fr;
            gap: 22px;
            align-items: start;
        }

        @media (max-width: 1100px) { .db-split { grid-template-columns: 1fr; } }

        /* ── Panel ─────────────────────────────────────────────── */
        .db-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }

        .db-panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 20px 24px 18px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(180deg, var(--surface) 0%, rgba(244,242,249,0.3) 100%);
        }

        .db-panel-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--text-h);
            letter-spacing: -0.025em;
            margin: 0;
        }

        .db-panel-sub {
            font-size: 0.77rem;
            color: var(--text-muted);
            margin: 3px 0 0;
        }

        .db-panel-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--p700);
            text-decoration: none;
            padding: 5px 12px;
            border-radius: 50px;
            background: var(--p50);
            border: 1px solid var(--p100);
            white-space: nowrap;
            transition: all 0.2s var(--ease-out);
        }

        .db-panel-link:hover {
            background: var(--p700);
            color: #fff;
            border-color: var(--p700);
            transform: translateX(2px);
        }

        .db-panel-body { padding: 20px 22px; }

        /* ── Transaction Cards ─────────────────────────────────── */
        .tx-card {
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 15px 17px;
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 11px;
            background: var(--surface);
            transition: all 0.22s var(--ease-out);
            position: relative;
        }

        .tx-card::before {
            content: '';
            position: absolute;
            left: 0; top: 12px; bottom: 12px;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: var(--border);
            transition: background 0.2s;
        }

        .tx-card:hover {
            border-color: var(--border-mid);
            box-shadow: var(--shadow-sm);
            transform: translateX(3px);
        }

        .tx-card:hover::before { background: var(--p600); }
        .tx-card:last-child { margin-bottom: 0; }

        .tx-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .tx-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

        .tx-ref {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--p700);
            background: var(--p50);
            border: 1px solid var(--p100);
            padding: 3px 8px;
            border-radius: 6px;
        }

        .tx-date {
            font-size: 0.73rem;
            color: var(--text-faint);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Transfer flow */
        .tx-flow {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 12px;
            background: var(--surface-alt);
            padding: 11px 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
        }

        .tx-party-label {
            font-size: 0.61rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--text-faint);
            margin-bottom: 2px;
        }

        .tx-party-name {
            font-size: 0.86rem;
            font-weight: 700;
            color: var(--text-h);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-party-iban {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-arrow {
            width: 28px; height: 28px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border-mid);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--p600);
            flex-shrink: 0;
            box-shadow: var(--shadow-xs);
        }

        .tx-footbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .tx-motif {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-style: italic;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 270px;
        }

        .tx-amount {
            font-size: 1.08rem;
            font-weight: 800;
            color: var(--accent-green);
            letter-spacing: -0.025em;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        /* ── Client rows ───────────────────────────────────────── */
        .client-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            margin-bottom: 8px;
            background: var(--surface);
            transition: all 0.22s var(--ease-out);
        }

        .client-row:hover {
            border-color: var(--border-mid);
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

        .client-row:last-child { margin-bottom: 0; }

        .client-avatar {
            width: 40px; height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--p400) 0%, var(--p700) 100%);
            color: #fff;
            font-size: 0.83rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 8px rgba(62,52,85,0.18);
        }

        .client-info { flex: 1; min-width: 0; }

        .client-name {
            font-size: 0.87rem;
            font-weight: 700;
            color: var(--text-h);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .client-email {
            font-size: 0.71rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px;
        }

        .clients-footer {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--border);
        }

        .btn-full-purple {
            display: block;
            width: 100%;
            text-align: center;
            padding: 10px 14px;
            background: linear-gradient(135deg, var(--p600) 0%, var(--p800) 100%);
            color: #fff;
            font-size: 0.83rem;
            font-weight: 700;
            border-radius: var(--radius-sm);
            text-decoration: none;
            box-shadow: 0 3px 12px rgba(62,52,85,0.22);
            transition: all 0.22s var(--ease-out);
        }

        .btn-full-purple:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(62,52,85,0.30);
            filter: brightness(1.08);
        }

        /* ── Empty state ───────────────────────────────────────── */
        .empty-state {
            text-align: center;
            padding: 40px 16px;
            color: var(--text-muted);
        }

        .empty-state-icon {
            width: 52px; height: 52px;
            border-radius: 16px;
            background: var(--p50);
            border: 1px solid var(--p100);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            color: var(--text-faint);
        }

        .empty-state p { font-size: 0.85rem; font-weight: 500; margin: 0; }

        /* ── Entrance animations ───────────────────────────────── */
        .anim-fade-up {
            animation: fade-up 0.5s var(--ease-out) both;
        }

        @keyframes fade-up {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .delay-1 { animation-delay: 0.04s; }
        .delay-2 { animation-delay: 0.09s; }
        .delay-3 { animation-delay: 0.14s; }
        .delay-4 { animation-delay: 0.19s; }
        .delay-5 { animation-delay: 0.27s; }
        .delay-6 { animation-delay: 0.35s; }

        /* 1. Header de page avec hiérarchie claire */
        .dashboard-header-zone {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .header-context-tag {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--brand-secondary);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .header-context-tag::before {
            content: '';
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: var(--brand-secondary);
        }

        .dashboard-main-title {
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.035em;
            margin: 0 0 6px 0;
            line-height: 1.15;
        }

        .dashboard-sub-title {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0;
            font-weight: 500;
        }

        .btn-workload-access {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #FFFFFF;
            color: var(--brand-primary);
            font-size: 0.85rem;
            font-weight: 700;
            padding: 10px 18px;
            border-radius: 12px;
            border: 1px solid var(--brand-border);
            box-shadow: var(--shadow-subtle);
            text-decoration: none;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-workload-access:hover {
            background: #FAF8F5;
            border-color: var(--brand-border-hover);
            transform: translateY(-2px);
            box-shadow: var(--shadow-card);
            color: var(--brand-primary);
        }

        /* 2. Les 4 KPIs Stratégiques (Critères du Cahier des Charges) */
        .strategic-kpis-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .kpi-metric-card {
            background: #FFFFFF;
            border-radius: 18px;
            padding: 24px;
            border: 1px solid var(--brand-border);
            box-shadow: var(--shadow-card);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            position: relative;
            overflow: hidden;
        }

        .kpi-metric-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-card-hover);
            border-color: var(--brand-border-hover);
        }

        .kpi-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .kpi-icon-bubble {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform 0.2s ease;
        }

        .kpi-metric-card:hover .kpi-icon-bubble {
            transform: scale(1.05);
        }

        .kpi-icon-bubble.icon-emerald {
            background: rgba(16, 185, 129, 0.12);
            color: #10B981;
        }

        .kpi-icon-bubble.icon-purple {
            background: rgba(62, 52, 85, 0.10);
            color: var(--brand-primary);
        }

        .kpi-icon-bubble.icon-blue {
            background: rgba(59, 130, 246, 0.12);
            color: #2563EB;
        }

        .kpi-icon-bubble.icon-coral {
            background: rgba(233, 122, 122, 0.16);
            color: #C53030;
        }

        .kpi-main-number {
            font-size: 1.95rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.035em;
            line-height: 1.2;
            margin-bottom: 5px;
            font-variant-numeric: tabular-nums;
        }

        .kpi-main-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        .kpi-bottom-row {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px dashed rgba(62, 52, 85, 0.12);
            font-size: 0.78rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
        }

        .sub-metric-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 9px;
            background: #FAF8F5;
            border: 1px solid rgba(62, 52, 85, 0.08);
            border-radius: 8px;
            font-size: 0.74rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .sub-metric-pill strong {
            color: var(--text-main);
            font-weight: 700;
        }

        .sub-metric-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .kpi-progress-track {
            width: 100%;
            height: 6px;
            background: rgba(62, 52, 85, 0.08);
            border-radius: 99px;
            overflow: hidden;
            margin-top: 10px;
        }

        .kpi-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #3B82F6 0%, #10B981 100%);
            border-radius: 99px;
            transition: width 0.6s ease;
        }

        /* 3. Grille Principale (Transactions 2fr / Clients 1fr) */
        .dashboard-split-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            align-items: start;
        }

        @media (max-width: 1080px) {
            .dashboard-split-layout {
                grid-template-columns: 1fr;
            }
        }

        /* 4. Cartes des Dernières Opérations Bancaires */
        .panel-card-container {
            background: #FFFFFF;
            border: 1px solid var(--brand-border);
            border-radius: 20px;
            box-shadow: var(--shadow-card);
            overflow: hidden;
        }

        .panel-header-bar {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(62, 52, 85, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }

        .panel-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin: 0;
        }

        .panel-caption {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 3px 0 0 0;
        }

        .panel-action-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--brand-primary);
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 8px;
            background: rgba(62, 52, 85, 0.05);
            transition: all 0.2s ease;
        }

        .panel-action-link:hover {
            background: rgba(62, 52, 85, 0.10);
            transform: translateX(2px);
        }

        .panel-body-area {
            padding: 20px 24px;
        }

        /* Fiche de transaction bancaire */
        .tx-feed-card {
            background: #FFFFFF;
            border: 1px solid var(--brand-border);
            border-radius: 14px;
            padding: 16px 18px;
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: all 0.2s ease;
        }

        .tx-feed-card:hover {
            border-color: var(--brand-border-hover);
            box-shadow: var(--shadow-subtle);
            transform: translateY(-2px);
        }

        .tx-feed-card:last-child {
            margin-bottom: 0;
        }

        .tx-card-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .tx-reference-chip {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--brand-primary);
            background: rgba(62, 52, 85, 0.06);
            padding: 4px 8px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .tx-date-chip {
            font-size: 0.76rem;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .tx-parties-flow {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 14px;
            background: #FAF8F5;
            padding: 12px 16px;
            border-radius: 10px;
            border: 1px solid rgba(62, 52, 85, 0.06);
        }

        .tx-role-caption {
            font-size: 0.64rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 2px;
        }

        .tx-person-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-account-iban {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-arrow-circle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 1px solid rgba(62, 52, 85, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-primary);
            flex-shrink: 0;
            box-shadow: 0 2px 5px rgba(40, 33, 56, 0.04);
        }

        .tx-card-footbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .tx-memo-text {
            font-size: 0.78rem;
            color: var(--text-muted);
            font-style: italic;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 300px;
        }

        .tx-credit-amount {
            font-size: 1.12rem;
            font-weight: 800;
            color: var(--status-success);
            letter-spacing: -0.02em;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        /* 5. Cartes des Nouveaux Utilisateurs */
        .client-compact-card {
            background: #FFFFFF;
            border: 1px solid var(--brand-border);
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s ease;
        }

        .client-compact-card:hover {
            border-color: var(--brand-border-hover);
            transform: translateY(-2px);
            box-shadow: var(--shadow-subtle);
        }

        .client-compact-card:last-child {
            margin-bottom: 0;
        }

        .client-avatar-disc {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #685E86 0%, #3E3455 100%);
            color: #FFFFFF;
            font-weight: 800;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 6px rgba(62, 52, 85, 0.15);
        }

        .client-details-block {
            flex: 1;
            min-width: 0;
        }

        .client-full-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .client-email-address {
            font-size: 0.74rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 2px;
        }
    </style>
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar', { role: 'admin', currentPath: '/admin/dashboard' }) %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">

            <!-- ══ Page Header ══════════════════════════════════════════════ -->
            <div class="db-header anim-fade-up">
                <div>
                    <div class="db-eyebrow">
                        <span class="db-eyebrow-dot"></span>
                        Administration HosBank · Direction
                    </div>
                    <h1 class="db-title">Tableau de Bord Stratégique</h1>
                    <p class="db-sub">Indicateurs clés de performance et flux financiers en temps réel</p>
                </div>
                <div>
                    <a href="/admin/advisors-workload" class="btn-ghost-pill">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        Supervision Conseillers
                    </a>
                </div>
            </div>

            <!-- ══ KPI Grid (4 Indicateurs CDC) ═════════════════════════════ -->
            <div class="kpi-grid">

                <!-- KPI 1 · Total Dépôts (Courant + Épargne) -->
                <div class="kpi-card kpi-green anim-fade-up delay-1">
                    <div class="kpi-glow"></div>
                    <div class="kpi-icon">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="kpi-value">
                        <%= (stats.metrics.totalDeposits || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                    </div>
                    <div class="kpi-label">Total des Fonds Déposés</div>
                    <div class="kpi-footer">
                        <div class="kpi-chip">
                            <span class="kpi-chip-dot" style="background:#10B981;"></span>
                            Courant&nbsp;<strong style="color:var(--text-h);"><%= (stats.metrics.depositsCourant || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</strong>
                        </div>
                        <div class="kpi-chip">
                            <span class="kpi-chip-dot" style="background:#8B7EC8;"></span>
                            Épargne&nbsp;<strong style="color:var(--text-h);"><%= (stats.metrics.depositsEpargne || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</strong>
                        </div>
                    </div>
                </div>

                <!-- KPI 2 · Volume Transactions (Mois en cours) -->
                <div class="kpi-card kpi-purple anim-fade-up delay-2">
                    <div class="kpi-glow"></div>
                    <div class="kpi-icon">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                    </div>
                    <div class="kpi-value">
                        <%= (stats.metrics.monthTransactionsVolume || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                    </div>
                    <div class="kpi-label">Volume Transactions — Mois en cours</div>
                    <div class="kpi-footer">
                        <span style="font-size:0.75rem;color:var(--text-muted);">Opérations enregistrées</span>
                        <strong style="font-size:0.82rem;color:var(--text-h);">
                            <%= stats.metrics.monthTransactionsCount || 0 %> virements
                        </strong>
                    </div>
                </div>

                <!-- KPI 3 · Taux d'Activation des Comptes -->
                <div class="kpi-card kpi-blue anim-fade-up delay-3">
                    <div class="kpi-glow"></div>
                    <div class="kpi-icon">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="kpi-value"><%= stats.metrics.accountActivationRate %>%</div>
                    <div class="kpi-label">Taux d'Activation des Comptes</div>
                    <div class="kpi-progress">
                        <div class="kpi-progress-fill"
                            style="width:<%= Math.min(stats.metrics.accountActivationRate || 0, 100) %>%;"></div>
                    </div>
                    <div class="kpi-footer">
                        <span style="font-size:0.75rem;color:var(--text-muted);">Comptes actifs</span>
                        <strong style="font-size:0.82rem;color:var(--text-h);">
                            <%= stats.metrics.activeAccounts %> / <%= stats.metrics.totalAccounts %>
                        </strong>
                    </div>
                </div>

                <!-- KPI 4 · Satisfaction Client -->
                <div class="kpi-card kpi-coral anim-fade-up delay-4">
                    <div class="kpi-glow"></div>
                    <div class="kpi-icon">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="kpi-value"><%= stats.metrics.clientSatisfactionRate %> %</div>
                    <div class="kpi-label">Satisfaction Client</div>
                    <div class="kpi-footer">
                        <span style="font-size:0.75rem;color:var(--text-muted);">Résolution réclamations</span>
                        <strong style="font-size:0.82rem;color:var(--text-h);">
                            <%= stats.metrics.clientSatisfactionRate %>%
                        </strong>
                    </div>
                </div>

            </div><!-- /.kpi-grid -->

            <!-- ══ Split (Transactions | Clients) ════════════════════════════ -->
            <div class="db-split">

                <!-- ── Dernières Transactions ──────────────────────────────── -->
                <div class="db-panel anim-fade-up delay-5">
                    <div class="db-panel-head">
                        <div>
                            <h2 class="db-panel-title">Dernières Transactions Bancaires</h2>
                            <p class="db-panel-sub">Flux d'opérations et virements exécutés récemment</p>
                        </div>
                        <a href="/admin/transactions" class="db-panel-link">
                            Audit complet
                            <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                    <div class="db-panel-body">
                        <% if (stats.recentTransactions && stats.recentTransactions.length > 0) { %>
                            <% stats.recentTransactions.forEach(tx => {
                                const ref           = tx.reference_sepa || tx.reference || 'REF-N/A';
                                const dateVal       = tx.date_execution_fr || tx.date || '—';
                                const sender        = tx.sender_name    || tx.sender    || 'Émetteur';
                                const senderIban    = tx.sender_iban    || tx.senderIban    || '—';
                                const recipient     = tx.recipient_name || tx.recipient || 'Bénéficiaire';
                                const recipientIban = tx.recipient_iban || tx.recipientIban || '—';
                                const amount        = Number(tx.montant  || tx.amount || 0);
                                const statut        = tx.statut || tx.status || 'VALIDE';
                                const motif         = tx.motif || '';
                            %>
                            <div class="tx-card">
                                <div class="tx-topbar">
                                    <div class="tx-meta">
                                        <span class="tx-ref"><%= ref %></span>
                                        <span class="tx-date">
                                            <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            <%= dateVal %>
                                        </span>
                                    </div>
                                    <div>
                                        <% if (statut === 'Validé' || statut === 'VALIDE') { %>
                                            <span class="badge success"><span class="badge-dot"></span> Validé</span>
                                        <% } else if (statut === 'En attente' || statut === 'EN_ATTENTE') { %>
                                            <span class="badge warning"><span class="badge-dot"></span> En attente</span>
                                        <% } else { %>
                                            <span class="badge danger"><span class="badge-dot"></span> Bloqué</span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="tx-flow">
                                    <div style="overflow:hidden;">
                                        <div class="tx-party-label">Émetteur</div>
                                        <div class="tx-party-name" title="<%= sender %>"><%= sender %></div>
                                        <div class="tx-party-iban" title="<%= senderIban %>"><%= senderIban %></div>
                                    </div>
                                    <div class="tx-arrow" title="Virement SEPA">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                                d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                        </svg>
                                    </div>
                                    <div style="overflow:hidden;text-align:right;">
                                        <div class="tx-party-label">Destinataire</div>
                                        <div class="tx-party-name" title="<%= recipient %>"><%= recipient %></div>
                                        <div class="tx-party-iban" title="<%= recipientIban %>"><%= recipientIban %></div>
                                    </div>
                                </div>

                                <div class="tx-footbar">
                                    <div class="tx-motif" title="<%= motif %>">
                                        <%= motif ? motif : 'Virement bancaire SEPA' %>
                                    </div>
                                    <div class="tx-amount">
                                        + <%= amount.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                    </svg>
                                </div>
                                <p>Aucune opération enregistrée pour le moment.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- ── Derniers Inscrits ────────────────────────────────────── -->
                <div class="db-panel anim-fade-up delay-6">
                    <div class="db-panel-head">
                        <div>
                            <h2 class="db-panel-title">Derniers Inscrits</h2>
                            <p class="db-panel-sub">Nouveaux comptes clients créés</p>
                        </div>
                        <a href="/admin/clients" class="db-panel-link">
                            Annuaire
                            <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                    <div class="db-panel-body">
                        <% if (stats.recentClients && stats.recentClients.length > 0) { %>
                            <% stats.recentClients.forEach(c => {
                                const initials  = ((c.firstName ? c.firstName[0] : '') + (c.lastName ? c.lastName[0] : '')).toUpperCase() || 'CL';
                                const isBlocked = c.status === 'Bloqué' || c.status === 'BLOQUE';
                            %>
                            <div class="client-row">
                                <div class="client-avatar"><%= initials %></div>
                                <div class="client-info">
                                    <div class="client-name"><%= c.firstName %> <%= c.lastName %></div>
                                    <div class="client-email"><%= c.email %></div>
                                </div>
                                <div>
                                    <% if (isBlocked) { %>
                                        <span class="badge danger" style="font-size:0.7rem;">Bloqué</span>
                                    <% } else { %>
                                        <span class="badge success" style="font-size:0.7rem;">Actif</span>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                </div>
                                <p>Aucun client inscrit récemment.</p>
                            </div>
                        <% } %>
                        <div class="clients-footer">
                            <a href="/admin/clients" class="btn-full-purple">
                                Gérer tous les utilisateurs
                            </a>
                        </div>
                    </div>
                </div>

            </div><!-- /.db-split -->

        </main>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
