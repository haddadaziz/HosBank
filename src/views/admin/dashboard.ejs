<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <!-- Entête de page -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Tableau de Bord Administratif</h1>
                    <p class="page-subtitle">Vue d'ensemble en temps réel des actifs, clients et flux de capitaux HosBank</p>
                </div>
                <div style="display: flex; gap: 12px;">
                    <a href="/admin/kyc" class="btn-sm btn-secondary">
                        <span class="badge warning" style="padding: 2px 6px;"><%= stats.metrics.pendingKycCount %></span>
                        Dossiers KYC
                    </a>
                    <button class="btn-primary" data-open-modal="modalAddClient">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Nouveau Client
                    </button>
                </div>
            </div>

            <!-- Indicateur de Base de Données Réelle -->
            <% if (stats.isRealDb) { %>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 22px; padding: 10px 16px; background-color: var(--status-success-bg); border-radius: var(--radius-sm); border: 1px solid rgba(16, 185, 129, 0.2); font-size: 0.85rem; color: #065F46;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: var(--status-success);"></span>
                    <strong>Base PostgreSQL Connectée :</strong> Données bancaires réelles synchronisées en direct.
                </div>
            <% } else { %>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 22px; padding: 12px 18px; background-color: #FFFBEB; border-radius: var(--radius-sm); border: 1px solid rgba(245, 158, 11, 0.3); font-size: 0.85rem; color: #92400E;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: var(--status-warning);"></span>
                        <span><strong>Mode Démo Actif :</strong> Pour charger les données dans PostgreSQL, vérifiez votre <code>.env</code> et exécutez <code>npm run db:init</code>.</span>
                    </div>
                </div>
            <% } %>

            <!-- Grille de Métriques Clés -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <span class="stat-trend up">↑ +14.2% ce mois</span>
                    </div>
                    <div class="stat-value"><%= stats.metrics.totalClients.toLocaleString('fr-FR') %></div>
                    <div class="stat-label">Comptes Clients Actifs</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-icon success">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <span class="stat-trend up">↑ +8.5%</span>
                    </div>
                    <div class="stat-value"><%= stats.metrics.totalDeposits.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</div>
                    <div class="stat-label">Total Dépôts & Avoirs Gérés</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                            </svg>
                        </div>
                        <span class="stat-trend" style="background: var(--primary-light); color: var(--primary);">24h direct</span>
                    </div>
                    <div class="stat-value"><%= stats.metrics.todayTransactionsVolume.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</div>
                    <div class="stat-label">Volume de Transactions du Jour</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-icon coral">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                        </div>
                        <span class="stat-trend" style="background: var(--status-danger-bg); color: var(--status-danger);">Action requise</span>
                    </div>
                    <div class="stat-value"><%= stats.metrics.flaggedTransactionsCount %></div>
                    <div class="stat-label">Virements à Contrôler</div>
                </div>
            </div>

            <!-- Deux Colonnes : Flux en Direct + Clients Récents -->
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <!-- Tableau des Transactions Récentes -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Dernières Transactions Bancaires</div>
                            <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">Virements SEPA, instantanés et opérations directes</div>
                        </div>
                        <a href="/admin/transactions" class="btn-sm btn-secondary">Voir tout</a>
                    </div>
                    <div class="data-table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Réf. / Date</th>
                                    <th>Émetteur</th>
                                    <th>Destinataire / Type</th>
                                    <th>Montant</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% stats.recentTransactions.forEach(tx => { %>
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem;"><%= tx.reference %></div>
                                            <div style="font-size: 0.78rem; color: var(--text-muted);"><%= tx.date %></div>
                                        </td>
                                        <td>
                                            <div style="font-weight: 600;"><%= tx.sender %></div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= tx.senderIban %></div>
                                        </td>
                                        <td>
                                            <div><%= tx.recipient %></div>
                                            <div style="font-size: 0.78rem; color: var(--primary); font-weight: 600;"><%= tx.type %></div>
                                        </td>
                                        <td>
                                            <span style="font-weight: 700; color: <%= tx.amount < 0 ? 'var(--text-main)' : 'var(--status-success)' %>;">
                                                <%= tx.amount > 0 ? '+' : '' %><%= tx.amount.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €
                                            </span>
                                        </td>
                                        <td>
                                            <% if (tx.status === 'Validé') { %>
                                                <span class="badge success"><span class="badge-dot"></span> Validé</span>
                                            <% } else if (tx.status === 'En attente') { %>
                                                <span class="badge warning"><span class="badge-dot"></span> En attente</span>
                                            <% } else { %>
                                                <span class="badge danger"><span class="badge-dot"></span> Bloqué</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Colonne Droite : Clients Récents & Alertes KYC -->
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <!-- Dossiers KYC Prioritaires -->
                    <div class="card" style="margin-bottom: 0;">
                        <div class="card-header">
                            <div class="card-title">Dossiers KYC en Attente</div>
                            <span class="badge purple"><%= stats.pendingKyc.length %></span>
                        </div>
                        <div class="card-body" style="padding: 16px 20px;">
                            <% stats.pendingKyc.forEach(k => { %>
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid rgba(104, 94, 134, 0.08);">
                                    <div>
                                        <div style="font-weight: 600; font-size: 0.9rem;"><%= k.clientName %></div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted);"><%= k.documentType %> • <%= k.documentNumber %></div>
                                    </div>
                                    <a href="/admin/kyc" class="btn-sm btn-secondary" style="padding: 6px 10px;">Examiner</a>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Nouveaux Clients -->
                    <div class="card" style="margin-bottom: 0;">
                        <div class="card-header">
                            <div class="card-title">Derniers Clients Inscrits</div>
                            <a href="/admin/clients" class="btn-sm btn-secondary">Gestion</a>
                        </div>
                        <div class="card-body" style="padding: 16px 20px;">
                            <% stats.recentClients.forEach(c => { %>
                                <div style="display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(104, 94, 134, 0.08);">
                                    <div style="width: 38px; height: 38px; border-radius: 50%; background: var(--primary-light); color: var(--primary); font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
                                        <%= c.firstName[0] %><%= c.lastName[0] %>
                                    </div>
                                    <div style="flex: 1; overflow: hidden;">
                                        <div style="font-weight: 600; font-size: 0.88rem;"><%= c.firstName %> <%= c.lastName %></div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= c.city %> • <%= c.totalBalance.toLocaleString('fr-FR') %> €</div>
                                    </div>
                                    <span class="badge success" style="font-size: 0.72rem;"><%= c.status %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Modale de Création Rapide de Client -->
<div class="modal-overlay" id="modalAddClient">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-title">Créer un Nouveau Compte Client</div>
            <button class="modal-close" data-close-modal>&times;</button>
        </div>
        <form action="/admin/clients/new" method="POST">
            <div class="modal-body">
                <div class="form-group" style="display: flex; gap: 20px; margin-bottom: 15px;">
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" value="M" checked style="accent-color: var(--primary);"> M.
                    </label>
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" value="Mme" style="accent-color: var(--primary);"> Mme
                    </label>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="firstName">Prénom</label>
                        <input type="text" id="firstName" name="firstName" class="form-input" placeholder="Ex: Jean" required>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Nom</label>
                        <input type="text" id="lastName" name="lastName" class="form-input" placeholder="Ex: Dupont" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="email">Adresse E-mail</label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="jean.dupont@email.com" required>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="phone">Téléphone</label>
                        <input type="text" id="phone" name="phone" class="form-input" placeholder="+33 6 ...">
                    </div>
                    <div class="form-group">
                        <label for="city">Ville de résidence</label>
                        <input type="text" id="city" name="city" class="form-input" placeholder="Paris, Lyon...">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-sm btn-secondary" data-close-modal>Annuler</button>
                <button type="submit" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem;">Créer le client</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
