<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ==========================================================
           HOSBANK 2026 - TRANSACTIONS AUDIT CARDS STYLING
           ========================================================== */
        .transactions-card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 20px;
            padding: 24px;
        }

        @media (max-width: 768px) {
            .transactions-card-grid {
                grid-template-columns: 1fr;
                padding: 16px;
            }
        }

        .tx-card-item {
            background: #FFFFFF;
            border: 1px solid rgba(104, 94, 134, 0.14);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            box-shadow: 0 4px 16px rgba(40, 33, 56, 0.04);
            transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.22s ease;
            position: relative;
        }

        .tx-card-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(40, 33, 56, 0.09);
            border-color: rgba(104, 94, 134, 0.28);
        }

        .tx-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(104, 94, 134, 0.08);
        }

        .tx-ref-pill {
            font-family: monospace;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
            background: rgba(104, 94, 134, 0.08);
            padding: 3px 8px;
            border-radius: 6px;
        }

        .tx-amount-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .tx-amount-value {
            font-size: 1.55rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        .tx-flow-box {
            background: #FAF8F5;
            border-radius: 12px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            border: 1px solid rgba(104, 94, 134, 0.06);
        }

        .tx-flow-party {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .tx-party-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-top: 5px;
            flex-shrink: 0;
        }

        .tx-party-info {
            flex: 1;
            min-width: 0;
        }

        .tx-party-role {
            font-size: 0.68rem;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.03em;
        }

        .tx-party-name {
            font-size: 0.86rem;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-party-iban {
            font-size: 0.74rem;
            font-family: monospace;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-flow-divider {
            display: flex;
            align-items: center;
            gap: 8px;
            padding-left: 3px;
            color: var(--text-muted);
            font-size: 0.75rem;
            opacity: 0.65;
        }

        .tx-motif-box {
            background: #FAF8F5;
            border-left: 3px solid #685E86;
            padding: 10px 14px;
            border-radius: 0 8px 8px 0;
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .empty-transactions-view {
            text-align: center;
            padding: 60px 24px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
    </style>
</head>
<body>

<div class="admin-layout">
    <!-- Barre latérale unifiée HosBank -->
    <%- include('../partials/sidebar', { role: 'admin', currentPath: '/admin/transactions' }) %>

    <div class="admin-main">
        <!-- Barre supérieure admin -->
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <!-- En-tête de la page -->
            <div class="page-header" style="flex-wrap: wrap; gap: 16px;">
                <div>
                    <h1 class="page-title">Audit des Virements & Flux Financiers</h1>
                    <p class="page-subtitle">Journal d'audit centralisé de tous les virements, détection des anomalies et archivage réglementaire</p>
                </div>

                <!-- Bouton Exportation CSV (Critère 3) -->
                <div>
                    <a 
                        href="/admin/transactions/export?q=<%= encodeURIComponent(filters.searchQuery || '') %>&minAmount=<%= encodeURIComponent(filters.minAmount || '') %>&maxAmount=<%= encodeURIComponent(filters.maxAmount || '') %>&dateStart=<%= encodeURIComponent(filters.dateStart || '') %>&dateEnd=<%= encodeURIComponent(filters.dateEnd || '') %>" 
                        class="btn-primary" 
                        style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; border-radius: 10px; font-weight: 700;"
                    >
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Exporter les Flux (CSV)
                    </a>
                </div>
            </div>

            <!-- Cartes statistiques globales d'audit -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <!-- Total des virements enregistrés -->
                <div class="card" style="padding: 18px 20px;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 6px;">Total Virements Audités</div>
                    <div style="font-size: 1.8rem; font-weight: 800; color: var(--text-main);"><%= summary.totalCount %></div>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Flux enregistrés en base</div>
                </div>

                <!-- Volume financier global -->
                <div class="card" style="padding: 18px 20px;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 6px;">Volume Financier Total</div>
                    <div style="font-size: 1.8rem; font-weight: 800; color: #746B92;">
                        <%= Number(summary.totalVolume).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                    </div>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Montant cumulé audité</div>
                </div>

                <!-- Flux avec alerte réglementaire (> 5 000 €) -->
                <div class="card" style="padding: 18px 20px; border-left: 4px solid <%= summary.flaggedCount > 0 ? '#E97A7A' : '#10B981' %>;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 6px;">Alertes Réglementaires</div>
                    <div style="font-size: 1.8rem; font-weight: 800; color: <%= summary.flaggedCount > 0 ? '#E97A7A' : '#10B981' %>;">
                        <%= summary.flaggedCount %>
                    </div>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; font-weight: 600;">
                        <%= summary.flaggedCount > 0 ? 'Virements >= 5 000 € à surveiller' : 'Aucune anomalie détectée' %>
                    </div>
                </div>
            </div>

            <!-- Formulaire de filtres par montant, date et comptes (Critère 2) -->
            <div class="card" style="margin-bottom: 24px;">
                <div class="card-header" style="border-bottom: 1px solid var(--border-ui, #EFECE6); padding: 14px 20px;">
                    <span class="card-title" style="font-size: 0.95rem;">Filtres de Contrôle Financier</span>
                </div>
                <div style="padding: 18px 20px;">
                    <form action="/admin/transactions" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; align-items: flex-end;">
                        <!-- Comptes impliqués ou Recherche -->
                        <div>
                            <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Comptes impliqués / IBAN / Réf</label>
                            <input 
                                type="text" 
                                name="q" 
                                value="<%= filters.searchQuery || '' %>" 
                                placeholder="IBAN, nom ou référence..." 
                                style="width: 100%; padding: 8px 12px; font-size: 0.85rem; border: 1px solid #D8CEBB; border-radius: 8px; background: #FFFFFF; outline: none;"
                            >
                        </div>

                        <!-- Date début -->
                        <div>
                            <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Date de début</label>
                            <input 
                                type="date" 
                                name="dateStart" 
                                value="<%= filters.dateStart || '' %>" 
                                style="width: 100%; padding: 8px 12px; font-size: 0.85rem; border: 1px solid #D8CEBB; border-radius: 8px; background: #FFFFFF; outline: none;"
                            >
                        </div>

                        <!-- Date fin -->
                        <div>
                            <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Date de fin</label>
                            <input 
                                type="date" 
                                name="dateEnd" 
                                value="<%= filters.dateEnd || '' %>" 
                                style="width: 100%; padding: 8px 12px; font-size: 0.85rem; border: 1px solid #D8CEBB; border-radius: 8px; background: #FFFFFF; outline: none;"
                            >
                        </div>

                        <!-- Montant minimum -->
                        <div>
                            <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Montant Min (€)</label>
                            <input 
                                type="number" 
                                step="0.01" 
                                name="minAmount" 
                                value="<%= filters.minAmount || '' %>" 
                                placeholder="Ex: 100" 
                                style="width: 100%; padding: 8px 12px; font-size: 0.85rem; border: 1px solid #D8CEBB; border-radius: 8px; background: #FFFFFF; outline: none;"
                            >
                        </div>

                        <!-- Montant maximum -->
                        <div>
                            <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Montant Max (€)</label>
                            <input 
                                type="number" 
                                step="0.01" 
                                name="maxAmount" 
                                value="<%= filters.maxAmount || '' %>" 
                                placeholder="Ex: 5000" 
                                style="width: 100%; padding: 8px 12px; font-size: 0.85rem; border: 1px solid #D8CEBB; border-radius: 8px; background: #FFFFFF; outline: none;"
                            >
                        </div>

                        <!-- Boutons d'action -->
                        <div style="display: flex; gap: 8px;">
                            <button type="submit" class="btn-primary" style="flex: 1; padding: 8px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 700;">
                                Filtrer
                            </button>
                            <% if (filters.searchQuery || filters.minAmount || filters.maxAmount || filters.dateStart || filters.dateEnd) { %>
                                <a href="/admin/transactions" class="btn-secondary" style="padding: 8px 12px; border-radius: 8px; font-size: 0.85rem; text-decoration: none; text-align: center;">
                                    Effacer
                                </a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Grille des Cartes des Virements -->
            <div class="card">
                <div class="card-header" style="flex-wrap: wrap; gap: 14px; padding: 18px 24px; border-bottom: 1px solid var(--border-ui, #EFECE6);">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span class="card-title" style="font-size: 1.05rem;">Journal Centralisé des Virements</span>
                        <span class="badge purple" style="font-size: 0.8rem;"><%= transactions.length %> virement(s) répertorié(s)</span>
                    </div>
                </div>

                <% if (transactions && transactions.length > 0) { %>
                    <div class="transactions-card-grid">
                        <% transactions.forEach(tx => { %>
                            <div class="tx-card-item" style="<%= tx.flagged ? 'border-top: 4px solid #E97A7A;' : '' %>">
                                <!-- En-tête : Référence & Type & Statut -->
                                <div class="tx-card-header">
                                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                        <div class="tx-ref-pill">
                                            <%= tx.reference %>
                                        </div>
                                        <span class="badge" style="background: rgba(116, 107, 146, 0.12); color: #534B70; font-weight: 700; font-size: 0.74rem;">
                                            <%= tx.type %>
                                        </span>
                                    </div>

                                    <!-- Statut -->
                                    <div>
                                        <% if (tx.status === 'Validé') { %>
                                            <span class="badge success" style="font-weight: 700;">
                                                <span class="badge-dot" style="background: #10B981;"></span> Validé
                                            </span>
                                        <% } else if (tx.status === 'En attente') { %>
                                            <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #B45309; font-weight: 700;">
                                                <span class="badge-dot" style="background: #F59E0B;"></span> En attente
                                            </span>
                                        <% } else { %>
                                            <span class="badge danger" style="background: #FEE2E2; color: #DC2626; font-weight: 700;">
                                                <span class="badge-dot" style="background: #DC2626;"></span> Rejeté
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Montant & Alerte réglementaire -->
                                <div class="tx-amount-row">
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Montant du Flux</div>
                                        <div class="tx-amount-value">
                                            <%= Number(tx.amount).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €
                                        </div>
                                    </div>

                                    <% if (tx.flagged) { %>
                                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.72rem; font-weight: 700; color: #DC2626; background: #FEE2E2; padding: 4px 8px; border-radius: 6px; border: 1px solid #FCA5A5;">
                                            ⚠️ Seuil >= 5 000 €
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Circuit du Virement (Émetteur -> Destinataire) -->
                                <div class="tx-flow-box">
                                    <!-- Émetteur -->
                                    <div class="tx-flow-party">
                                        <div class="tx-party-dot" style="background: #685E86;"></div>
                                        <div class="tx-party-info">
                                            <div class="tx-party-role">Émetteur (Source)</div>
                                            <div class="tx-party-name"><%= tx.sender %></div>
                                            <div class="tx-party-iban"><%= tx.senderIban %></div>
                                        </div>
                                    </div>

                                    <div class="tx-flow-divider">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                                        </svg>
                                        <span>Flux SEPA</span>
                                    </div>

                                    <!-- Destinataire -->
                                    <div class="tx-flow-party">
                                        <div class="tx-party-dot" style="background: #10B981;"></div>
                                        <div class="tx-party-info">
                                            <div class="tx-party-role">Destinataire (Bénéficiaire)</div>
                                            <div class="tx-party-name"><%= tx.recipient %></div>
                                            <div class="tx-party-iban"><%= tx.recipientIban %></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Motif & Horodatage -->
                                <div class="tx-motif-box">
                                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                                        <span style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: #685E86;">Motif :</span>
                                        <span style="font-size: 0.72rem; font-family: monospace; color: var(--text-muted);"><%= tx.date %></span>
                                    </div>
                                    <div style="font-size: 0.82rem; color: var(--text-main); font-weight: 500;">
                                        <%= tx.motif || 'Aucun motif renseigné' %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-transactions-view">
                        <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.4;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                        <p style="font-weight: 600; font-size: 0.95rem;">Aucun virement ne correspond aux filtres appliqués.</p>
                    </div>
                <% } %>
            </div>
        </main>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
