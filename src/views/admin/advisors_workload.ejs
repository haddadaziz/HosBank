<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ==========================================================
           HOSBANK 2026 SUPERVISION & WORKLOAD STYLING
           ========================================================== */
        
        /* Bannière Hero de Supervision */
        .supervision-hero {
            background: linear-gradient(135deg, rgba(40, 33, 56, 0.98) 0%, rgba(104, 94, 134, 0.92) 100%);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 32px;
            color: #FFFFFF;
            position: relative;
            overflow: hidden;
            box-shadow: 0 12px 36px rgba(40, 33, 56, 0.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }

        .supervision-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 240px;
            height: 240px;
            background: radial-gradient(circle, rgba(233, 122, 122, 0.35) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .supervision-hero::after {
            content: '';
            position: absolute;
            bottom: -80px;
            left: 20%;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle, rgba(104, 94, 134, 0.4) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero-title-group h1 {
            font-size: 1.6rem;
            font-weight: 800;
            margin: 0 0 6px 0;
            letter-spacing: -0.02em;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .hero-title-group p {
            margin: 0;
            font-size: 0.88rem;
            color: rgba(255, 255, 255, 0.75);
            max-width: 620px;
            line-height: 1.5;
        }

        .live-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10B981;
            box-shadow: 0 0 10px #10B981;
            animation: pulse-dot 1.8s infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.6; }
        }

        .hero-controls {
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 2;
        }

        .hero-select {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
            padding: 10px 18px;
            border-radius: 12px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            backdrop-filter: blur(8px);
            transition: all 0.2s ease;
            outline: none;
        }

        .hero-select:hover, .hero-select:focus {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .hero-select option {
            background: #282138;
            color: #FFFFFF;
        }

        /* Grille des KPIs de Haut Niveau */
        .kpi-super-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .kpi-super-card {
            background: #FFFFFF;
            border-radius: 18px;
            padding: 22px 24px;
            border: 1px solid rgba(104, 94, 134, 0.1);
            box-shadow: 0 4px 20px rgba(40, 33, 56, 0.04);
            position: relative;
            overflow: hidden;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
        }

        .kpi-super-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(40, 33, 56, 0.08);
        }

        .kpi-super-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #685E86, #E97A7A);
        }

        .kpi-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .kpi-icon-wrap {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #EFEBFA;
            color: #685E86;
        }

        .kpi-icon-wrap.emerald {
            background: #ECFDF5;
            color: #10B981;
        }

        .kpi-icon-wrap.coral {
            background: #FEF2F2;
            color: #E97A7A;
        }

        .kpi-icon-wrap.amber {
            background: #FFFBEB;
            color: #F59E0B;
        }

        .kpi-value {
            font-size: 1.85rem;
            font-weight: 800;
            color: #282138;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }

        .kpi-label {
            font-size: 0.82rem;
            color: #746B92;
            margin-top: 6px;
            font-weight: 500;
        }

        /* Cartes de Performance des Conseillers */
        .advisors-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 24px;
            margin-bottom: 36px;
        }

        .advisor-master-card {
            background: #FFFFFF;
            border-radius: 20px;
            border: 1px solid rgba(104, 94, 134, 0.12);
            padding: 24px;
            box-shadow: 0 6px 24px rgba(40, 33, 56, 0.04);
            display: flex;
            flex-direction: column;
            gap: 20px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }

        .advisor-master-card:hover {
            transform: translateY(-3px);
            border-color: rgba(104, 94, 134, 0.25);
            box-shadow: 0 14px 36px rgba(40, 33, 56, 0.08);
        }

        .advisor-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .advisor-profile-group {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .avatar-with-beacon {
            position: relative;
        }

        .adv-avatar-circle {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background: linear-gradient(135deg, #282138 0%, #685E86 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            font-weight: 800;
            box-shadow: 0 6px 16px rgba(40, 33, 56, 0.25);
            border: 2px solid #FFFFFF;
        }

        .adv-online-beacon {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #10B981;
            border: 2px solid #FFFFFF;
        }

        .adv-name {
            font-size: 1.1rem;
            font-weight: 800;
            color: #282138;
            margin: 0;
            letter-spacing: -0.01em;
        }

        .adv-role-tag {
            display: inline-block;
            font-size: 0.74rem;
            font-weight: 600;
            color: #685E86;
            margin-top: 2px;
        }

        .status-badges-group {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
        }

        /* Bloc Jauge Portefeuille */
        .workload-gauge-box {
            background: #FBF9F5;
            border-radius: 14px;
            padding: 16px 18px;
            border: 1px solid rgba(104, 94, 134, 0.08);
        }

        .gauge-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .gauge-title {
            font-size: 0.78rem;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 0.05em;
            color: #746B92;
        }

        .gauge-count {
            font-size: 1.25rem;
            font-weight: 800;
            color: #282138;
        }

        .track-bar {
            height: 8px;
            background: rgba(104, 94, 134, 0.12);
            border-radius: 999px;
            overflow: hidden;
            position: relative;
        }

        .fill-bar {
            height: 100%;
            border-radius: 999px;
            transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Bloc Doubles Métriques */
        .treatment-metrics-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .treatment-metric-card {
            background: #FFFFFF;
            border: 1px solid rgba(104, 94, 134, 0.1);
            border-radius: 14px;
            padding: 14px 16px;
            box-shadow: 0 2px 8px rgba(40, 33, 56, 0.02);
        }

        .treatment-header {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #746B92;
            letter-spacing: 0.04em;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .treatment-rate {
            font-size: 1.45rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .treatment-sub {
            font-size: 0.75rem;
            color: #746B92;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Alerte & Relance Footer de la carte */
        .adv-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 14px;
            border-top: 1px solid rgba(104, 94, 134, 0.08);
        }

        .urgent-pulse-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 0.76rem;
            font-weight: 800;
            background: #FEF2F2;
            color: #DC2626;
            border: 1px solid rgba(220, 38, 38, 0.25);
            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.15);
            animation: pulse-border 2s infinite;
        }

        @keyframes pulse-border {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }

        /* Table de Supervision des Dossiers */
        .registry-card {
            background: #FFFFFF;
            border-radius: 20px;
            border: 1px solid rgba(104, 94, 134, 0.12);
            box-shadow: 0 8px 30px rgba(40, 33, 56, 0.04);
            overflow: hidden;
            margin-top: 8px;
        }

        .registry-header {
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(104, 94, 134, 0.08);
            background: #FAF8F5;
            flex-wrap: wrap;
            gap: 16px;
        }

        .table-search-bar {
            display: flex;
            align-items: center;
            background: #FFFFFF;
            border: 1px solid rgba(104, 94, 134, 0.18);
            border-radius: 12px;
            padding: 6px 14px;
            gap: 8px;
            width: 260px;
            transition: all 0.2s ease;
        }

        .table-search-bar:focus-within {
            border-color: #685E86;
            box-shadow: 0 0 0 3px rgba(104, 94, 134, 0.12);
        }

        .table-search-bar input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.85rem;
            width: 100%;
            color: #282138;
        }

        /* Bouton Relancer Premium */
        .btn-relance-glow {
            background: linear-gradient(135deg, #E97A7A 0%, #D9534F 100%);
            color: #FFFFFF;
            border: none;
            padding: 7px 16px;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            box-shadow: 0 3px 12px rgba(233, 122, 122, 0.35);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-relance-glow:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(233, 122, 122, 0.5);
            background: linear-gradient(135deg, #EF6B6B 0%, #C9302C 100%);
        }

        .btn-relance-glow:active {
            transform: translateY(0);
        }

        /* Badge Relancé Confirmé */
        .badge-relance-done {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ECFDF5;
            color: #065F46;
            border: 1px solid rgba(16, 185, 129, 0.35);
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 0.78rem;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.12);
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        /* ==========================================================
           GRILLE DE CARTES DES DOSSIERS EN ATTENTE
           ========================================================== */
        .dossiers-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 22px;
            padding: 24px 28px;
            background: #FAF8F5;
        }

        .dossier-card {
            background: #FFFFFF;
            border-radius: 18px;
            border: 1px solid rgba(104, 94, 134, 0.12);
            box-shadow: 0 4px 16px rgba(40, 33, 56, 0.03);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 22px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }

        .dossier-card:hover {
            transform: translateY(-3px);
            border-color: rgba(104, 94, 134, 0.25);
            box-shadow: 0 12px 28px rgba(40, 33, 56, 0.08);
        }

        .dossier-card.is-urgent {
            border-top: 3px solid #E97A7A;
        }

        .dossier-card.is-normal {
            border-top: 3px solid #F59E0B;
        }

        .dossier-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
        }

        .dossier-ref-tag {
            font-family: monospace;
            font-weight: 800;
            font-size: 0.92rem;
            color: #282138;
            background: #F3F0F9;
            padding: 4px 8px;
            border-radius: 8px;
            border: 1px solid rgba(104, 94, 134, 0.15);
        }

        .dossier-title {
            font-size: 1.08rem;
            font-weight: 800;
            color: #282138;
            margin: 0 0 4px 0;
            line-height: 1.35;
        }

        .dossier-meta-date {
            font-size: 0.74rem;
            color: #746B92;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .dossier-actors-box {
            background: #FBF9F5;
            border-radius: 14px;
            padding: 14px;
            border: 1px solid rgba(104, 94, 134, 0.08);
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 18px;
        }

        .dossier-actor-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .actor-label-small {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #746B92;
        }

        .actor-value-group {
            text-align: right;
        }

        .actor-name-bold {
            font-size: 0.88rem;
            font-weight: 700;
            color: #282138;
        }

        .actor-sub-text {
            font-size: 0.72rem;
            color: #746B92;
        }

        .dossier-bottom-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-top: 14px;
            border-top: 1px solid rgba(104, 94, 134, 0.08);
            flex-wrap: wrap;
        }

        /* Floating Toast Notification */
        .hos-floating-toast {
            position: fixed;
            bottom: 28px;
            right: 28px;
            background: #282138;
            color: #FFFFFF;
            padding: 14px 22px;
            border-radius: 14px;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.25);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 9999;
            font-size: 0.88rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.12);
            animation: slideInUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideInUp {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* ==========================================================
           RESPONSIVE BREAKPOINTS (Mobile & Tablet)
           ========================================================== */
        @media (max-width: 1024px) {
            .kpi-super-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .advisors-cards-grid {
                grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            }

            .dossiers-cards-grid {
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                padding: 20px;
                gap: 18px;
            }
        }

        @media (max-width: 768px) {
            .supervision-hero {
                padding: 22px 20px;
                flex-direction: column;
                align-items: stretch;
                gap: 18px;
            }

            .hero-title-group h1 {
                font-size: 1.35rem;
            }

            .hero-controls {
                width: 100%;
            }

            .hero-select {
                width: 100%;
            }

            .kpi-super-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .advisors-cards-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .advisor-master-card {
                padding: 20px 16px;
            }

            .registry-header {
                padding: 16px;
                flex-direction: column;
                align-items: stretch;
                gap: 14px;
            }

            .table-search-bar {
                width: 100%;
            }

            .dossiers-cards-grid {
                grid-template-columns: 1fr;
                padding: 16px 14px;
                gap: 16px;
            }

            .treatment-metrics-container {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .treatment-metric-card {
                padding: 12px 14px;
            }

            .treatment-rate {
                font-size: 1.25rem;
            }

            .hos-floating-toast {
                bottom: 16px;
                right: 16px;
                left: 16px;
                justify-content: center;
                text-align: center;
                font-size: 0.82rem;
                padding: 12px 16px;
            }
        }

        @media (max-width: 480px) {
            .treatment-metrics-container {
                grid-template-columns: 1fr;
            }

            .advisor-top-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .status-badges-group {
                flex-direction: row;
                align-items: center;
                flex-wrap: wrap;
                width: 100%;
                justify-content: flex-start;
                gap: 8px;
            }

            .adv-card-footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .kpi-value {
                font-size: 1.55rem;
            }

            .dossiers-cards-grid {
                padding: 14px 10px;
            }

            .dossier-card {
                padding: 16px 14px;
            }

            .dossier-card-header {
                flex-wrap: wrap;
                gap: 8px;
            }

            .dossier-actor-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }

            .actor-value-group {
                text-align: left;
            }

            .dossier-bottom-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }

            .relance-action-container {
                width: 100%;
            }

            .btn-relance-glow {
                width: 100%;
                justify-content: center;
            }

            .badge-relance-done {
                width: 100%;
                justify-content: center;
            }

            .data-table th, .data-table td {
                padding: 12px 10px;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <!-- Hero Banner de Supervision -->
            <div class="supervision-hero">
                <div class="hero-title-group">
                    <div style="margin-bottom: 8px;">
                        <span class="live-status-pill">
                            <span class="live-dot"></span>
                            Surveillance Active en Temps Réel
                        </span>
                    </div>
                    <h1>
                        Supervision & Charge des Conseillers
                    </h1>
                    <p>
                        Surveillez en direct la répartition des portefeuilles clients, l'efficience opérationnelle et pilotez le traitement rapide des dossiers en souffrance.
                    </p>
                </div>

                <div class="hero-controls">
                    <form method="GET" action="/admin/advisors-workload" style="margin: 0;">
                        <select name="advisorId" class="hero-select" onchange="this.form.submit()">
                            <option value="">Tous les conseillers de l'équipe</option>
                            <% advisors.forEach(adv => { %>
                                <option value="<%= adv.id %>" <%= selectedAdvisorId === adv.id ? 'selected' : '' %>>
                                    <%= adv.civilite || 'M.' %> <%= adv.prenom %> <%= adv.nom %>
                                </option>
                            <% }) %>
                        </select>
                    </form>
                </div>
            </div>

            <!-- Messages d'Alerte -->
            <% if (successMessage) { %>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 24px; padding: 14px 20px; background: #ECFDF5; border-radius: 14px; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.92rem; color: #065F46; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.08);">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span><strong>Notification :</strong> <%= successMessage %></span>
                </div>
            <% } %>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 24px; padding: 14px 20px; background: #FEF2F2; border-radius: 14px; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.92rem; color: #991B1B;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke-width="2.5"></circle>
                        <line x1="12" y1="8" x2="12" y2="12" stroke-width="2.5"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2.5"></line>
                    </svg>
                    <span><strong>Erreur :</strong> <%= errorMessage %></span>
                </div>
            <% } %>

            <!-- Grille des 4 KPIs Stratégiques -->
            <div class="kpi-super-grid">
                <div class="kpi-super-card">
                    <div class="kpi-card-header">
                        <div class="kpi-icon-wrap">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <span class="badge purple">Actifs</span>
                    </div>
                    <div class="kpi-value"><%= summary.totalAdvisors %></div>
                    <div class="kpi-label">Chargés de Clientèle Supervisés</div>
                </div>

                <div class="kpi-super-card">
                    <div class="kpi-card-header">
                        <div class="kpi-icon-wrap emerald">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                            </svg>
                        </div>
                        <span class="badge success">~<%= summary.avgClientsPerAdvisor %>/agent</span>
                    </div>
                    <div class="kpi-value"><%= summary.totalAssignedClients %></div>
                    <div class="kpi-label">Portefeuille Global Clients</div>
                </div>

                <div class="kpi-super-card">
                    <div class="kpi-card-header">
                        <div class="kpi-icon-wrap amber">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <span class="badge warning"><%= summary.globalTreatmentRate >= 80 ? 'Optimal' : 'Soutenu' %></span>
                    </div>
                    <div class="kpi-value"><%= summary.globalTreatmentRate %> %</div>
                    <div class="kpi-label">Taux Moyen de Traitement</div>
                </div>

                <div class="kpi-super-card">
                    <div class="kpi-card-header">
                        <div class="kpi-icon-wrap coral">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <% if (summary.totalRelanceAll > 0) { %>
                            <span class="badge danger">Action requise</span>
                        <% } else { %>
                            <span class="badge success">À jour</span>
                        <% } %>
                    </div>
                    <div class="kpi-value" style="color: <%= summary.totalRelanceAll > 0 ? '#DC2626' : '#282138' %>;">
                        <%= summary.totalRelanceAll %>
                    </div>
                    <div class="kpi-label">Dossiers en Souffrance (>24h)</div>
                </div>
            </div>

            <!-- Titre de Section : Fiches Conseillers -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                <div>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: #282138; margin: 0;">
                        Portefeuille & Performance des Conseillers
                    </h2>
                    <p style="font-size: 0.82rem; color: #746B92; margin: 2px 0 0 0;">
                        Vue détaillée par chargé de clientèle : répartition de la charge, délais de réponse et requêtes en attente
                    </p>
                </div>
                <span class="badge purple" style="font-size: 0.78rem; padding: 4px 10px;">
                    <%= advisors.length %> conseiller<%= advisors.length > 1 ? 's' : '' %>
                </span>
            </div>

            <!-- Grille des Conseillers -->
            <div class="advisors-cards-grid">
                <% if (advisors && advisors.length > 0) { %>
                    <% advisors.forEach(adv => { %>
                        <div class="advisor-master-card">
                            <!-- En-tête de la Carte -->
                            <div class="advisor-top-bar">
                                <div class="advisor-profile-group">
                                    <div class="avatar-with-beacon">
                                        <div class="adv-avatar-circle">
                                            <%= adv.prenom ? adv.prenom[0] : 'C' %><%= adv.nom ? adv.nom[0] : 'L' %>
                                        </div>
                                        <span class="adv-online-beacon" title="Conseiller Actif"></span>
                                    </div>
                                    <div>
                                        <h3 class="adv-name"><%= adv.civilite || 'M.' %> <%= adv.prenom %> <%= adv.nom %></h3>
                                        <span class="adv-role-tag">Chargé de Clientèle • ID #HB-<%= adv.id %></span>
                                        <div style="font-size: 0.76rem; color: #746B92; margin-top: 3px;">
                                            ✉️ <%= adv.email %>
                                        </div>
                                    </div>
                                </div>

                                <div class="status-badges-group">
                                    <span class="badge <%= adv.chargeBadge.class %>">
                                        <span class="badge-dot"></span> <%= adv.chargeBadge.label %>
                                    </span>
                                    <span class="badge <%= adv.reactiviteBadge.class %>" style="font-size: 0.72rem;">
                                        <%= adv.reactiviteBadge.label %>
                                    </span>
                                </div>
                            </div>

                            <!-- Critère 1 : Jauge de Clients Affectés -->
                            <div class="workload-gauge-box">
                                <div class="gauge-head">
                                    <span class="gauge-title">1. Clients Affectés en Portefeuille</span>
                                    <span class="gauge-count" style="color: #685E86;">
                                        <%= adv.assignedClientsCount %> <span style="font-size: 0.85rem; font-weight: 600; color: #746B92;">client<%= adv.assignedClientsCount > 1 ? 's' : '' %></span>
                                    </span>
                                </div>
                                <div class="track-bar">
                                    <div class="fill-bar" style="width: <%= Math.min(adv.assignedClientsCount * 5, 100) %>%; background: <%= adv.assignedClientsCount >= 30 ? 'linear-gradient(90deg, #F87171, #DC2626)' : (adv.assignedClientsCount >= 15 ? 'linear-gradient(90deg, #FBBF24, #D97706)' : 'linear-gradient(90deg, #34D399, #10B981)') %>;"></div>
                                </div>
                                <div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: #746B92; margin-top: 6px; font-weight: 600;">
                                    <span>Capacité cible : 20 clients</span>
                                    <span><%= Math.round((adv.assignedClientsCount / 20) * 100) %> % de saturation</span>
                                </div>
                            </div>

                            <!-- Critère 2 : Taux et Délais Moyens -->
                            <div>
                                <div class="gauge-title" style="margin-bottom: 8px;">2. Taux & Délais Moyens de Réponse</div>
                                <div class="treatment-metrics-container">
                                    <div class="treatment-metric-card">
                                        <div class="treatment-header">
                                            <span>DEMANDES</span>
                                            <span style="font-size: 0.7rem; font-weight: 700; color: #685E86;"><%= adv.demandesTraitees %>/<%= adv.totalDemandes %></span>
                                        </div>
                                        <div class="treatment-rate" style="color: <%= adv.tauxDemandes >= 80 ? '#10B981' : '#D97706' %>;">
                                            <%= adv.tauxDemandes %> %
                                        </div>
                                        <div class="treatment-sub">
                                            <span>⏱</span>
                                            <span>Délai moy. : <strong><%= adv.delaiMoyenDemandesStr %></strong></span>
                                        </div>
                                    </div>

                                    <div class="treatment-metric-card">
                                        <div class="treatment-header">
                                            <span>RÉCLAMATIONS</span>
                                            <span style="font-size: 0.7rem; font-weight: 700; color: #685E86;"><%= adv.reclamationsTraitees %>/<%= adv.totalReclamations %></span>
                                        </div>
                                        <div class="treatment-rate" style="color: <%= adv.tauxReclamations >= 80 ? '#10B981' : '#DC2626' %>;">
                                            <%= adv.tauxReclamations %> %
                                        </div>
                                        <div class="treatment-sub">
                                            <span>⏱</span>
                                            <span>Délai moy. : <strong><%= adv.delaiMoyenReclamationsStr %></strong></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Critère 3 : Footer de Dossiers & Relance -->
                            <div class="adv-card-footer">
                                <div>
                                    <div style="font-size: 0.74rem; font-weight: 600; color: #746B92;">Total en instruction :</div>
                                    <div style="font-size: 0.95rem; font-weight: 800; color: #282138;">
                                        <%= adv.totalEnAttente %> dossier<%= adv.totalEnAttente > 1 ? 's' : '' %>
                                    </div>
                                </div>

                                <div>
                                    <% if (adv.totalRelance > 0) { %>
                                        <span class="urgent-pulse-badge">
                                            ⚠️ <%= adv.totalRelance %> en souffrance (>24h)
                                        </span>
                                    <% } else { %>
                                        <span class="badge success" style="font-size: 0.75rem; padding: 4px 10px;">
                                            ✓ À jour (0 retard)
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 48px;">
                        <p style="color: #746B92; font-size: 0.95rem;">Aucun chargé de clientèle actif répertorié pour le moment.</p>
                    </div>
                <% } %>
            </div>

            <!-- Section 2 : Registre des Dossiers en Souffrance -->
            <div class="registry-card">
                <div class="registry-header">
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <h3 style="font-size: 1.15rem; font-weight: 800; color: #282138; margin: 0;">
                                Dossiers en Attente Nécessitant une Relance
                            </h3>
                            <span class="badge danger" id="overdueCountBadge"><%= overdueRequests.length %> à relancer</span>
                        </div>
                        <div style="font-size: 0.8rem; color: #746B92; margin-top: 3px;">
                            Demandes et réclamations client en attente de réponse : cliquez sur <strong>Relancer</strong> pour notifier directement le conseiller
                        </div>
                    </div>

                    <div class="table-search-bar">
                        <svg width="16" height="16" fill="none" stroke="#746B92" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        <input type="text" id="overdueSearchInput" placeholder="Filtrer client, réf, conseiller...">
                    </div>
                </div>

                <div class="dossiers-cards-grid" id="overdueCardsContainer">
                    <% if (overdueRequests && overdueRequests.length > 0) { %>
                        <% overdueRequests.forEach(reqItem => { %>
                            <div class="dossier-card <%= reqItem.heuresEnAttente >= 24 ? 'is-urgent' : 'is-normal' %>">
                                <div>
                                    <!-- Header de la Carte -->
                                    <div class="dossier-card-header">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span class="dossier-ref-tag"><%= reqItem.reference %></span>
                                            <span class="badge <%= reqItem.typeDossier === 'RECLAMATION' ? 'danger' : 'purple' %>" style="font-size: 0.7rem; padding: 2px 7px;">
                                                <%= reqItem.typeDossier === 'RECLAMATION' ? 'Réclamation' : 'Demande' %>
                                            </span>
                                        </div>

                                        <% if (reqItem.heuresEnAttente >= 24) { %>
                                            <span class="urgent-pulse-badge" style="font-size: 0.72rem; padding: 3px 8px;">
                                                ⏱ +<%= reqItem.heuresEnAttente %> h
                                            </span>
                                        <% } else { %>
                                            <span class="badge" style="background: #FBF9F5; color: #282138; border: 1px solid rgba(104, 94, 134, 0.15);">
                                                ⏱ <%= reqItem.heuresEnAttente %> h
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- Titre & Date -->
                                    <h4 class="dossier-title"><%= reqItem.sujet %></h4>
                                    <div class="dossier-meta-date">
                                        <span>📅 Déposé le :</span>
                                        <strong><%= reqItem.dateFormatted %></strong>
                                    </div>

                                    <!-- Acteurs : Client & Conseiller -->
                                    <div class="dossier-actors-box">
                                        <div class="dossier-actor-row">
                                            <span class="actor-label-small">Client Émetteur :</span>
                                            <div class="actor-value-group">
                                                <div class="actor-name-bold"><%= reqItem.clientName %></div>
                                                <div class="actor-sub-text"><%= reqItem.clientEmail %></div>
                                            </div>
                                        </div>

                                        <div style="height: 1px; background: rgba(104, 94, 134, 0.08);"></div>

                                        <div class="dossier-actor-row">
                                            <span class="actor-label-small">Conseiller Assigné :</span>
                                            <div class="actor-value-group">
                                                <% if (reqItem.advisorName) { %>
                                                    <div class="actor-name-bold" style="color: #685E86;"><%= reqItem.advisorName %></div>
                                                    <div class="actor-sub-text">ID Conseiller #<%= reqItem.advisorId %></div>
                                                <% } else { %>
                                                    <span class="badge warning" style="font-size: 0.72rem;">Non assigné</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bas de Carte : Statut & Action -->
                                <div class="dossier-bottom-bar">
                                    <span class="badge warning">
                                        <span class="badge-dot"></span> <%= reqItem.statut %>
                                    </span>

                                    <% if (reqItem.advisorId) { %>
                                        <div class="relance-action-container" style="display: inline-block;">
                                            <% if (reqItem.isRelanced) { %>
                                                <div style="display: inline-flex; align-items: center; gap: 8px;">
                                                    <span class="badge-relance-done">
                                                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                                        Relancé (<%= reqItem.dateRelance %>)
                                                    </span>
                                                    <button type="button" 
                                                            class="btn-sm btn-secondary" 
                                                            style="padding: 5px 9px; font-size: 0.72rem; cursor: pointer;"
                                                            title="Envoyer un nouveau rappel"
                                                            onclick="doInstantRelance(this, '<%= reqItem.advisorId %>', '<%= reqItem.id %>', '<%= reqItem.typeDossier %>', '<%= reqItem.reference %>')">
                                                        Re-relancer
                                                    </button>
                                                </div>
                                            <% } else { %>
                                                <button type="button" 
                                                        class="btn-relance-glow" 
                                                        onclick="doInstantRelance(this, '<%= reqItem.advisorId %>', '<%= reqItem.id %>', '<%= reqItem.typeDossier %>', '<%= reqItem.reference %>')">
                                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                                                    </svg>
                                                    Relancer
                                                </button>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <a href="/admin/clients" class="btn-sm btn-secondary">Assigner</a>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="grid-column: 1 / -1; text-align: center; padding: 48px; color: #746B92; background: #FFFFFF; border-radius: 16px;">
                            🎉 Aucun dossier en attente critique. Tous les conseillers sont à jour !
                        </div>
                    <% } %>
                    <div id="dossiersNoResults" style="display: none; grid-column: 1 / -1; text-align: center; padding: 48px 24px; color: #746B92; background: #FFFFFF; border-radius: 16px; border: 1px dashed rgba(104, 94, 134, 0.2);">
                        <div style="font-size: 1.8rem; margin-bottom: 8px;">🔍</div>
                        <div style="font-weight: 700; color: #282138; margin-bottom: 4px;">Aucun dossier trouvé</div>
                        <div style="font-size: 0.85rem;">Aucun dossier ne correspond à votre filtre de recherche.</div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script src="/js/admin.js"></script>
<script>
    // 1. Filtrage instantané des cartes de dossiers en attente
    const searchInput = document.getElementById('overdueSearchInput');
    const noResultsMsg = document.getElementById('dossiersNoResults');
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            const cards = document.querySelectorAll('.dossier-card');
            let visibleCount = 0;
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                if (text.includes(query)) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            const badge = document.getElementById('overdueCountBadge');
            if (badge) {
                badge.textContent = visibleCount + ' dossier(s)';
            }
            if (noResultsMsg) {
                noResultsMsg.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
            }
        });
    }

    // 2. Action de Relance Instantanée (En Temps Réel)
    async function doInstantRelance(btn, advisorId, requestId, requestType, reference) {
        const parentContainer = btn.closest('.relance-action-container');
        const oldHtml = btn.outerHTML;

        // Transition d'état immédiate
        btn.disabled = true;
        btn.style.opacity = '0.7';
        btn.style.pointerEvents = 'none';
        btn.innerHTML = `<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" stroke-width="3" stroke-dasharray="32" stroke-linecap="round"></circle></svg> Envoi...`;

        try {
            const response = await fetch('/admin/advisors/' + advisorId + '/remind', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    requestId: requestId,
                    requestType: requestType,
                    reference: reference,
                    message: "Délai de traitement dépassé. Dossier à traiter en priorité."
                })
            });

            if (!response.ok) {
                throw new Error("Erreur de transmission (" + response.status + ")");
            }

            const now = new Date();
            const timeStr = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');

            // Métamorphose immédiate en badge vert "Relancé"
            if (parentContainer) {
                parentContainer.innerHTML = `
                    <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <span class="badge-relance-done">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            Relancé (à ${timeStr})
                        </span>
                        <button type="button" 
                                class="btn-sm btn-secondary" 
                                style="padding: 5px 9px; font-size: 0.72rem; cursor: pointer;"
                                title="Envoyer un nouveau rappel"
                                onclick="doInstantRelance(this, '${advisorId}', '${requestId}', '${requestType}', '${reference}')">
                            Re-relancer
                        </button>
                    </div>
                `;
            }

            // Notification Toast Flottante
            showFloatingToast("⚡ Relance transmise avec succès au conseiller !");
        } catch (err) {
            console.error("Erreur relance :", err);
            if (parentContainer) {
                parentContainer.innerHTML = oldHtml;
            }
            alert("Une erreur est survenue lors de l'envoi de la relance. Veuillez vérifier votre connexion.");
        }
    }

    // Affichage d'une Toast Notification Flottante
    function showFloatingToast(message) {
        const existing = document.querySelector('.hos-floating-toast');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.className = 'hos-floating-toast';
        toast.innerHTML = `
            <span style="font-size: 1.1rem;">✅</span>
            <span>${message}</span>
        `;
        document.body.appendChild(toast);

        setTimeout(() => {
            toast.style.transition = 'all 0.3s ease';
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(20px)';
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }
</script>
</body>
</html>
