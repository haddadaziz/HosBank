<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Paramètres & Journal d'Audit</h1>
                    <p class="page-subtitle">Historique des opérations administratives, sécurité et traçabilité réglementaire</p>
                </div>
            </div>

            <!-- Paramètres Rapides -->
            <div class="dashboard-grid-split" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px;">
                <div class="card" style="margin-bottom: 0;">
                    <div class="card-header">
                        <div class="card-title">Paramètres de Sécurité Bancaire</div>
                    </div>
                    <div class="card-body">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(104, 94, 134, 0.08);">
                            <div>
                                <div style="font-weight: 600;">Seuil de blocage automatique virement</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">Transactions soumises à double validation</div>
                            </div>
                            <span style="font-weight: 700; color: var(--primary);">10 000,00 €</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(104, 94, 134, 0.08);">
                            <div>
                                <div style="font-weight: 600;">Authentification 2FA Admin</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">Obligatoire pour les virements internationaux</div>
                            </div>
                            <span class="badge success">Activée</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0;">
                            <div>
                                <div style="font-weight: 600;">Mode Maintenance du Système</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">Restreindre les accès client pour maintenance</div>
                            </div>
                            <span class="badge purple">Désactivé</span>
                        </div>
                    </div>
                </div>

                <div class="card" style="margin-bottom: 0;">
                    <div class="card-header">
                        <div class="card-title">Environnement & Connexion</div>
                    </div>
                    <div class="card-body">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(104, 94, 134, 0.08);">
                            <span style="color: var(--text-muted);">Version Core HosBank</span>
                            <span style="font-weight: 700;">v1.4.0 (Production-Ready)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(104, 94, 134, 0.08);">
                            <span style="color: var(--text-muted);">Passerelle SEPA Direct</span>
                            <span class="badge success">Opérationnelle (Latence 18ms)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0;">
                            <span style="color: var(--text-muted);">Moteur de Base de Données</span>
                            <span style="font-weight: 600;">PostgreSQL Cloud Cluster</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Journal d'audit -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Journal d'Audit & Traçabilité (Audit Logs)</div>
                </div>
                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Horodatage</th>
                                <th>Opérateur / Système</th>
                                <th>Action Enregistrée</th>
                                <th>Adresse IP</th>
                                <th>Gravité</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% auditLogs.forEach(log => { %>
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.82rem; color: var(--text-main);"><%= log.timestamp %></span>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600;"><%= log.adminUser %></div>
                                    </td>
                                    <td>
                                        <div><%= log.action %></div>
                                    </td>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.82rem; color: var(--text-muted);"><%= log.ip %></span>
                                    </td>
                                    <td>
                                        <% if (log.severity === 'Info') { %>
                                            <span class="badge purple"><%= log.severity %></span>
                                        <% } else if (log.severity === 'Avertissement') { %>
                                            <span class="badge warning"><%= log.severity %></span>
                                        <% } else { %>
                                            <span class="badge danger"><%= log.severity %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
