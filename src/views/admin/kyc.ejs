<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Vérification KYC & Conformité</h1>
                    <p class="page-subtitle">Contrôle des pièces d'identité, justificatifs de domicile et respect des obligations réglementaires</p>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span class="card-title">Dossiers d'Identification en File d'Attente</span>
                        <span class="badge purple"><%= kycRequests.length %> dossiers</span>
                    </div>
                </div>

                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Dossier / Date</th>
                                <th>Client / Référence</th>
                                <th>Type de Document</th>
                                <th>N° de Document</th>
                                <th>Remarques / Motif</th>
                                <th>Statut</th>
                                <th style="text-align: right;">Décision KYC</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% kycRequests.forEach(kyc => { %>
                                <tr>
                                    <td>
                                        <div style="font-weight: 700; color: var(--text-main);"><%= kyc.id %></div>
                                        <div style="font-size: 0.76rem; color: var(--text-muted);"><%= kyc.submissionDate %></div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600;"><%= kyc.clientName %></div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= kyc.clientId %></div>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <svg width="18" height="18" fill="none" stroke="var(--primary)" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                            </svg>
                                            <span style="font-weight: 600;"><%= kyc.documentType %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-family: monospace; font-size: 0.85rem; color: var(--text-main);"><%= kyc.documentNumber %></span>
                                    </td>
                                    <td>
                                        <span style="font-size: 0.84rem; color: var(--text-muted);"><%= kyc.notes %></span>
                                    </td>
                                    <td>
                                        <% if (kyc.status === 'Approuvé') { %>
                                            <span class="badge success"><span class="badge-dot"></span> Approuvé</span>
                                        <% } else if (kyc.status === 'En attente') { %>
                                            <span class="badge warning"><span class="badge-dot"></span> En attente</span>
                                        <% } else { %>
                                            <span class="badge danger"><span class="badge-dot"></span> Rejeté</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: right;">
                                        <% if (kyc.status === 'En attente') { %>
                                            <div style="display: flex; justify-content: flex-end; gap: 6px;">
                                                <form action="/admin/kyc/<%= kyc.id %>/status" method="POST" style="display: inline-block;">
                                                    <input type="hidden" name="status" value="Approuvé">
                                                    <button type="submit" class="btn-sm btn-success-sm" data-confirm="Valider ce document d'identité ?">Valider</button>
                                                </form>
                                                <form action="/admin/kyc/<%= kyc.id %>/status" method="POST" style="display: inline-block;">
                                                    <input type="hidden" name="status" value="Rejeté">
                                                    <button type="submit" class="btn-sm btn-danger-outline" data-confirm="Rejeter ce document ?">Rejeter</button>
                                                </form>
                                            </div>
                                        <% } else { %>
                                            <span style="font-size: 0.8rem; color: var(--text-muted);">Dossier clôturé</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
