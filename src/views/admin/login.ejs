<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="login-split-page">
    <!-- Bannière Gauche Signature Violette Incurvée -->
    <div class="login-left-banner">
        <div class="banner-top">
            <a href="/admin/login" class="hosbank-logo">
                HosBank<span class="logo-dot"></span>
            </a>
        </div>

        <div class="banner-content">
            <h1 class="banner-title">Heureux de vous compter parmi nous !</h1>
            <p class="banner-subtitle">
                Rejoignez des milliers de clients qui font confiance à HosBank pour une gestion bancaire moderne, fluide et sécurisée.
            </p>
        </div>

        <div class="banner-illustration">
            <img src="/images/characters.svg" alt="HosBank Équipe et Clients" style="width: 100%; height: auto;">
        </div>
    </div>

    <!-- Côté Droit : Formulaire Minimaliste et Chaleureux -->
    <div class="login-right-container">
        <div class="login-form-box">
            <h2>Espace Administration</h2>
            <p class="subtitle">Connectez-vous pour piloter les comptes, clients et opérations bancaires</p>

            <% if (error) { %>
                <div style="background-color: var(--status-danger-bg); border-left: 4px solid var(--status-danger); padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 0.88rem; color: #991B1B;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="form-group" style="display: flex; align-items: center; gap: 24px; margin-bottom: 25px;">
                    <span style="font-size: 0.88rem; color: var(--text-muted); font-weight: 500;">Profil d'accès</span>
                    <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin: 0; cursor: pointer;">
                        <input type="radio" name="accessLevel" value="admin" checked style="accent-color: var(--primary);"> Super Admin
                    </label>
                    <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 500; color: var(--text-muted); margin: 0; cursor: pointer;">
                        <input type="radio" name="accessLevel" value="gest" style="accent-color: var(--primary);"> Gestionnaire
                    </label>
                </div>

                <div class="form-group">
                    <label for="email">Adresse e-mail professionnelle</label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="admin@hosbank.fr" value="admin@hosbank.fr" required>
                </div>

                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" class="form-input" placeholder="••••••••••••" value="admin123" required>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
                    <button type="submit" class="btn-primary login-btn">
                        Se connecter
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </button>
                </div>
            </form>

            <div class="demo-credentials-card">
                <div style="font-weight: 700; color: var(--text-main); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--status-success);"></span>
                    Accès Rapide Démo
                </div>
                <div style="color: var(--text-muted); line-height: 1.4;">
                    E-mail : <strong>admin@hosbank.fr</strong><br>
                    Mot de passe : <strong>admin123</strong>
                </div>
            </div>

            <div style="margin-top: 30px; font-size: 0.88rem; color: var(--text-muted);">
                Besoin d'un accès sécurisé ? <a href="#" style="color: var(--primary); font-weight: 700; text-decoration: underline;">Contacter la Sécurité</a>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
