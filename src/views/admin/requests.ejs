<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Registre Central des Demandes & Réclamations</h1>
                    <p class="page-subtitle">Supervision, arbitrage et traitement de l'ensemble des requêtes bancaires et réclamations clients</p>
                </div>
            </div>

            <!-- Section 1 : Demandes Bancaires -->
            <div class="card" style="margin-bottom: 32px;">
                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span class="card-title">Demandes Bancaires Clients</span>
                        <span class="badge purple"><%= demandes ? demandes.length : 0 %> demandes</span>
                    </div>
                </div>

                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Référence / Date</th>
                                <th>Client</th>
                                <th>Nature de la Demande</th>
                                <th>Détails & Paramètres</th>
                                <th>Statut</th>
                                <th style="text-align: right;">Action Arbitrage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (demandes && demandes.length > 0) { %>
                                <% demandes.forEach(d => { %>
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-main); font-family: monospace;"><%= d.reference %></div>
                                            <div style="font-size: 0.76rem; color: var(--text-muted);"><%= d.dateDemande %></div>
                                        </td>
                                        <td>
                                            <div style="font-weight: 600;"><%= d.clientName %></div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= d.clientId %></div>
                                        </td>
                                        <td>
                                            <span class="badge" style="background: var(--bg-cream-darker); color: var(--text-main); font-weight: 600;">
                                                <%= d.typeLibelle %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.8rem; color: var(--text-muted); max-width: 260px; word-break: break-word;">
                                                <%= d.payload || 'Aucun paramètre spécifique' %>
                                            </div>
                                            <% if (d.reponse) { %>
                                                <div style="font-size: 0.75rem; color: var(--status-success); margin-top: 4px;">
                                                    💬 Réponse : <%= d.reponse %>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (d.statut === 'APPROUVEE') { %>
                                                <span class="badge success"><span class="badge-dot"></span> Approuvée</span>
                                            <% } else if (d.statut === 'REJETEE') { %>
                                                <span class="badge danger"><span class="badge-dot"></span> Rejetée</span>
                                            <% } else { %>
                                                <span class="badge warning"><span class="badge-dot"></span> En attente</span>
                                            <% } %>
                                        </td>
                                        <td style="text-align: right; white-space: nowrap;">
                                            <% if (d.statut === 'EN_ATTENTE' || d.statut === 'EN_INSTRUCTION') { %>
                                                <form action="/admin/demandes/<%= d.id %>/status" method="POST" style="display: inline-block; margin-right: 4px;">
                                                    <input type="hidden" name="statut" value="APPROUVEE">
                                                    <button type="submit" class="btn-sm btn-success-sm" data-confirm="Valider et approuver cette demande client ?">Approuver</button>
                                                </form>
                                                <form action="/admin/demandes/<%= d.id %>/status" method="POST" style="display: inline-block;">
                                                    <input type="hidden" name="statut" value="REJETEE">
                                                    <button type="submit" class="btn-sm btn-danger-outline" data-confirm="Rejeter cette demande ?">Rejeter</button>
                                                </form>
                                            <% } else { %>
                                                <span style="color: var(--text-muted); font-size: 0.8rem;">Clôturé</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">Aucune demande bancaire enregistrée.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Section 2 : Réclamations Clients -->
            <div class="card">
                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span class="card-title">Réclamations & Contentieux Clients</span>
                        <span class="badge purple"><%= reclamations ? reclamations.length : 0 %> réclamations</span>
                    </div>
                </div>

                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Référence / Date</th>
                                <th>Client</th>
                                <th>Sujet & Description</th>
                                <th>Priorité</th>
                                <th>Statut</th>
                                <th style="text-align: right;">Résolution</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (reclamations && reclamations.length > 0) { %>
                                <% reclamations.forEach(r => { %>
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-main); font-family: monospace;"><%= r.reference %></div>
                                            <div style="font-size: 0.76rem; color: var(--text-muted);"><%= r.dateDepot %></div>
                                        </td>
                                        <td>
                                            <div style="font-weight: 600;"><%= r.clientName %></div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= r.clientId %></div>
                                        </td>
                                        <td>
                                            <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);"><%= r.sujet %></div>
                                            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;"><%= r.description %></div>
                                        </td>
                                        <td>
                                            <% if (r.priorite === 'URGENTE' || r.priorite === 'HAUTE') { %>
                                                <span class="badge danger"><span class="badge-dot"></span> <%= r.priorite %></span>
                                            <% } else { %>
                                                <span class="badge" style="background: var(--bg-cream-darker); color: var(--text-main);"><%= r.priorite %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (r.statut === 'RESOLUE') { %>
                                                <span class="badge success"><span class="badge-dot"></span> Résolue</span>
                                            <% } else if (r.statut === 'REJETEE') { %>
                                                <span class="badge danger"><span class="badge-dot"></span> Rejetée</span>
                                            <% } else if (r.statut === 'EN_COURS') { %>
                                                <span class="badge warning"><span class="badge-dot"></span> En cours</span>
                                            <% } else { %>
                                                <span class="badge" style="background: #EFF6FF; color: #1D4ED8;"><span class="badge-dot" style="background: #1D4ED8;"></span> Ouverte</span>
                                            <% } %>
                                        </td>
                                        <td style="text-align: right; white-space: nowrap;">
                                            <% if (r.statut === 'OUVERTE' || r.statut === 'EN_COURS') { %>
                                                <form action="/admin/reclamations/<%= r.id %>/status" method="POST" style="display: inline-block; margin-right: 4px;">
                                                    <input type="hidden" name="statut" value="RESOLUE">
                                                    <button type="submit" class="btn-sm btn-success-sm" data-confirm="Clôturer et marquer cette réclamation comme résolue ?">Résoudre</button>
                                                </form>
                                                <form action="/admin/reclamations/<%= r.id %>/status" method="POST" style="display: inline-block;">
                                                    <input type="hidden" name="statut" value="REJETEE">
                                                    <button type="submit" class="btn-sm btn-danger-outline" data-confirm="Rejeter cette réclamation ?">Rejeter</button>
                                                </form>
                                            <% } else { %>
                                                <span style="color: var(--text-muted); font-size: 0.8rem;">Dossier Clos</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">Aucune réclamation enregistrée.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
