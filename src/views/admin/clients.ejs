<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Gestion des Clients</h1>
                    <p class="page-subtitle">Consultez, modifiez et gérez l'ensemble des comptes et accès clients HosBank</p>
                </div>
                <button class="btn-primary" data-open-modal="modalAddClient">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Nouveau Client
                </button>
            </div>

            <!-- Carte et Tableau des Clients -->
            <div class="card">
                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span class="card-title">Portefeuille Clients</span>
                        <span class="badge purple"><%= clients.length %> enregistrés</span>
                    </div>

                    <form action="/admin/clients" method="GET" style="display: flex; gap: 10px;">
                        <input type="text" name="q" value="<%= searchQuery %>" placeholder="Recherche rapide..." class="form-input" style="padding: 6px 12px; font-size: 0.85rem; width: 220px; border: 1px solid var(--primary-border); border-radius: var(--radius-sm); background: #FFFFFF;">
                        <% if (searchQuery) { %>
                            <a href="/admin/clients" class="btn-sm btn-secondary">Effacer</a>
                        <% } %>
                        <button type="submit" class="btn-sm btn-primary">Filtrer</button>
                    </form>
                </div>

                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Identifiant</th>
                                <th>Client / Titulaire</th>
                                <th>Contact & Ville</th>
                                <th>Date d'inscription</th>
                                <th>Comptes & Avoirs</th>
                                <th>Conformité KYC</th>
                                <th>Statut Compte</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% clients.forEach(client => { %>
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-weight: 700; color: var(--primary);"><%= client.id %></span>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--primary-light); color: var(--primary); font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.82rem;">
                                                <%= client.firstName[0] %><%= client.lastName[0] %>
                                            </div>
                                            <div>
                                                <div style="font-weight: 600; color: var(--text-main);">
                                                    <%= client.gender === 'M' ? 'M.' : 'Mme' %> <%= client.firstName %> <%= client.lastName %>
                                                </div>
                                                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= client.email %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div><%= client.phone %></div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted);"><%= client.city %></div>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.85rem;"><%= client.joinedDate %></div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 700; color: var(--text-main);"><%= client.totalBalance.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= client.accountsCount %> compte(s) actif(s)</div>
                                    </td>
                                    <td>
                                        <% if (client.kycStatus === 'Vérifié') { %>
                                            <span class="badge success"><span class="badge-dot"></span> Vérifié</span>
                                        <% } else if (client.kycStatus === 'En cours') { %>
                                            <span class="badge warning"><span class="badge-dot"></span> En cours</span>
                                        <% } else { %>
                                            <span class="badge danger"><span class="badge-dot"></span> Non conforme</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (client.status === 'Actif') { %>
                                            <span class="badge success"><span class="badge-dot"></span> Actif</span>
                                        <% } else if (client.status === 'Suspendu') { %>
                                            <span class="badge danger"><span class="badge-dot"></span> Suspendu</span>
                                        <% } else { %>
                                            <span class="badge warning"><span class="badge-dot"></span> En attente</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: right;">
                                        <form action="/admin/clients/<%= client.id %>/toggle-status" method="POST" style="display: inline-block;">
                                            <% if (client.status === 'Actif') { %>
                                                <button type="submit" class="btn-sm btn-danger-outline" data-confirm="Voulez-vous suspendre l'accès de ce client ?">Suspendre</button>
                                            <% } else { %>
                                                <button type="submit" class="btn-sm btn-secondary" style="color: var(--status-success); border-color: rgba(16, 185, 129, 0.3);">Activer</button>
                                            <% } %>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Modal Ajout Client -->
<div class="modal-overlay" id="modalAddClient">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-title">Créer un Nouveau Compte Client</div>
            <button class="modal-close" data-close-modal>&times;</button>
        </div>
        <form action="/admin/clients/new" method="POST">
            <div class="modal-body">
                <div class="form-group" style="display: flex; gap: 20px; margin-bottom: 15px;">
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" value="M" checked style="accent-color: var(--primary);"> M.
                    </label>
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" value="Mme" style="accent-color: var(--primary);"> Mme
                    </label>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="firstName">Prénom</label>
                        <input type="text" id="firstName" name="firstName" class="form-input" placeholder="Ex: Lucas" required>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Nom</label>
                        <input type="text" id="lastName" name="lastName" class="form-input" placeholder="Ex: Martin" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="email">Adresse E-mail</label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="lucas.martin@email.com" required>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="phone">Téléphone</label>
                        <input type="text" id="phone" name="phone" class="form-input" placeholder="+33 6 ...">
                    </div>
                    <div class="form-group">
                        <label for="city">Ville de résidence</label>
                        <input type="text" id="city" name="city" class="form-input" placeholder="Strasbourg, Nice...">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-sm btn-secondary" data-close-modal>Annuler</button>
                <button type="submit" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem;">Créer le client</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
