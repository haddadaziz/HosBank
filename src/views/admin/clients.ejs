<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ==========================================================
           HOSBANK 2026 - GESTION DES UTILISATEURS (100% CAHIER DES CHARGES)
           Créer, Modifier, Désactiver, Gérer les rôles, Affecter conseillers
           ========================================================== */
        .admin-users-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 24px;
            padding: 24px;
        }

        @media (max-width: 768px) {
            .admin-users-grid {
                grid-template-columns: 1fr;
                padding: 16px;
            }
        }

        .user-modern-card {
            background: #FFFFFF;
            border: 1px solid rgba(104, 94, 134, 0.14);
            border-radius: 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 4px 16px rgba(40, 33, 56, 0.04);
            transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.22s ease;
            position: relative;
            overflow: hidden;
        }

        .user-modern-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(40, 33, 56, 0.09);
            border-color: rgba(104, 94, 134, 0.28);
        }

        .user-modern-card.is-disabled {
            border-color: rgba(239, 68, 68, 0.3);
            background: #FFFDFC;
        }

        .user-card-head {
            padding: 20px 20px 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-bottom: 1px solid rgba(104, 94, 134, 0.08);
        }

        .user-profile-left {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            flex: 1;
        }

        .user-avatar-badge {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.95rem;
            color: #FFFFFF;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(40, 33, 56, 0.16);
        }

        .avatar-admin {
            background: linear-gradient(135deg, #6B21A8 0%, #9333EA 100%);
        }

        .avatar-charge {
            background: linear-gradient(135deg, #B45309 0%, #D97706 100%);
        }

        .avatar-client {
            background: linear-gradient(135deg, #2D253D 0%, #685E86 100%);
        }

        .user-titles {
            flex: 1;
            min-width: 0;
        }

        .user-full-name {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-email-text {
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-card-content {
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* Coordonnées */
        .user-contacts-box {
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 0.8rem;
            color: var(--text-main);
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-main);
        }

        .contact-icon {
            color: var(--text-muted);
            flex-shrink: 0;
            display: flex;
            align-items: center;
        }

        /* Section Contrôles : Rôles & Affectation Conseiller */
        .user-controls-panel {
            background: #FAF8F5;
            border-radius: 12px;
            padding: 12px 14px;
            border: 1px solid rgba(104, 94, 134, 0.08);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .control-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .control-label {
            font-size: 0.76rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .user-card-actions {
            padding: 14px 20px;
            background: #FAF8F5;
            border-top: 1px solid rgba(104, 94, 134, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
    </style>
</head>
<body>

<div class="admin-layout">
    <!-- Barre latérale unifiée HosBank -->
    <%- include('../partials/sidebar', { role: 'admin', currentPath: '/admin/clients' }) %>

    <div class="admin-main">
        <!-- Barre supérieure admin -->
        <%- include('../partials/topbar') %>

        <main class="admin-content">
            <!-- 1. En-tête de la page -->
            <div class="page-header" style="flex-wrap: wrap; gap: 16px;">
                <div>
                    <h1 class="page-title">Gestion des Utilisateurs</h1>
                    <p class="page-subtitle">Créer, modifier, désactiver des comptes utilisateurs, gérer les rôles et affecter les conseillers</p>
                </div>

                <button class="btn-primary" data-open-modal="modalAddClient">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Nouvel Utilisateur
                </button>
            </div>

            <!-- 2. Barre de Recherche & Filtres par Rôle -->
            <div class="card" style="margin-bottom: 24px;">
                <div class="card-header" style="border-bottom: none; flex-wrap: wrap; gap: 14px; padding: 18px 24px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span class="card-title" style="font-size: 1.05rem;">Annuaire des Utilisateurs</span>
                        <span class="badge purple" style="font-size: 0.8rem;">
                            <%= clients.length %> enregistré(s)
                        </span>
                    </div>

                    <form action="/admin/clients" method="GET" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <!-- Recherche instantanée -->
                        <div style="position: relative;">
                            <input 
                                type="text" 
                                id="userLiveSearch" 
                                name="q" 
                                value="<%= searchQuery %>"
                                placeholder="Recherche nom, email..." 
                                style="padding: 7px 14px 7px 32px; font-size: 0.84rem; width: 220px; border: 1px solid var(--primary-border, #D8CEBB); border-radius: 8px; background: #FFFFFF; outline: none;"
                            >
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>

                        <!-- Filtre par rôle (Cahier des charges : Client, Chargé Client, Administrateur) -->
                        <select name="role" style="padding: 7px 12px; font-size: 0.84rem; border: 1px solid var(--primary-border, #D8CEBB); border-radius: 8px; background: #FFFFFF; outline: none;" onchange="this.form.submit()">
                            <option value="">Tous les rôles</option>
                            <option value="CLIENT" <%=(typeof currentRole !== 'undefined' && currentRole === 'CLIENT') ? 'selected' : '' %>>Clients Particuliers</option>
                            <option value="CHARGE_CLIENT" <%=(typeof currentRole !== 'undefined' && currentRole === 'CHARGE_CLIENT') ? 'selected' : '' %>>Chargés de Clientèle</option>
                            <option value="ADMINISTRATEUR" <%=(typeof currentRole !== 'undefined' && currentRole === 'ADMINISTRATEUR') ? 'selected' : '' %>>Administrateurs</option>
                        </select>

                        <% if (searchQuery || (typeof currentRole !== 'undefined' && currentRole)) { %>
                            <a href="/admin/clients" class="btn-sm btn-secondary" style="padding: 7px 12px; border-radius: 8px; text-decoration: none;">Effacer</a>
                        <% } %>
                        <button type="submit" class="btn-sm btn-primary" style="padding: 7px 16px; border-radius: 8px;">Filtrer</button>
                    </form>
                </div>
            </div>

            <!-- 3. Grille des Cartes Utilisateurs -->
            <div class="card">
                <% if (clients && clients.length > 0) { %>
                    <div class="admin-users-grid">
                        <% clients.forEach(client => { %>
                            <% const isDisabled = (client.compteVerrouille || client.status === 'Suspendu'); %>
                            <div class="user-modern-card user-card <%= isDisabled ? 'is-disabled' : '' %>">
                                
                                <!-- En-tête : Avatar, Identité & Statut Actif/Désactivé -->
                                <div class="user-card-head">
                                    <div class="user-profile-left">
                                        <div class="user-avatar-badge <%= client.role === 'ADMINISTRATEUR' ? 'avatar-admin' : (client.role === 'CHARGE_CLIENT' ? 'avatar-charge' : 'avatar-client') %>">
                                            <%= (client.prenom ? client.prenom[0] : (client.firstName ? client.firstName[0] : 'U')) %>
                                            <%= (client.nom ? client.nom[0] : (client.lastName ? client.lastName[0] : '')) %>
                                        </div>
                                        <div class="user-titles">
                                            <div class="user-full-name">
                                                <%= client.civilite || 'M.' %> <%= client.prenom || client.firstName %> <%= client.nom || client.lastName %>
                                            </div>
                                            <div class="user-email-text">
                                                <%= client.email %>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <% if (isDisabled) { %>
                                            <span class="badge danger" style="background: #FEE2E2; color: #DC2626; font-weight: 700; padding: 4px 8px;">
                                                <span class="badge-dot" style="background: #DC2626;"></span>
                                                Désactivé
                                            </span>
                                        <% } else { %>
                                            <span class="badge success" style="font-weight: 700; padding: 4px 8px;">
                                                <span class="badge-dot" style="background: #10B981;"></span>
                                                Actif
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Corps de carte : Coordonnées & Contrôles Rôles / Affectation -->
                                <div class="user-card-content">
                                    <!-- Coordonnées (Téléphone & Adresse) -->
                                    <div class="user-contacts-box">
                                        <div class="contact-item">
                                            <span class="contact-icon">
                                                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                                </svg>
                                            </span>
                                            <span><%= client.telephone || client.phone || 'Non renseigné' %></span>
                                        </div>
                                        <div class="contact-item">
                                            <span class="contact-icon">
                                                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                                </svg>
                                            </span>
                                            <span><%= client.adressePostale || client.city || 'Non renseignée' %></span>
                                        </div>
                                    </div>

                                    <!-- Contrôles Rôles & Affectation Conseiller (Cahier des Charges) -->
                                    <div class="user-controls-panel">
                                        <!-- Gestion du Rôle (Client, Chargé Client, Administrateur) -->
                                        <div class="control-item-row">
                                            <span class="control-label">Rôle :</span>
                                            <form action="/admin/clients/<%= client.id %>/role" method="POST" style="margin: 0;">
                                                <select name="role" class="hos-confirm-select" data-confirm-change="Confirmer l'attribution de ce rôle pour <%= client.prenom %> <%= client.nom %> ?" style="padding: 5px 10px; font-size: 0.8rem; font-weight: 700; border-radius: 8px; cursor: pointer; border: 1px solid rgba(0,0,0,0.12); background: <%= client.role === 'ADMINISTRATEUR' ? '#F3E8FF' : (client.role === 'CHARGE_CLIENT' ? '#FEF3C7' : '#EFF6FF') %>; color: <%= client.role === 'ADMINISTRATEUR' ? '#7E22CE' : (client.role === 'CHARGE_CLIENT' ? '#B45309' : '#1D4ED8') %>;">
                                                    <option value="CLIENT" <%= client.role === 'CLIENT' ? 'selected' : '' %>>Client Particulier</option>
                                                    <option value="CHARGE_CLIENT" <%= client.role === 'CHARGE_CLIENT' ? 'selected' : '' %>>Chargé de Clientèle</option>
                                                    <option value="ADMINISTRATEUR" <%= client.role === 'ADMINISTRATEUR' ? 'selected' : '' %>>Administrateur</option>
                                                </select>
                                            </form>
                                        </div>

                                        <!-- Affectation Conseiller (pour les clients) -->
                                        <% if (client.role === 'CLIENT') { %>
                                            <div class="control-item-row">
                                                <span class="control-label">Conseiller :</span>
                                                <form action="/admin/clients/<%= client.id %>/assign" method="POST" style="margin: 0;">
                                                    <select name="advisorId" class="hos-confirm-select" data-confirm-change="Confirmer la réaffectation du conseiller pour ce client ?" style="padding: 5px 10px; font-size: 0.78rem; font-weight: 500; border-radius: 8px; cursor: pointer; border: 1px solid var(--primary-border, #D8CEBB); background: #FFFFFF; color: var(--text-main); max-width: 175px;">
                                                        <option value="">Non affecté</option>
                                                        <% if (typeof advisors !== 'undefined' && advisors) { %>
                                                            <% for (var a = 0; a < advisors.length; a++) { %>
                                                                <% var adv = advisors[a]; %>
                                                                <option value="<%= adv.id %>" <%= (client.conseillerId === adv.id) ? 'selected' : '' %>>
                                                                    <%= adv.prenom %> <%= adv.nom %>
                                                                </option>
                                                            <% } %>
                                                        <% } %>
                                                    </select>
                                                </form>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Actions : Modifier & Activer/Désactiver (Cahier des Charges) -->
                                <div class="user-card-actions">
                                    <button 
                                        type="button" 
                                        class="btn-sm btn-secondary btn-edit-user"
                                        style="padding: 6px 14px; font-weight: 600; border-radius: 8px;" 
                                        data-id="<%= client.id %>"
                                        data-gender="<%= client.civilite || 'M.' %>"
                                        data-firstname="<%= client.prenom || client.firstName %>"
                                        data-lastname="<%= client.nom || client.lastName %>"
                                        data-email="<%= client.email %>"
                                        data-role="<%= client.role || 'CLIENT' %>"
                                        data-phone="<%= client.telephone || client.phone || '' %>"
                                        data-city="<%= client.adressePostale || client.city || '' %>"
                                    >
                                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin-right: 4px; vertical-align: middle;">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                        Modifier
                                    </button>

                                    <form action="/admin/clients/<%= client.id %>/toggle-status" method="POST" style="margin: 0;">
                                        <% if (isDisabled) { %>
                                            <button type="submit" class="btn-sm btn-secondary" style="color: var(--status-success); border-color: rgba(16, 185, 129, 0.4); font-weight: 600; border-radius: 8px;">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin-right: 4px; vertical-align: middle;">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                Activer
                                            </button>
                                        <% } else { %>
                                            <button type="submit" class="btn-sm btn-danger-outline" data-confirm="Voulez-vous désactiver l'accès de cet utilisateur ?" style="font-weight: 600; border-radius: 8px;">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin-right: 4px; vertical-align: middle;">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                </svg>
                                                Désactiver
                                            </button>
                                        <% } %>
                                    </form>
                                </div>

                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div style="padding: 48px; text-align: center; color: var(--text-muted);">
                        <div style="font-size: 2.2rem; margin-bottom: 10px;">👥</div>
                        <div style="font-weight: 700; color: var(--text-main); font-size: 1.05rem;">Aucun utilisateur trouvé</div>
                        <p style="font-size: 0.85rem; margin-top: 4px;">Modifiez vos critères de recherche ou réinitialisez les filtres.</p>
                        <a href="/admin/clients" class="btn-sm btn-primary" style="margin-top: 14px; display: inline-block; text-decoration: none;">Réinitialiser</a>
                    </div>
                <% } %>
            </div>
        </main>
    </div>
</div>

<!-- Modal 1 : Création Utilisateur (Cahier des Charges) -->
<div class="modal-overlay" id="modalAddClient">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-title">Créer un Nouvel Utilisateur</div>
            <button class="modal-close" data-close-modal>&times;</button>
        </div>
        <form action="/admin/clients/new" method="POST">
            <div class="modal-body">
                <div class="form-group" style="display: flex; gap: 20px; margin-bottom: 15px;">
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" value="M." checked style="accent-color: var(--primary);"> M.
                    </label>
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" value="Mme" style="accent-color: var(--primary);"> Mme
                    </label>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="firstName">Prénom</label>
                        <input type="text" id="firstName" name="firstName" class="form-input" placeholder="Ex: Alexandre" required>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Nom</label>
                        <input type="text" id="lastName" name="lastName" class="form-input" placeholder="Ex: Moreau" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="email">Adresse E-mail</label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="utilisateur@hosbank.fr" required>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="role">Rôle utilisateur</label>
                        <select id="role" name="role" class="form-input">
                            <option value="CLIENT" selected>Client Particulier</option>
                            <option value="CHARGE_CLIENT">Chargé de Clientèle</option>
                            <option value="ADMINISTRATEUR">Administrateur</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="password">Mot de passe</label>
                        <input type="password" id="password" name="password" class="form-input" placeholder="Défaut: Password123!">
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="phone">Téléphone</label>
                        <input type="text" id="phone" name="phone" class="form-input" placeholder="+33 6 12 34 56 78">
                    </div>
                    <div class="form-group">
                        <label for="city">Adresse / Ville</label>
                        <input type="text" id="city" name="city" class="form-input" placeholder="Paris, Lyon...">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-sm btn-secondary" data-close-modal>Annuler</button>
                <button type="submit" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem;">Créer l'utilisateur</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2 : Modification Utilisateur (Cahier des Charges) -->
<div class="modal-overlay" id="modalEditUser">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-title">Modifier l'Utilisateur</div>
            <button class="modal-close" data-close-modal>&times;</button>
        </div>
        <form id="formEditUser" method="POST" action="">
            <div class="modal-body">
                <div class="form-group" style="display: flex; gap: 20px; margin-bottom: 15px;">
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" id="editGenderM" value="M." style="accent-color: var(--primary);"> M.
                    </label>
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="gender" id="editGenderMme" value="Mme" style="accent-color: var(--primary);"> Mme
                    </label>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="editFirstName">Prénom</label>
                        <input type="text" id="editFirstName" name="firstName" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label for="editLastName">Nom</label>
                        <input type="text" id="editLastName" name="lastName" class="form-input" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="editEmail">Adresse E-mail</label>
                    <input type="email" id="editEmail" name="email" class="form-input" required>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="editRole">Rôle utilisateur</label>
                        <select id="editRole" name="role" class="form-input">
                            <option value="CLIENT">Client Particulier</option>
                            <option value="CHARGE_CLIENT">Chargé de Clientèle</option>
                            <option value="ADMINISTRATEUR">Administrateur</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="editPhone">Téléphone</label>
                        <input type="text" id="editPhone" name="phone" class="form-input">
                    </div>
                </div>
                <div class="form-group">
                    <label for="editCity">Adresse / Ville</label>
                    <input type="text" id="editCity" name="city" class="form-input">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-sm btn-secondary" data-close-modal>Annuler</button>
                <button type="submit" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem;">Enregistrer les modifications</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/admin.js"></script>
<script>
    // 1. Gestion de la modale de modification d'utilisateur (style développeur junior)
    document.addEventListener("DOMContentLoaded", function () {
        var editButtons = document.querySelectorAll(".btn-edit-user");
        var editModal = document.getElementById("modalEditUser");
        var editForm = document.getElementById("formEditUser");

        for (var i = 0; i < editButtons.length; i++) {
            editButtons[i].addEventListener("click", function () {
                var id = this.getAttribute("data-id");
                var gender = this.getAttribute("data-gender");
                var firstName = this.getAttribute("data-firstname");
                var lastName = this.getAttribute("data-lastname");
                var email = this.getAttribute("data-email");
                var role = this.getAttribute("data-role");
                var phone = this.getAttribute("data-phone");
                var city = this.getAttribute("data-city");

                editForm.action = "/admin/clients/" + id + "/edit";

                document.getElementById("editFirstName").value = firstName ? firstName : "";
                document.getElementById("editLastName").value = lastName ? lastName : "";
                document.getElementById("editEmail").value = email ? email : "";
                document.getElementById("editRole").value = role ? role : "CLIENT";
                document.getElementById("editPhone").value = phone ? phone : "";
                document.getElementById("editCity").value = city ? city : "";

                if (gender === "Mme") {
                    document.getElementById("editGenderMme").checked = true;
                } else {
                    document.getElementById("editGenderM").checked = true;
                }

                if (editModal) {
                    editModal.classList.add("active");
                }
            });
        }
    });

    // 2. Recherche instantanée dans les cartes utilisateurs
    const liveSearchInput = document.getElementById("userLiveSearch");
    if (liveSearchInput) {
        liveSearchInput.addEventListener("input", function() {
            const query = this.value.toLowerCase().trim();
            document.querySelectorAll(".user-modern-card").forEach(function(card) {
                if (card.textContent.toLowerCase().includes(query)) {
                    card.style.display = "";
                } else {
                    card.style.display = "none";
                }
            });
        });
    }
</script>
</body>
</html>